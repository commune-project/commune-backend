package federation

import json "go:encoding/json"
import failure "github.com/commune-project/commune-backend/internal/failure"

struct CollectionTraversal
  ID: String
  First: String
  Next: String
  Items: Slice[String]
end

struct CollectionDocument
  ID: String `json:"id"`
  Type: String `json:"type"`
  First: json.RawMessage `json:"first"`
  Next: json.RawMessage `json:"next"`
  OrderedItems: json.RawMessage `json:"orderedItems"`
  Items: json.RawMessage `json:"items"`
end

struct CollectionItemView
  ID: String `json:"id"`
  Href: String `json:"href"`
end

# ActivityPub collection shapes. The wire value stays a string; traversal only
# needs to know which field holds the items and whether the order is explicit.
enum CollectionKind
  Collection
  OrderedCollection
  Page
  OrderedPage
end

impl CollectionKind
  func Parse(raw: String) -> Result[CollectionKind, failure.Failure]
    switch raw
      case "Collection" => Ok(CollectionKind.Collection)
      case "OrderedCollection" => Ok(CollectionKind.OrderedCollection)
      case "CollectionPage" => Ok(CollectionKind.Page)
      case "OrderedCollectionPage" => Ok(CollectionKind.OrderedPage)
      case _ => Err(Of("not a collection"))
    end
  end

  func Render(self: CollectionKind) -> String
    switch self
      case Collection => "Collection"
      case OrderedCollection => "OrderedCollection"
      case Page => "CollectionPage"
      case OrderedPage => "OrderedCollectionPage"
    end
  end

  func IsOrdered(self: CollectionKind) -> Bool
    switch self
      case OrderedCollection => true
      case OrderedPage => true
      case Collection => false
      case Page => false
    end
  end
end

# Collection traversal returns only canonical item identities. Callers fetch each
# object from its advertised URI so that the object body's id can be verified.
func ParseCollectionTraversal(payload: Slice[Byte]) -> Result[CollectionTraversal, failure.Failure]
  let document = Zero[CollectionDocument]()
  if json.Unmarshal(payload, Ref.new(document)).IsErr() then
    return Err(Of("invalid collection"))
  end
  let parsedKind = CollectionKind.Parse(document.Type)
  if parsedKind.IsErr() then
    return Err(Of("not a collection"))
  end
  let kind = parsedKind.Unwrap()
  # Prefer the field the declared kind promises, then fall back to the other one
  # so producers that send both shapes still traverse.
  let preferred = switch kind
    case OrderedCollection => document.OrderedItems
    case OrderedPage => document.OrderedItems
    case Collection => document.Items
    case Page => document.Items
  end
  let fallback = switch kind
    case OrderedCollection => document.Items
    case OrderedPage => document.Items
    case Collection => document.OrderedItems
    case Page => document.OrderedItems
  end
  let rawItems = if (preferred as Slice[Byte]).Len() > 0 => preferred else fallback
  var items: Slice[String] = []
  if (rawItems as Slice[Byte]).Len() > 0 then
    var elements: Slice[json.RawMessage] = []
    if json.Unmarshal(rawItems as Slice[Byte], Ref.new(elements)).IsErr() then
      return Err(Of("invalid collection items"))
    end
    elements.Each(func(element: json.RawMessage) -> ()
      let uri = DecodeCollectionItemURI(element)
      if uri != "" && !items.Contains(uri) then
        items = items.Append(uri)
      end
    end)
  end
  Ok(CollectionTraversal{
    ID: document.ID,
    First: DecodeCollectionLink(document.First),
    Next: DecodeCollectionLink(document.Next),
    Items: items,
  })
end

func DecodeCollectionItemURI(raw: json.RawMessage) -> String
  let uri = ""
  if json.Unmarshal(raw as Slice[Byte], Ref.new(uri)).IsOk() then
    return uri
  end
  let item = Zero[CollectionItemView]()
  if json.Unmarshal(raw as Slice[Byte], Ref.new(item)).IsErr() then
    return ""
  end
  if item.ID != "" then
    return item.ID
  end
  item.Href
end

func DecodeCollectionLink(raw: json.RawMessage) -> String
  DecodeCollectionItemURI(raw)
end
