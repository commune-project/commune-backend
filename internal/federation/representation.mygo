package federation

import time "go:time"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import content "github.com/commune-project/commune-backend/internal/content"

let activityStreamsContext: String = "https://www.w3.org/ns/activitystreams"
let publicAudience: String = "https://www.w3.org/ns/activitystreams#Public"

struct WebFingerLink
  Rel: String `json:"rel"`
  Type: String `json:"type,omitempty"`
  Href: String `json:"href,omitempty"`
end

struct WebFingerDocument
  Subject: String `json:"subject"`
  Links: Slice[WebFingerLink] `json:"links"`
end

struct PublicKeyRepresentation
  ID: String `json:"id"`
  Owner: String `json:"owner"`
  PublicKeyPEM: String `json:"publicKeyPem"`
end

struct ActorRepresentation
  Context: String `json:"@context"`
  ID: String `json:"id"`
  Type: String `json:"type"`
  PreferredUsername: String `json:"preferredUsername,omitempty"`
  Name: String `json:"name,omitempty"`
  Summary: String `json:"summary,omitempty"`
  Icon: ProfileIcon `json:"icon,omitzero"`
  Updated: time.Time `json:"updated,omitempty"`
  Inbox: String `json:"inbox"`
  Outbox: String `json:"outbox"`
  Followers: String `json:"followers,omitempty"`
  AttributedTo: String `json:"attributedTo,omitempty"`
  FollowPolicy: String `json:"commune:followPolicy,omitempty"`
  PublicKey: PublicKeyRepresentation `json:"publicKey"`
end

struct ObjectRepresentation
  Context: String `json:"@context"`
  DiscussionContext: String `json:"context,omitempty"`
  ID: String `json:"id"`
  Type: String `json:"type"`
  AttributedTo: String `json:"attributedTo,omitempty"`
  Name: String `json:"name,omitempty"`
  Content: String `json:"content,omitempty"`
  MediaType: String `json:"mediaType,omitempty"`
  Source: RichSource `json:"source,omitzero"`
  Attachment: Slice[RichAttachment] `json:"attachment,omitempty"`
  Tag: Slice[RichMention] `json:"tag,omitempty"`
  InReplyTo: String `json:"inReplyTo,omitempty"`
  Published: time.Time `json:"published,omitempty"`
  Updated: time.Time `json:"updated,omitempty"`
  To: Slice[String] `json:"to,omitempty"`
  CC: Slice[String] `json:"cc,omitempty"`
end

struct TombstoneRepresentation
  Context: String `json:"@context"`
  ID: String `json:"id"`
  Type: String `json:"type"`
  FormerType: String `json:"formerType,omitempty"`
  Deleted: time.Time `json:"deleted,omitempty"`
end

func PersonRepresentation(
  site: config.Site,
  actor: storage.ActorRecord,
  username: String,
  publicPEM: String
) -> ActorRepresentation
  let uri = actor.URI
  ActorRepresentation{
    Context: activityStreamsContext,
    ID: uri,
    Type: "Person",
    PreferredUsername: username,
    Name: "",
    Summary: "",
    Icon: Zero[ProfileIcon](),
    Updated: Zero[time.Time](),
    Inbox: actor.Inbox(),
    Outbox: uri + "/outbox",
    Followers: uri + "/followers",
    AttributedTo: "",
    FollowPolicy: "",
    PublicKey: PublicKeyRepresentation{
      ID: uri + "#main-key",
      Owner: uri,
      PublicKeyPEM: publicPEM,
    },
  }
end

func GroupRepresentation(
  community: storage.CommunityRecord,
  actor: storage.ActorRecord,
  publicPEM: String
) -> ActorRepresentation
  let uri = actor.URI
  ActorRepresentation{
    Context: activityStreamsContext,
    ID: uri,
    Type: "Group",
    PreferredUsername: community.Name,
    Name: community.Title,
    Summary: "",
    Icon: Zero[ProfileIcon](),
    Updated: Zero[time.Time](),
    Inbox: actor.Inbox(),
    Outbox: uri + "/outbox",
    Followers: uri + "/followers",
    AttributedTo: uri + "/moderators",
    FollowPolicy: community.FollowPolicy,
    PublicKey: PublicKeyRepresentation{
      ID: uri + "#main-key",
      Owner: uri,
      PublicKeyPEM: publicPEM,
    },
  }
end

func BuildObjectRepresentation(
  sanitizer: content.Sanitizer,
  record: storage.PostRecord,
  community: storage.CommunityRecord
) -> ObjectRepresentation
  BuildObjectRepresentationWithContext(sanitizer, record, community, "")
end

func BuildObjectRepresentationWithContext(
  sanitizer: content.Sanitizer,
  record: storage.PostRecord,
  community: storage.CommunityRecord,
  discussionContext: String
) -> ObjectRepresentation
  let audience = community.ActorURI.String
  let public = community.ReadPolicy == "eligible_users"
  let to = if public => [publicAudience] else [audience]
  let cc = if public => [audience] else [] as Slice[String]
  let format = if record.ContentFormat == "" then
    "legacy"
  else
    record.ContentFormat
  end
  let rendered = content.RenderRich(sanitizer, record.Body, format)
  ObjectRepresentation{
    Context: activityStreamsContext,
    DiscussionContext: discussionContext,
    ID: record.ObjectURI.String,
    Type: record.ObjectType,
    AttributedTo: record.AuthorActorURI,
    Name: content.RenderText(record.Title.String),
    Content: rendered.UnwrapOr(""),
    MediaType: "text/html",
    Source: if format == "markdown" then
      RichSource {
        Content: record.Body,
        MediaType: "text/markdown",
      }
    else
      Zero[RichSource]()
    end,
    Attachment: [],
    Tag: [],
    InReplyTo: record.ParentID.String,
    Published: record.AuthoredAt,
    Updated: record.UpdatedAt,
    To: to,
    CC: cc,
  }
end

func BuildTombstoneRepresentation(record: storage.PostRecord) -> TombstoneRepresentation
  TombstoneRepresentation{
    Context: activityStreamsContext,
    ID: record.ObjectURI.String,
    Type: "Tombstone",
    FormerType: record.ObjectType,
    Deleted: record.DeletedAt.Time,
  }
end

# Federated actors only; local-only communities and their objects have no
# ActivityPub representation.
func FederatedCommunity(record: storage.CommunityRecord) -> Bool
  record.FederationMode == "federated" && record.ActorURI.Valid && record.ActorURI.String != ""
end
