package federation

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import httptest "go:net/http/httptest"
import time "go:time"
import strings "go:strings"
import storage "github.com/commune-project/commune-backend/internal/storage"

func TestPrivateMediaSignedFetchBounds(t: Ref[testing.T]) -> ()
  let key = storage.GeneratePrivatePEM().Unwrap()
  let publicKey = storage.PublicPEMFromPrivate(key).Unwrap()
  let handler = func(w: http.ResponseWriter, request: Ref[http.Request]) -> ()
    if VerifySignedGet(publicKey, request.Method, request.URL.RequestURI(), request.Host, request.Header.Get("Date"), request.Header.Get("Signature"), time.Now(), 300i64).IsErr() then
      w.WriteHeader(403)
      return
    end
    if request.URL.Path == "/redirect" then
      w.Header().Set("Location", "/ok")
      w.WriteHeader(302)
      return
    end
    if request.URL.Path == "/foreign" then
      w.Header().Set("Location", "http://127.0.0.1:1/secret")
      w.WriteHeader(302)
      return
    end
    let _ = w.Write(strings.Repeat("x", if request.URL.Path == "/large" then 1025 else 4 end) as Slice[Byte])
  end
  let peer = httptest.NewServer(handler as http.HandlerFunc)
  t.Cleanup(func() -> () peer.Close() end)
  let limits = FetchLimits{AllowPrivate: true, MaxBytes: 1024, TimeoutSeconds: 2, MaxRedirects: 2}
  let actor = "https://receiver.example/users/alice"
  let fetched = FetchPrivateMedia(context.Background(), peer.URL + "/redirect", actor, key, limits)
  if fetched.IsErr() || (fetched.Unwrap() as String) != "xxxx" then t.Fatal("signed media redirect failed") end
  if FetchPrivateMedia(context.Background(), peer.URL + "/large", actor, key, limits).IsOk() then t.Fatal("oversized private media accepted") end
  if FetchPrivateMedia(context.Background(), peer.URL + "/foreign", actor, key, limits).IsOk() then t.Fatal("signature crossed origin redirect") end
  let (ctx, cancel) = context.WithCancel(context.Background())
  cancel()
  if FetchPrivateMedia(ctx, peer.URL + "/ok", actor, key, limits).IsOk() then t.Fatal("canceled fetch continued") end
  if FetchPrivateMedia(context.Background(), peer.URL + "/ok", actor, key, FetchLimits{MaxBytes: 1024, TimeoutSeconds: 2, MaxRedirects: 2}).IsOk() then t.Fatal("private address bypassed policy") end
end
