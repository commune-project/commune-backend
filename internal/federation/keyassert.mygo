package federation

import rsa "go:crypto/rsa"
import failure "github.com/commune-project/commune-backend/internal/failure"

# x509.ParsePKIXPublicKey yields an untyped key. MyGO has no type-assertion
# syntax, so this single conversion is the only bound Go fragment needed
# alongside the nil check in signature.mygo.
func AsRSAPublicKey(key: Any) -> Result[Ref[rsa.PublicKey], failure.Failure]
  let parsed = go[Option[Ref[rsa.PublicKey]]] {
    code: """
      func() *rsa.PublicKey {
        typed, ok := {key}.(*rsa.PublicKey)
        if !ok {
          return nil
        }
        return typed
      }()
    """
    raw: Ref[rsa.PublicKey]
    in key = key
  }
  parsed.OkOr(Of("unsupported key type"))
end
