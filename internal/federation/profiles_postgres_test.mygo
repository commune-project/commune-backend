package federation

import testing "go:testing"
import context "go:context"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func TestPostgresPersonUpdateFreshnessBlocksAndLocalAuthority(t: Ref[testing.T]) -> ()
  let ctx = context.Background()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let site = config.Site{ID: "profiles", Origin: "https://profiles.example"}
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let local = storage.AccountRepository{DB: db}.Create(ctx, site, "alice", "", "alice-password").Unwrap()
  let remote = "https://remote.example/users/a"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind) VALUES (?,'Person')", remote)).Unwrap()
  let update = `{"id":"https://remote.example/activities/1","type":"Update","actor":"https://remote.example/users/a","object":{"id":"https://remote.example/users/a","type":"Person","name":"Newest","summary":"<p>Hello</p><script>bad()</script>","updated":"2026-01-02T00:00:00Z","icon":{"type":"Image","url":"https://192.0.2.1/never-fetch.png"}}}`
  let _ = ApplyPersonUpdate(ctx, db, site, update as Slice[Byte]).Unwrap()
  let older = strings.Replace(strings.Replace(update, "Newest", "Old", 1), "2026-01-02", "2026-01-01", 1)
  let _ = ApplyPersonUpdate(ctx, db, site, older as Slice[Byte]).Unwrap()
  let profile = storage.LoadProfile(ctx, db, remote).Unwrap()
  if profile.DisplayName != "Newest" || strings.Contains(profile.BiographyHTML, "script") || profile.AvatarURL != "https://192.0.2.1/never-fetch.png" then
    t.Fatal("stale update, unsafe biography or public avatar metadata failed")
  end
  let forgedLocal = strings.ReplaceAll(update, remote, local.ActorURI)
  if ApplyPersonUpdate(ctx, db, site, forgedLocal as Slice[Byte]).IsOk() then
    t.Fatal("remote update altered local account profile")
  end
  let _ = storage.MutationResult(db.Exec("INSERT INTO site_actor_blocks(site_id,actor_uri) VALUES (?,?)", site.ID, remote)).Unwrap()
  let newer = strings.Replace(update, "2026-01-02", "2026-01-03", 1)
  if ApplyPersonUpdate(ctx, db, site, newer as Slice[Byte]).IsOk() then
    t.Fatal("blocked Actor update accepted")
  end
end
