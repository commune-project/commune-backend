package federation

import testing "go:testing"
import strings "go:strings"
import storage "github.com/commune-project/commune-backend/internal/storage"

func TestRichObjectRepresentation(t: Ref[testing.T]) -> ()
  let post = storage.PostRecord{Body: "**中文** [link](https://example.org)", ContentFormat: "markdown"}
  let output = BuildObjectRepresentation(post, storage.CommunityRecord{ReadPolicy: "eligible_users"})
  if output.MediaType != "text/html" || !strings.Contains(output.Content, "<strong>中文</strong>") || output.Source.Content != post.Body || output.Source.MediaType != "text/markdown" then
    t.Fatal("rich output lost rendered HTML or source")
  end
  let remote = BuildObjectRepresentation(storage.PostRecord{Body: "<p>safe</p><script>alert(1)</script>", ContentFormat: "html"}, storage.CommunityRecord{})
  if strings.Contains(remote.Content, "<script") || !strings.Contains(remote.Content, "<p>safe</p>") || remote.Source.Content != "" then
    t.Fatal("remote HTML was reinterpreted or unsafe")
  end
end

func TestParseRichObjectBoundaries(t: Ref[testing.T]) -> ()
  let payload = `{"id":"https://remote.example/p/1","type":"Page","attributedTo":"https://remote.example/u/a","published":"2026-01-01T00:00:00Z","content":"<p>safe</p>","source":{"content":"<script>untrusted</script>","mediaType":"text/markdown"},"extension":{"untouched":true}}`
  let parsed = ParseRichObject(payload as Slice[Byte]).Unwrap()
  if parsed.Content != "<p>safe</p>" || parsed.Source.Content != "<script>untrusted</script>" then
    t.Fatal("source replaced display or optional fields rejected")
  end
  if ParseRichObject(strings.Replace(payload, "https://remote.example/p/1", "javascript:bad", 1) as Slice[Byte]).IsOk() then
    t.Fatal("invalid canonical identity accepted")
  end
end
