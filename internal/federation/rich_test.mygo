package federation

import testing "go:testing"
import sql "go:database/sql"
import time "go:time"
import strings "go:strings"
import storage "github.com/commune-project/commune-backend/internal/storage"
import content "github.com/commune-project/commune-backend/internal/content"

func TestRichObjectRepresentation(t: Ref[testing.T]) -> ()
  let post = richTestPost("**中文** [link](https://example.org)", "markdown")
  let output = BuildObjectRepresentation(
    content.DefaultSanitizer(),
    post,
    richTestCommunity("eligible_users")
  )
  if output.MediaType != "text/html" ||
    !strings.Contains(output.Content, "<strong>中文</strong>") ||
    output.Source.Content != post.Body ||
    output.Source.MediaType != "text/markdown" then
    t.Fatal("rich output lost rendered HTML or source")
  end
  let remote = BuildObjectRepresentation(
    content.DefaultSanitizer(),
    richTestPost("<p>safe</p><script>alert(1)</script>", "html"),
    richTestCommunity("eligible_users")
  )
  if strings.Contains(remote.Content, "<script") ||
    !strings.Contains(remote.Content, "<p>safe</p>") ||
    remote.Source.Content != "" then
    t.Fatal("remote HTML was reinterpreted or unsafe")
  end
end

func richTestPost(body: String, format: String) -> storage.PostRecord
  storage.PostRecord{ID: "", ObjectURI: Zero[sql.NullString](), CommunityID: "", FederationMode: "", AuthorActorURI: "", ObjectType: "Page", Title: Zero[sql.NullString](), Body: body, ContentFormat: format, SearchText: "", RichMetadata: "", ParentID: Zero[sql.NullString](), AuthoredAt: Zero[time.Time](), UpdatedAt: Zero[time.Time](), Version: 0i64, DeletedAt: Zero[sql.NullTime]()}
end

func richTestCommunity(readPolicy: String) -> storage.CommunityRecord
  storage.CommunityRecord{ID: "", HostSiteID: "", ActorURI: Zero[sql.NullString](), CreatorActorURI: "", FederationMode: "federated", ReadPolicy: readPolicy, PostPolicy: "eligible_users", FollowPolicy: "open", Name: "", Title: "", Description: "", PolicyVersion: 1i64}
end

func TestParseRichObjectBoundaries(t: Ref[testing.T]) -> ()
  let payload = `{"id":"https://remote.example/p/1","type":"Page","attributedTo":"https://remote.example/u/a","published":"2026-01-01T00:00:00Z","content":"<p>safe</p>","source":{"content":"<script>untrusted</script>","mediaType":"text/markdown"},"extension":{"untouched":true}}`
  let parsed = ParseRichObject(content.DefaultSanitizer(), payload as Slice[Byte]).Unwrap()
  if parsed.Content != "<p>safe</p>" || parsed.Source.Content != "<script>untrusted</script>" then
    t.Fatal("source replaced display or optional fields rejected")
  end
  if ParseRichObject(content.DefaultSanitizer(), strings.Replace(payload, "https://remote.example/p/1", "javascript:bad", 1) as Slice[Byte]).IsOk() then
    t.Fatal("invalid canonical identity accepted")
  end
end
