package auth

import aes "go:crypto/aes"
import cipher "go:crypto/cipher"
import rand "go:crypto/rand"

func SealPasswordReset(key: Slice[Byte], message: String) -> Result[Slice[Byte], String]
  switch aes.NewCipher(key)
    case Err(_) => Err("reset encryption unavailable")
    case Ok(block) then
      switch cipher.NewGCM(block)
        case Err(_) => Err("reset encryption unavailable")
        case Ok(aead) then
          let nonce = rand.Text() as Slice[Byte]
          if rand.Read(nonce).IsErr() then
            return Err("reset encryption unavailable")
          end
          let prefix = nonce.Take(aead.NonceSize())
          Ok(aead.Seal(prefix, prefix, message as Slice[Byte], "commune-password-reset-v1" as Slice[Byte]))
        end
      end
    end
  end
end

func OpenPasswordReset(key: Slice[Byte], encrypted: Slice[Byte]) -> Result[String, String]
  switch aes.NewCipher(key)
    case Err(_) => Err("reset encryption unavailable")
    case Ok(block) then
      switch cipher.NewGCM(block)
        case Err(_) => Err("invalid reset payload")
        case Ok(aead) then
          let size = aead.NonceSize()
          if encrypted.Len() < size then
            return Err("invalid reset payload")
          end
          switch aead.Open(
            [],
            encrypted.Take(size),
            encrypted.Skip(size),
            "commune-password-reset-v1" as Slice[Byte]
          )
            case Err(_) => Err("invalid reset payload")
            case Ok(opened) => Ok(opened as String)
          end
        end
      end
    end
  end
end
