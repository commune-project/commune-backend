package auth

import testing "go:testing"

func TestPasswordResetSealing(t: Ref[testing.T]) -> ()
  let key = "0123456789abcdef0123456789abcdef" as Slice[Byte]
  let message = "https://forum.example/reset-password#token=sensitive"
  let sealed = SealPasswordReset(key, message).Unwrap()
  if sealed.Len() <= 12 || OpenPasswordReset(key, sealed).Unwrap() != message then
    t.Fatal("reset payload did not round trip")
  end
  let tampered = sealed.Append(0 as Byte)
  if OpenPasswordReset(key, tampered).IsOk() then
    t.Fatal("tampered reset payload was accepted")
  end
  let other = "fedcba9876543210fedcba9876543210" as Slice[Byte]
  if OpenPasswordReset(other, sealed).IsOk() then
    t.Fatal("reset payload opened with the wrong key")
  end
end
