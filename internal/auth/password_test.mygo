package auth

import testing "go:testing"

func TestPasswordHash(t: Ref[testing.T]) -> ()
  let password = "first-site-password"
  let first = HashPassword(password).Unwrap()
  let second = HashPassword(password).Unwrap()
  if first == password || first == second || !VerifyPassword(first, password) || VerifyPassword(first, "other-site-password") then
    t.Fatal("password hashing or verification failed")
  end
  if HashPassword("short").IsOk() then
    t.Fatal("short password accepted")
  end
end
