package auth

import bcrypt "go:golang.org/x/crypto/bcrypt"

func HashPassword(password: String) -> Result[String, String]
  let bytes = password as Slice[Byte]
  if bytes.Len() < 12 || bytes.Len() > 72 then
    return Err("password must contain between 12 and 72 bytes")
  end
  switch bcrypt.GenerateFromPassword(bytes, bcrypt.DefaultCost)
  case Err(_) => Err("password hashing failed")
  case Ok(hash) => Ok(hash as String)
  end
end

func VerifyPassword(hash: String, password: String) -> Bool
  bcrypt.CompareHashAndPassword(hash as Slice[Byte], password as Slice[Byte]).IsOk()
end
