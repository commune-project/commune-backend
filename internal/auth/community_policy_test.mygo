package auth

import testing "go:testing"

func TestIndependentCommunityAccess(t: Ref[testing.T]) -> ()
  let local = AccessSubject {
    SiteID: "a",
    AccountID: 1i64,
    ActorURI: "https://a.example/users/alice",
    Verified: true,
    Member: false,
    Blocked: false,
  }
  let member = AccessSubject {
    SiteID: "a",
    AccountID: 1i64,
    ActorURI: local.ActorURI,
    Verified: true,
    Member: true,
    Blocked: false,
  }
  let foreign = AccessSubject {
    SiteID: "b",
    AccountID: 2i64,
    ActorURI: "https://b.example/users/bob",
    Verified: true,
    Member: true,
    Blocked: false,
  }
  let remote = AccessSubject {
    SiteID: "",
    AccountID: 0i64,
    ActorURI: "https://remote.example/users/bob",
    Verified: true,
    Member: true,
    Blocked: false,
  }
  let anonymous = AccessSubject {
    SiteID: "",
    AccountID: 0i64,
    ActorURI: "",
    Verified: false,
    Member: false,
    Blocked: false,
  }
  let policies: Slice[CommunityPolicy] = [
    NewCommunityPolicy("a", "local_only", "eligible_users", "eligible_users").Unwrap(),
    NewCommunityPolicy("a", "local_only", "members", "members").Unwrap(),
    NewCommunityPolicy("a", "local_only", "eligible_users", "members").Unwrap(),
  ]
  policies.Each(func(policy: CommunityPolicy) -> ()
    if !policy.Valid() ||
      policy.AllowsFederation() ||
      !policy.CanRead(member) ||
      !policy.CanPost(member) then
      t.Fatal("local member access or federation isolation failed")
    end
    if policy.CanRead(local) != policy.ReadPolicy.IsEligibleUsers() ||
      policy.CanPost(local) != policy.PostPolicy.IsEligibleUsers() then
      t.Fatal("local non-member access does not match independent policies")
    end
    [foreign, remote, anonymous].Each(func(subject: AccessSubject) -> ()
      if policy.CanRead(subject) || policy.CanPost(subject) then
        t.Fatal("local-only content accessible outside its site")
      end
    end)
    let federated = CommunityPolicy{
      HostSiteID: "a",
      FederationMode: FederationMode.Federated,
      ReadPolicy: policy.ReadPolicy,
      PostPolicy: policy.PostPolicy,
    }
    if !federated.AllowsFederation() ||
      !federated.CanRead(remote) ||
      !federated.CanPost(remote) ||
      federated.CanPost(anonymous) then
      t.Fatal("verified remote member or anonymous posting policy failed")
    end
    if federated.CanRead(anonymous) != policy.ReadPolicy.IsEligibleUsers() then
      t.Fatal("federated public and member-only reading were conflated")
    end
    let revoked = AccessSubject{
      SiteID: "",
      AccountID: 0i64,
      ActorURI: remote.ActorURI,
      Verified: true,
      Member: false,
      Blocked: false,
    }
    if federated.CanRead(revoked) != policy.ReadPolicy.IsEligibleUsers() ||
      federated.CanPost(revoked) != policy.PostPolicy.IsEligibleUsers() then
      t.Fatal("former membership bypassed current policy")
    end
    let blocked = AccessSubject{
      SiteID: "a",
      AccountID: 1i64,
      ActorURI: local.ActorURI,
      Verified: true,
      Member: true,
      Blocked: true,
    }
    if policy.CanRead(blocked) ||
      policy.CanPost(blocked) ||
      federated.CanRead(blocked) ||
      federated.CanPost(blocked) then
      t.Fatal("membership bypassed a site block")
    end
  end)
  let invalid = CommunityPolicy{
    HostSiteID: "a",
    FederationMode: FederationMode.Federated,
    ReadPolicy: ReadPolicy.Members,
    PostPolicy: PostPolicy.EligibleUsers,
  }
  if invalid.Valid() ||
    invalid.CanRead(member) ||
    invalid.CanPost(member) ||
    invalid.AllowsFederation() then
    t.Fatal("invalid policy did not fail closed")
  end
end
