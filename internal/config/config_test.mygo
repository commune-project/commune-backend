package config

import testing "go:testing"
import strings "go:strings"
import os "go:os"
import filepath "go:path/filepath"

func validInput() -> Input
  Input{
    Sites: [Site{ID: "a", Origin: "https://A.EXAMPLE.:443/", Aliases: ["alias.example"]}, Site{ID: "b", Origin: "https://b.example", Aliases: []}],
    DatabaseURL: "postgres://app:secret@localhost/commune?sslmode=disable",
    TrustedProxies: ["192.0.2.0/24", "2001:db8::/32"],
    Runtime: Runtime{Listen: "127.0.0.1:8080", ReadTimeoutSeconds: 15, WriteTimeoutSeconds: 30, IdleTimeoutSeconds: 60, ShutdownTimeoutSeconds: 10, MaxBodyBytes: 1048576, MaxPageSize: 100, Workers: 2}
    Federation: Federation{AllowPrivateNetwork: false, FetchTimeoutSeconds: 10, MaxFetchBytes: 1048576, MaxRedirects: 5, ClockSkewSeconds: 300}
  }
end

func validated(t: Ref[testing.T]) -> Config
  t.Helper()
  Validate(validInput()).Unwrap()
end

struct AuthorityCase
  Input: String
  Want: String
end

func TestOriginsAndAuthority(t: Ref[testing.T]) -> ()
  let cases = [
    AuthorityCase{Input: "A.EXAMPLE.:443", Want: "a.example"},
    AuthorityCase{Input: "a.example:8443", Want: "a.example:8443"},
    AuthorityCase{Input: "[2001:0db8::1]:443", Want: "[2001:db8::1]"}
  ]
  cases.Each(func(test: AuthorityCase) -> ()
    switch NormalizeAuthority(test.Input)
    case Ok(value) =>
      if value != test.Want then
        t.Errorf("authority %s: %s", test.Input, value)
      end
    case Err(message) => t.Errorf("authority %s: %s", test.Input, message)
    end
  end)
  let invalid = ["http://a.example", "https://a.example/path", "https://user:password@a.example", "https://a.example?", "https://a.example#", "https://a.example:0", "https://a.example:65536", "https://a.example:", "https://a..example", "https://-a.example", "https://a.example\\evil", "https://a.example\n"]
  invalid.Each(func(origin: String) -> ()
    if NormalizeOrigin(origin).IsOk() then
      t.Errorf("invalid origin accepted: %s", origin)
    end
  end)
  if NormalizeAuthority("2001:db8::1:443").IsOk() then
    t.Fatal("unbracketed IPv6 authority accepted")
  end
  if validated(t).Sites.Get(0).Unwrap().Origin != "https://a.example" then
    t.Fatal("origin normalization failed")
  end
end

func TestInvalidConfiguration(t: Ref[testing.T]) -> ()
  # Mutations are confined to fresh test fixtures, never shared application state.
  let names = ["no sites", "duplicate origin", "duplicate alias", "duplicate id", "empty id", "bad database", "malformed database", "missing database", "bad database port", "bad database query", "bad proxy", "zero timeout", "unbounded workers", "unbounded page", "unbounded body", "bad listen"]
  names.Each(func(name: String) -> ()
    t.Run(name, func(t: Ref[testing.T]) -> ()
      var input = validInput()
      switch name
      case "no sites" => input.Sites = []
      case "duplicate origin" => input.Sites = [input.Sites.Get(0).Unwrap(), Site{ID: "b", Origin: "https://a.example:443", Aliases: []}]
      case "duplicate alias" => input.Sites = [input.Sites.Get(0).Unwrap(), Site{ID: "b", Origin: "https://b.example", Aliases: ["ALIAS.EXAMPLE."]}]
      case "duplicate id" => input.Sites = [input.Sites.Get(0).Unwrap(), Site{ID: "a", Origin: "https://b.example", Aliases: []}]
      case "empty id" => input.Sites = [Site{ID: "", Origin: "https://a.example", Aliases: []}]
      case "bad database" => input.DatabaseURL = "mysql://user:secret@localhost/db"
      case "malformed database" => input.DatabaseURL = "postgres://secret%zz"
      case "missing database" => input.DatabaseURL = "postgres://localhost/"
      case "bad database port" => input.DatabaseURL = "postgres://localhost:70000/db"
      case "bad database query" => input.DatabaseURL = "postgres://localhost/db?secret=%zz"
      case "bad proxy" => input.TrustedProxies = ["localhost"]
      case "zero timeout" => input.Runtime.ReadTimeoutSeconds = 0
      case "unbounded workers" => input.Runtime.Workers = 1000
      case "unbounded page" => input.Runtime.MaxPageSize = 10000
      case "unbounded body" => input.Runtime.MaxBodyBytes = 1073741824
      case "bad listen" => input.Runtime.Listen = "localhost"
      case _ => ()
      end
      switch Validate(input)
      case Ok(_) => t.Fatal("invalid config accepted")
      case Err(message) =>
        if strings.Contains(message, "secret") || strings.Contains(message, "postgres://") then
          t.Fatal("configuration error leaked credentials")
        end
      end
    end)
    ()
  end)
end

func TestLoad(t: Ref[testing.T]) -> ()
  if Load("../../config/example.json").IsErr() then
    t.Fatal("documented configuration rejected")
  end
  let path = filepath.Join(t.TempDir(), "invalid.json")
  let content = `{"database_url":"secret", broken}`
  let bytes = content as Slice[Byte]
  if os.WriteFile(path, bytes, 0o600 as os.FileMode).IsErr() then
    t.Fatal("cannot write test fixture")
  end
  let paths = [path, filepath.Join(t.TempDir(), "missing.json")]
  paths.Each(func(file: String) -> ()
    switch Load(file)
    case Ok(_) => t.Fatal("invalid file accepted")
    case Err(message) =>
      if strings.Contains(message, "secret") then
        t.Fatal("file error exposes contents")
      end
    end
  end)
end
