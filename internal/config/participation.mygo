package config

import base64 "go:encoding/base64"
import json "go:encoding/json"
import filepath "go:path/filepath"
import mail "go:net/mail"
import os "go:os"
import regexp "go:regexp"
import strings "go:strings"
import content "github.com/commune-project/commune-backend/internal/content"
import functional "github.com/commune-project/commune-backend/internal/functional"

struct Registration
  OutboxSecret: String `json:"outbox_secret"`
  OutboxSecretEnv: String `json:"outbox_secret_env"`
  TokenTTLSeconds: Int `json:"token_ttl_seconds"`
  RateWindowSeconds: Int `json:"rate_window_seconds"`
  IPLimit: Int `json:"ip_limit"`
  EmailLimit: Int `json:"email_limit"`
end

func ResolveParticipationSecrets(input: Input) -> Result[Input, String]
  var settings = input
  if settings.Registration.OutboxSecretEnv != "" then
    if settings.Registration.OutboxSecret != "" then
      return Err("configure only one outbox secret source")
    end
    let secret = os.Getenv(settings.Registration.OutboxSecretEnv)
    if secret == "" then
      return Err("outbox secret environment variable is missing or empty")
    end
    settings.Registration.OutboxSecret = secret
  end
  Ok(settings)
end

struct SMTP
  Host: String `json:"host"`
  Username: String `json:"username"`
  Password: String `json:"password"`
  From: String `json:"from"`
  TLSMode: String `json:"tls_mode"`
  Port: Int `json:"port"`
  TimeoutSeconds: Int `json:"timeout_seconds"`
end

struct Media
  Enabled: Bool `json:"enabled"`
  Root: String `json:"root"`
  MaxFileBytes: Int `json:"max_file_bytes"`
  MaxImageBytes: Int `json:"max_image_bytes"`
  MaxImagePixels: Int `json:"max_image_pixels"`
  MaxImageDimension: Int `json:"max_image_dimension"`
  PreviewDimension: Int `json:"preview_dimension"`
  AccountQuotaBytes: Int `json:"account_quota_bytes"`
  SiteQuotaBytes: Int `json:"site_quota_bytes"`
  TemporaryRetentionSeconds: Int `json:"temporary_retention_seconds"`
  PrivateCacheRetentionSeconds: Int `json:"private_cache_retention_seconds"`
  CleanupIntervalSeconds: Int `json:"cleanup_interval_seconds"`
end

struct Markdown
  HardWraps: json.RawMessage `json:"hard_wraps"`
  AllowRawHTML: json.RawMessage `json:"allow_raw_html"`
end

struct SanitizeAttribute
  Element: String `json:"element"`
  Names: Slice[String] `json:"names"`
end

struct Sanitize
  Elements: Slice[String] `json:"elements"`
  Attributes: Slice[SanitizeAttribute] `json:"attributes"`
  URLSchemes: Slice[String] `json:"url_schemes"`
  AllowRelativeURLs: json.RawMessage `json:"allow_relative_urls"`
end

struct Rendering
  MaxSourceBytes: Int `json:"max_source_bytes"`
  MaxDisplayNameLength: Int `json:"max_display_name_length"`
  MaxBiographyLength: Int `json:"max_biography_length"`
  MaxMentions: Int `json:"max_mentions"`
  MaxRemoteDiscoveries: Int `json:"max_remote_discoveries"`
  MentionTimeoutSeconds: Int `json:"mention_timeout_seconds"`
  Markdown: Markdown `json:"markdown"`
  Sanitize: Sanitize `json:"sanitize"`
  Sanitizer: content.Sanitizer `json:"-"`
end

let blockedMarkupElements: Slice[String] = [
  "script",
  "style",
  "iframe",
  "frame",
  "frameset",
  "object",
  "embed",
  "applet",
  "template",
  "svg",
  "math",
  "xmp",
  "plaintext",
  "title",
  "textarea",
  "canvas",
  "video",
  "audio",
  "form",
  "button",
  "input",
  "base",
  "meta",
  "link",
]

let tagNamePattern = regexp.MustCompile("^[a-z][a-z0-9-]*$")
let attributeNamePattern = regexp.MustCompile("^[a-z][a-z0-9:_-]*$")

func OptionalBool(raw: json.RawMessage, fallback: Bool) -> Result[Bool, String]
  if (raw as Slice[Byte]).Len() == 0 then
    return Ok(fallback)
  end
  var value = false
  if json.Unmarshal(raw as Slice[Byte], Ref.new(value)).IsErr() then
    return Err("rendering boolean must be true or false")
  end
  Ok(value)
end

func OptionalSliceMissing[T](values: Slice[T]) -> Bool
  go[Bool] {
    code: "{values} == nil"
    in values = values
  }
end

func BlockedMarkupElement(name: String) -> Bool
  blockedMarkupElements.Contains(strings.ToLower(name))
end

func ValidMarkupAttribute(name: String) -> Bool
  let lower = strings.ToLower(name)
  lower != "style" &&
    lower != "srcset" &&
    !strings.HasPrefix(lower, "on") &&
    attributeNamePattern.MatchString(lower)
end

func BuildRendering(rendering: Rendering) -> Result[Rendering, String]
  let flags: Slice[Result[Bool, String]] = [
    OptionalBool(rendering.Markdown.HardWraps, true).MapErr(func(_: String) -> String
      "rendering.markdown.hard_wraps must be a boolean"
    end),
    OptionalBool(rendering.Markdown.AllowRawHTML, false).MapErr(func(_: String) -> String
      "rendering.markdown.allow_raw_html must be a boolean"
    end),
    OptionalBool(rendering.Sanitize.AllowRelativeURLs, true).MapErr(func(_: String) -> String
      "rendering.sanitize.allow_relative_urls must be a boolean"
    end),
  ]
  let parsed = functional.Sequence(flags)
  if parsed.IsErr() then
    return Err(parsed.UnwrapErr())
  end
  let values = parsed.Unwrap()
  let hardWraps = values.Get(0).UnwrapOr(true)
  let rawHTML = values.Get(1).UnwrapOr(false)
  let relative = values.Get(2).UnwrapOr(true)
  if !RenderingAllowlistValid(rendering.Sanitize) then
    return Err("rendering sanitize allowlist is invalid")
  end
  let attributes = rendering.Sanitize.Attributes.Map(func(item: SanitizeAttribute) -> content.SanitizerAttribute
    content.SanitizerAttribute { Element: item.Element, Names: item.Names }
  end)
  var output = rendering
  output.Sanitizer = content.NewSanitizer(content.SanitizerConfig{
    HardWraps: hardWraps,
    AllowRawHTML: rawHTML,
    Elements: rendering.Sanitize.Elements,
    Attributes: attributes,
    URLSchemes: rendering.Sanitize.URLSchemes,
    AllowRelativeURLs: relative,
  })
  Ok(output)
end

func RenderingAllowlistValid(sanitize: Sanitize) -> Bool
  let elementsClean = sanitize.Elements.All(func(name: String) -> Bool
    tagNamePattern.MatchString(name) && !BlockedMarkupElement(name)
  end)
  let attributesClean = sanitize.Attributes.All(func(item: SanitizeAttribute) -> Bool
    sanitize.Elements.Contains(item.Element) &&
      item.Names.Len() > 0 &&
      item.Names.All(func(name: String) -> Bool
        ValidMarkupAttribute(name)
      end)
  end)
  let schemesClean = sanitize.URLSchemes.All(func(scheme: String) -> Bool
    let lower = strings.ToLower(scheme)
    lower == "http" || lower == "https" || lower == "mailto" || lower == "tel"
  end)
  elementsClean && attributesClean && schemesClean
end

struct ParticipationWorkers
  Enabled: Bool `json:"enabled"`
  MailWorkers: Int `json:"mail_workers"`
  NotificationWorkers: Int `json:"notification_workers"`
  MediaWorkers: Int `json:"media_workers"`
  ActorWorkers: Int `json:"actor_workers"`
  BatchSize: Int `json:"batch_size"`
  PollIntervalSeconds: Int `json:"poll_interval_seconds"`
  LeaseSeconds: Int `json:"lease_seconds"`
  MaxAttempts: Int `json:"max_attempts"`
  RetryBaseSeconds: Int `json:"retry_base_seconds"`
  RetryMaxSeconds: Int `json:"retry_max_seconds"`
end

func OrDefault(value: Int, fallback: Int) -> Int
  if value == 0 then
    fallback
  else
    value
  end
end

func RegistrationDefaults(value: Registration) -> Registration
  Registration {
    OutboxSecret: value.OutboxSecret,
    OutboxSecretEnv: value.OutboxSecretEnv,
    TokenTTLSeconds: OrDefault(value.TokenTTLSeconds, 86400),
    RateWindowSeconds: OrDefault(value.RateWindowSeconds, 3600),
    IPLimit: OrDefault(value.IPLimit, 20),
    EmailLimit: OrDefault(value.EmailLimit, 3),
  }
end

func SMTPDefaults(value: SMTP) -> SMTP
  SMTP {
    Host: value.Host,
    Username: value.Username,
    Password: value.Password,
    From: value.From,
    TLSMode: if value.TLSMode == "" => "starttls" else value.TLSMode,
    Port: OrDefault(value.Port, 587),
    TimeoutSeconds: OrDefault(value.TimeoutSeconds, 10),
  }
end

func MediaDefaults(value: Media) -> Media
  Media {
    Enabled: value.Enabled,
    Root: value.Root,
    MaxFileBytes: OrDefault(value.MaxFileBytes, 26214400),
    MaxImageBytes: OrDefault(value.MaxImageBytes, 10485760),
    MaxImagePixels: OrDefault(value.MaxImagePixels, 20000000),
    MaxImageDimension: OrDefault(value.MaxImageDimension, 16384),
    PreviewDimension: OrDefault(value.PreviewDimension, 1024),
    AccountQuotaBytes: OrDefault(value.AccountQuotaBytes, 1073741824),
    SiteQuotaBytes: OrDefault(value.SiteQuotaBytes, 10737418240),
    TemporaryRetentionSeconds: OrDefault(value.TemporaryRetentionSeconds, 86400),
    PrivateCacheRetentionSeconds: OrDefault(value.PrivateCacheRetentionSeconds, 604800),
    CleanupIntervalSeconds: OrDefault(value.CleanupIntervalSeconds, 3600),
  }
end

func RenderingDefaults(value: Rendering) -> Rendering
  Rendering {
    MaxSourceBytes: OrDefault(value.MaxSourceBytes, 1048576),
    MaxDisplayNameLength: OrDefault(value.MaxDisplayNameLength, 100),
    MaxBiographyLength: OrDefault(value.MaxBiographyLength, 5000),
    MaxMentions: OrDefault(value.MaxMentions, 20),
    MaxRemoteDiscoveries: OrDefault(value.MaxRemoteDiscoveries, 10),
    MentionTimeoutSeconds: OrDefault(value.MentionTimeoutSeconds, 10),
    Markdown: value.Markdown,
    Sanitize: SanitizeDefaults(value.Sanitize),
    Sanitizer: value.Sanitizer,
  }
end

func SanitizeDefaults(value: Sanitize) -> Sanitize
  let defaults = content.DefaultSanitizerConfig
  let elements = if OptionalSliceMissing(value.Elements) then
    defaults.Elements
  else
    value.Elements
  end
  let attributes = if OptionalSliceMissing(value.Attributes) then
    defaults.Attributes.Map(func(item: content.SanitizerAttribute) -> SanitizeAttribute
      SanitizeAttribute{Element: item.Element, Names: item.Names}
    end)
  else
    value.Attributes
  end
  let schemes = if OptionalSliceMissing(value.URLSchemes) then
    defaults.URLSchemes
  else
    value.URLSchemes
  end
  Sanitize {
    Elements: elements,
    Attributes: attributes,
    URLSchemes: schemes,
    AllowRelativeURLs: value.AllowRelativeURLs,
  }
end

func WorkerDefaults(value: ParticipationWorkers) -> ParticipationWorkers
  ParticipationWorkers {
    Enabled: value.Enabled,
    MailWorkers: OrDefault(value.MailWorkers, 1),
    NotificationWorkers: OrDefault(value.NotificationWorkers, 1),
    MediaWorkers: OrDefault(value.MediaWorkers, 1),
    ActorWorkers: OrDefault(value.ActorWorkers, 1),
    BatchSize: OrDefault(value.BatchSize, 100),
    PollIntervalSeconds: OrDefault(value.PollIntervalSeconds, 5),
    LeaseSeconds: OrDefault(value.LeaseSeconds, 60),
    MaxAttempts: OrDefault(value.MaxAttempts, 8),
    RetryBaseSeconds: OrDefault(value.RetryBaseSeconds, 30),
    RetryMaxSeconds: OrDefault(value.RetryMaxSeconds, 3600),
  }
end

func ParticipationDefaults(input: Input) -> Input
  Input{
    Registration: RegistrationDefaults(input.Registration),
    SMTP: SMTPDefaults(input.SMTP),
    Media: MediaDefaults(input.Media),
    Rendering: RenderingDefaults(input.Rendering),
    ParticipationWorkers: WorkerDefaults(input.ParticipationWorkers),
    Sites: input.Sites,
    DatabaseURL: input.DatabaseURL,
    TrustedProxies: input.TrustedProxies,
    Runtime: input.Runtime,
    Federation: input.Federation,
  }
end

func ValidateParticipation(input: Input) -> Result[(), String]
  if input.Registration.TokenTTLSeconds < 60 || input.Registration.TokenTTLSeconds > 604800 then
    return Err("registration.token_ttl_seconds is out of range")
  end
  if input.Registration.RateWindowSeconds < 60 || input.Registration.RateWindowSeconds > 86400 then
    return Err("registration.rate_window_seconds is out of range")
  end
  if input.Registration.IPLimit < 1 || input.Registration.IPLimit > 10000 then
    return Err("registration.ip_limit is out of range")
  end
  if input.Registration.EmailLimit < 1 || input.Registration.EmailLimit > 100 then
    return Err("registration.email_limit is out of range")
  end
  if input.SMTP.Port < 1 || input.SMTP.Port > 65535 then
    return Err("smtp.port is out of range")
  end
  if input.SMTP.TimeoutSeconds < 1 || input.SMTP.TimeoutSeconds > 60 then
    return Err("smtp.timeout_seconds is out of range")
  end
  if input.Media.MaxFileBytes < 1024 || input.Media.MaxFileBytes > 1073741824 then
    return Err("media.max_file_bytes is out of range")
  end
  if input.Media.MaxImageBytes < 1024 || input.Media.MaxImageBytes > 1073741824 then
    return Err("media.max_image_bytes is out of range")
  end
  if input.Media.MaxImagePixels < 1 || input.Media.MaxImagePixels > 100000000 then
    return Err("media.max_image_pixels is out of range")
  end
  if input.Media.MaxImageDimension < 1 || input.Media.MaxImageDimension > 65536 then
    return Err("media.max_image_dimension is out of range")
  end
  if input.Media.PreviewDimension < 1 || input.Media.PreviewDimension > 4096 then
    return Err("media.preview_dimension is out of range")
  end
  if input.Media.AccountQuotaBytes < 1024 || input.Media.AccountQuotaBytes > 1099511627776 then
    return Err("media.account_quota_bytes is out of range")
  end
  if input.Media.SiteQuotaBytes < 1024 || input.Media.SiteQuotaBytes > 1099511627776 then
    return Err("media.site_quota_bytes is out of range")
  end
  if input.Media.TemporaryRetentionSeconds < 60 ||
    input.Media.TemporaryRetentionSeconds > 2592000 then
    return Err("media.temporary_retention_seconds is out of range")
  end
  if input.Media.PrivateCacheRetentionSeconds < 60 ||
    input.Media.PrivateCacheRetentionSeconds > 31536000 then
    return Err("media.private_cache_retention_seconds is out of range")
  end
  if input.Media.CleanupIntervalSeconds < 1 || input.Media.CleanupIntervalSeconds > 86400 then
    return Err("media.cleanup_interval_seconds is out of range")
  end
  if input.Rendering.MaxSourceBytes < 1 || input.Rendering.MaxSourceBytes > 16777216 then
    return Err("rendering.max_source_bytes is out of range")
  end
  if input.Rendering.MaxDisplayNameLength < 1 || input.Rendering.MaxDisplayNameLength > 1000 then
    return Err("rendering.max_display_name_length is out of range")
  end
  if input.Rendering.MaxBiographyLength < 1 || input.Rendering.MaxBiographyLength > 100000 then
    return Err("rendering.max_biography_length is out of range")
  end
  if input.Rendering.MaxMentions < 1 || input.Rendering.MaxMentions > 100 then
    return Err("rendering.max_mentions is out of range")
  end
  if input.Rendering.MaxRemoteDiscoveries < 1 || input.Rendering.MaxRemoteDiscoveries > 100 then
    return Err("rendering.max_remote_discoveries is out of range")
  end
  if input.Rendering.MentionTimeoutSeconds < 1 || input.Rendering.MentionTimeoutSeconds > 60 then
    return Err("rendering.mention_timeout_seconds is out of range")
  end
  if input.ParticipationWorkers.MailWorkers < 1 || input.ParticipationWorkers.MailWorkers > 32 then
    return Err("participation_workers.mail_workers is out of range")
  end
  if input.ParticipationWorkers.NotificationWorkers < 1 ||
    input.ParticipationWorkers.NotificationWorkers > 32 then
    return Err("participation_workers.notification_workers is out of range")
  end
  if input.ParticipationWorkers.MediaWorkers < 1 ||
    input.ParticipationWorkers.MediaWorkers > 32 then
    return Err("participation_workers.media_workers is out of range")
  end
  if input.ParticipationWorkers.ActorWorkers < 1 ||
    input.ParticipationWorkers.ActorWorkers > 32 then
    return Err("participation_workers.actor_workers is out of range")
  end
  if input.ParticipationWorkers.BatchSize < 1 || input.ParticipationWorkers.BatchSize > 1000 then
    return Err("participation_workers.batch_size is out of range")
  end
  if input.ParticipationWorkers.PollIntervalSeconds < 1 ||
    input.ParticipationWorkers.PollIntervalSeconds > 300 then
    return Err("participation_workers.poll_interval_seconds is out of range")
  end
  if input.ParticipationWorkers.LeaseSeconds < 1 ||
    input.ParticipationWorkers.LeaseSeconds > 3600 then
    return Err("participation_workers.lease_seconds is out of range")
  end
  if input.ParticipationWorkers.MaxAttempts < 1 || input.ParticipationWorkers.MaxAttempts > 100 then
    return Err("participation_workers.max_attempts is out of range")
  end
  if input.ParticipationWorkers.RetryBaseSeconds < 1 ||
    input.ParticipationWorkers.RetryBaseSeconds > 3600 then
    return Err("participation_workers.retry_base_seconds is out of range")
  end
  if input.ParticipationWorkers.RetryMaxSeconds < 1 ||
    input.ParticipationWorkers.RetryMaxSeconds > 86400 then
    return Err("participation_workers.retry_max_seconds is out of range")
  end
  if input.Media.MaxImageBytes > input.Media.MaxFileBytes ||
    input.Media.AccountQuotaBytes < input.Media.MaxFileBytes ||
    input.Media.SiteQuotaBytes < input.Media.AccountQuotaBytes ||
    input.Media.PreviewDimension > input.Media.MaxImageDimension then
    return Err("media limits are inconsistent")
  end
  if input.ParticipationWorkers.RetryBaseSeconds > input.ParticipationWorkers.RetryMaxSeconds ||
    input.ParticipationWorkers.LeaseSeconds <= input.SMTP.TimeoutSeconds then
    return Err("worker retry or lease limits are inconsistent")
  end
  if input.Media.Root != "" || input.Media.Enabled then
    if !filepath.IsAbs(input.Media.Root) ||
      filepath.Clean(input.Media.Root) != input.Media.Root ||
      input.Media.Root == "/" ||
      strings.IndexByte(input.Media.Root, 0 as Byte) >= 0 then
      return Err("media root must be a clean absolute non-root path")
    end
  end
  if input.SMTP.TLSMode != "starttls" &&
    input.SMTP.TLSMode != "tls" &&
    input.SMTP.TLSMode != "test" then
    return Err("invalid SMTP TLS mode")
  end
  if input.SMTP.TLSMode == "test" && (input.SMTP.Username != "" || input.SMTP.Password != "") then
    return Err("test SMTP transport cannot carry credentials")
  end
  var enabled = false
  input.Sites.Each(func(site: Site) -> ()
    if site.RegistrationEnabled then
      enabled = true
    end
  end)
  if input.Registration.OutboxSecret != "" || enabled then
    let decoded = base64.StdEncoding.DecodeString(input.Registration.OutboxSecret)
    if decoded.IsErr() then
      return Err("registration requires a base64-encoded 32-byte outbox secret")
    end
    if decoded.Unwrap().Len() != 32 then
      return Err("registration requires a base64-encoded 32-byte outbox secret")
    end
  end
  if enabled then
    if NormalizeAuthority(input.SMTP.Host).IsErr() ||
      strings.Contains(input.SMTP.Host, ":") ||
      mail.ParseAddress(input.SMTP.From).IsErr() then
      return Err("registration requires an SMTP host and valid sender")
    end
    if (input.SMTP.Username == "") != (input.SMTP.Password == "") then
      return Err("SMTP username and password must be supplied together")
    end
  end
  Ok(())
end
