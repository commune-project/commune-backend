func TestParticipationDefaults(t: Ref[testing.T]) -> ()
  let settings = Validate(validInput()).Unwrap()
  if settings.Registration.TokenTTLSeconds != 86400 then
    t.Fatal("Registration.TokenTTLSeconds default changed")
  end
  if settings.Registration.RateWindowSeconds != 3600 then
    t.Fatal("Registration.RateWindowSeconds default changed")
  end
  if settings.Registration.IPLimit != 20 then
    t.Fatal("Registration.IPLimit default changed")
  end
  if settings.Registration.EmailLimit != 3 then
    t.Fatal("Registration.EmailLimit default changed")
  end
  if settings.SMTP.Port != 587 then
    t.Fatal("SMTP.Port default changed")
  end
  if settings.SMTP.TimeoutSeconds != 10 then
    t.Fatal("SMTP.TimeoutSeconds default changed")
  end
  if settings.Media.MaxFileBytes != 26214400 then
    t.Fatal("Media.MaxFileBytes default changed")
  end
  if settings.Media.MaxImageBytes != 10485760 then
    t.Fatal("Media.MaxImageBytes default changed")
  end
  if settings.Media.MaxImagePixels != 20000000 then
    t.Fatal("Media.MaxImagePixels default changed")
  end
  if settings.Media.MaxImageDimension != 16384 then
    t.Fatal("Media.MaxImageDimension default changed")
  end
  if settings.Media.PreviewDimension != 1024 then
    t.Fatal("Media.PreviewDimension default changed")
  end
  if settings.Media.AccountQuotaBytes != 1073741824 then
    t.Fatal("Media.AccountQuotaBytes default changed")
  end
  if settings.Media.SiteQuotaBytes != 10737418240 then
    t.Fatal("Media.SiteQuotaBytes default changed")
  end
  if settings.Media.TemporaryRetentionSeconds != 86400 then
    t.Fatal("Media.TemporaryRetentionSeconds default changed")
  end
  if settings.Media.PrivateCacheRetentionSeconds != 604800 then
    t.Fatal("Media.PrivateCacheRetentionSeconds default changed")
  end
  if settings.Media.CleanupIntervalSeconds != 3600 then
    t.Fatal("Media.CleanupIntervalSeconds default changed")
  end
  if settings.Rendering.MaxSourceBytes != 1048576 then
    t.Fatal("Rendering.MaxSourceBytes default changed")
  end
  if settings.Rendering.MaxDisplayNameLength != 100 then
    t.Fatal("Rendering.MaxDisplayNameLength default changed")
  end
  if settings.Rendering.MaxBiographyLength != 5000 then
    t.Fatal("Rendering.MaxBiographyLength default changed")
  end
  if settings.Rendering.MaxMentions != 20 then
    t.Fatal("Rendering.MaxMentions default changed")
  end
  if settings.Rendering.MaxRemoteDiscoveries != 10 then
    t.Fatal("Rendering.MaxRemoteDiscoveries default changed")
  end
  if settings.Rendering.MentionTimeoutSeconds != 10 then
    t.Fatal("Rendering.MentionTimeoutSeconds default changed")
  end
  if settings.ParticipationWorkers.MailWorkers != 1 then
    t.Fatal("ParticipationWorkers.MailWorkers default changed")
  end
  if settings.ParticipationWorkers.NotificationWorkers != 1 then
    t.Fatal("ParticipationWorkers.NotificationWorkers default changed")
  end
  if settings.ParticipationWorkers.MediaWorkers != 1 then
    t.Fatal("ParticipationWorkers.MediaWorkers default changed")
  end
  if settings.ParticipationWorkers.BatchSize != 100 then
    t.Fatal("ParticipationWorkers.BatchSize default changed")
  end
  if settings.ParticipationWorkers.PollIntervalSeconds != 5 then
    t.Fatal("ParticipationWorkers.PollIntervalSeconds default changed")
  end
  if settings.ParticipationWorkers.LeaseSeconds != 60 then
    t.Fatal("ParticipationWorkers.LeaseSeconds default changed")
  end
  if settings.ParticipationWorkers.MaxAttempts != 8 then
    t.Fatal("ParticipationWorkers.MaxAttempts default changed")
  end
  if settings.ParticipationWorkers.RetryBaseSeconds != 30 then
    t.Fatal("ParticipationWorkers.RetryBaseSeconds default changed")
  end
  if settings.ParticipationWorkers.RetryMaxSeconds != 3600 then
    t.Fatal("ParticipationWorkers.RetryMaxSeconds default changed")
  end
  if settings.Sites.Get(0).Unwrap().RegistrationEnabled || settings.Media.Enabled || settings.ParticipationWorkers.Enabled || settings.SMTP.TLSMode != "starttls" then
    t.Fatal("feature defaults changed")
  end
end

func TestParticipationLoadAndSecretEnvironment(t: Ref[testing.T]) -> ()
  let key: String = "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
  let envName: String = "COMMUNE_CONFIG_TEST_OUTBOX_KEY"
  t.Setenv(envName, key)
  var input = validInput()
  input.Sites = [Site{ID: "a", Origin: "https://a.example", RegistrationEnabled: true}]
  input.Registration.OutboxSecretEnv = envName
  input.Registration.IPLimit = 7
  input.Registration.EmailLimit = 2
  input.SMTP.Host = "smtp.example"
  input.SMTP.From = "noreply@example.com"
  input.SMTP.Username = "mail-user"
  input.SMTP.Password = "mail-password"
  input.SMTP.TLSMode = "tls"
  input.Media.Enabled = true
  input.Media.Root = filepath.Join(t.TempDir(), "media")
  input.Media.PrivateCacheRetentionSeconds = 600
  let path: String = filepath.Join(t.TempDir(), "config.json")
  let content = json.Marshal(input).Unwrap()
  if os.WriteFile(path, content, 0o600 as os.FileMode).IsErr() then
    t.Fatal("cannot write configuration fixture")
  end
  let settings = Load(path).Unwrap()
  if settings.Registration.OutboxSecret != key || settings.Registration.IPLimit != 7 || settings.Registration.EmailLimit != 2 || settings.Media.PrivateCacheRetentionSeconds != 600 || settings.SMTP.TLSMode != "tls" || settings.SMTP.Password != "mail-password" || !settings.Sites.Get(0).Unwrap().RegistrationEnabled then
    t.Fatal("JSON fields, overrides or environment key were lost")
  end
  input.Registration.OutboxSecret = key
  if Validate(input).IsOk() then
    t.Fatal("ambiguous secret sources accepted")
  end
  input.Registration.OutboxSecret = ""
  t.Setenv(envName, "")
  if Validate(input).IsOk() then
    t.Fatal("empty secret environment accepted")
  end
  input.Registration.OutboxSecretEnv = "COMMUNE_CONFIG_TEST_MISSING_KEY"
  t.Setenv("COMMUNE_CONFIG_TEST_MISSING_KEY", "")
  if Validate(input).IsOk() then
    t.Fatal("missing environment secret accepted")
  end
  input.Registration.OutboxSecretEnv = envName
  t.Setenv(envName, "not-a-valid-secret")
  switch Validate(input)
  case Ok(_) => t.Fatal("invalid environment key accepted")
  case Err(message) =>
    if strings.Contains(message, "not-a-valid-secret") || strings.Contains(message, envName) then
      t.Fatal("environment secret error leaked input")
    end
  end
end

