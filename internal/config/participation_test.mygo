func TestParticipationEnabledValidation(t: Ref[testing.T]) -> ()
  let cases = ["relative", "root", "traversal", "nul", "missing root", "missing secret", "short secret", "bad secret", "missing smtp", "bad sender", "test credentials", "bad tls", "quota", "image", "lease", "retry"]
  cases.Each(func(name: String) -> ()
    t.Run(name, func(t: Ref[testing.T]) -> ()
      var input = validInput()
      switch name
      case "relative" => input.Media.Root = "media"
      case "root" => input.Media.Root = "/"
      case "traversal" => input.Media.Root = "/tmp/../media"
      case "nul" =>
        let nul: Slice[Byte] = [0 as Byte]
        input.Media.Root = "/tmp/" + (nul as String)
      case "missing root" => input.Media.Enabled = true
      case "missing secret" => input.Sites = [Site{ID: "a", Origin: "https://a.example", RegistrationEnabled: true}]
      case "short secret" => input.Registration.OutboxSecret = "c2VjcmV0"
      case "bad secret" => input.Registration.OutboxSecret = "secret"
      case "missing smtp" =>
        input.Sites = [Site{ID: "a", Origin: "https://a.example", RegistrationEnabled: true}]
        input.Registration.OutboxSecret = "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
      case "bad sender" =>
        input.Sites = [Site{ID: "a", Origin: "https://a.example", RegistrationEnabled: true}]
        input.Registration.OutboxSecret = "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
        input.SMTP.Host = "smtp.example"
        input.SMTP.From = "secret"
      case "test credentials" =>
        input.SMTP.TLSMode = "test"
        input.SMTP.Password = "secret"
      case "bad tls" => input.SMTP.TLSMode = "none"
      case "quota" => input.Media.AccountQuotaBytes = 1024
      case "image" => input.Media.MaxImageBytes = 1073741824
      case "lease" => input.ParticipationWorkers.LeaseSeconds = 1
      case "retry" => input.ParticipationWorkers.RetryMaxSeconds = 1
      case _ => ()
      end
      switch Validate(input)
      case Ok(_) => t.Fatal("invalid participation settings accepted")
      case Err(message) =>
        if strings.Contains(message, "MDEy") || strings.Contains(message, "c2Vj") then
          t.Fatal("configuration error leaked key")
        end
      end
    end)
    ()
  end)
  var input = validInput()
  input.Sites = [Site{ID: "a", Origin: "https://a.example", RegistrationEnabled: true}]
  input.Registration.OutboxSecret = "MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
  input.SMTP.Host = "smtp.example"
  input.SMTP.From = "Commune <noreply@example.com>"
  input.Media.Enabled = true
  input.Media.Root = "/var/lib/commune/media"
  input.ParticipationWorkers.Enabled = true
  let settings = Validate(input).Unwrap()
  if !settings.Sites.Get(0).Unwrap().RegistrationEnabled || settings.Media.Root != input.Media.Root then
    t.Fatal("enabled feature settings lost")
  end
end
