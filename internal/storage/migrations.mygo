package storage

import sql "go:database/sql"
import context "go:context"

let ledgerSQL = """
CREATE TABLE IF NOT EXISTS public.commune_schema_migrations (
    version integer PRIMARY KEY CHECK (version > 0),
    name text NOT NULL UNIQUE,
    checksum text NOT NULL CHECK (checksum ~ '^[a-f0-9]{64}$'),
    applied_at timestamptz NOT NULL DEFAULT now()
)
"""

func ReadAppliedRows(rows: Ref[sql.Rows]) -> Result[Slice[AppliedMigration], String]
  var applied: Slice[AppliedMigration] = []
  while rows.Next()
    let version = 0
    let name = ""
    let checksum = ""
    let scan = rows.Scan(Ref.new(version), Ref.new(name), Ref.new(checksum))
    if scan.IsErr() then
      let _ = rows.Close()
      return Err("cannot read migration history")
    end
    applied = applied.Append(AppliedMigration { Version: version, Name: name, Checksum: checksum })
  end
  let rowError = rows.Err()
  let closeError = rows.Close()
  if rowError.IsErr() || closeError.IsErr() then
    return Err("cannot finish reading migration history")
  end
  Ok(applied)
end

# This path performs no DDL, migration, provisioning, or demo seeding.
func CheckSchema(ctx: context.Context, db: Ref[sql.DB]) -> Result[(), String]
  let catalogResult = MigrationCatalog()
  if catalogResult.IsErr() then
    return Err(catalogResult.UnwrapErr())
  end
  let exists = false
  let lookup = db.QueryRowContext(ctx, "SELECT to_regclass('public.commune_schema_migrations') IS NOT NULL").Scan(Ref.new(exists))
  if lookup.IsErr() then
    return Err("cannot check database schema")
  end
  if !exists then
    return Err("database schema is absent; run explicit migration")
  end
  let query = db.QueryContext(ctx, "SELECT version, name, checksum FROM public.commune_schema_migrations ORDER BY version")
  if query.IsErr() then
    return Err("cannot query migration history")
  end
  let applied = ReadAppliedRows(query.Unwrap())
  if applied.IsErr() then
    return Err(applied.UnwrapErr())
  end
  ValidateApplied(applied.Unwrap(), catalogResult.Unwrap(), true)
end

func ApplyTransaction(ctx: context.Context, tx: Ref[sql.Tx], catalog: Slice[Migration]) -> Result[(), String]
  # Shared across binaries: concurrent operators serialize before reading history.
  let lock = tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(1129270605)")
  if lock.IsErr() then
    return Err("cannot acquire migration lock")
  end
  let path = tx.ExecContext(ctx, "SET LOCAL search_path = public, pg_catalog")
  if path.IsErr() then
    return Err("cannot set migration schema path")
  end
  let ledger = tx.ExecContext(ctx, ledgerSQL)
  if ledger.IsErr() then
    return Err("cannot initialize migration ledger")
  end
  let query = tx.QueryContext(ctx, "SELECT version, name, checksum FROM public.commune_schema_migrations ORDER BY version")
  if query.IsErr() then
    return Err("cannot query migration history")
  end
  let read = ReadAppliedRows(query.Unwrap())
  if read.IsErr() then
    return Err(read.UnwrapErr())
  end
  let applied = read.Unwrap()
  let compatible = ValidateApplied(applied, catalog, false)
  if compatible.IsErr() then
    return Err(compatible.UnwrapErr())
  end
  var i = applied.Len()
  while i < catalog.Len()
    let migration = catalog.Get(i).Unwrap()
    let execute = tx.ExecContext(ctx, migration.SQL)
    if execute.IsErr() then
      return Err("migration failed: " + migration.Name)
    end
    let record = tx.ExecContext(ctx, "INSERT INTO public.commune_schema_migrations (version, name, checksum) VALUES ($1, $2, $3)", migration.Version, migration.Name, migration.Checksum)
    if record.IsErr() then
      return Err("cannot record migration: " + migration.Name)
    end
    i = i + 1
  end
  Ok(())
end

func Migrate(ctx: context.Context, db: Ref[sql.DB]) -> Result[(), String]
  let catalog = MigrationCatalog()
  if catalog.IsErr() then
    return Err(catalog.UnwrapErr())
  end
  let options = sql.TxOptions {}
  let begin = db.BeginTx(ctx, Ref.new(options))
  if begin.IsErr() then
    return Err("cannot begin migration transaction")
  end
  let tx = begin.Unwrap()
  let apply = ApplyTransaction(ctx, tx, catalog.Unwrap())
  if apply.IsErr() then
    let _ = tx.Rollback()
    return Err(apply.UnwrapErr())
  end
  let commit = tx.Commit()
  if commit.IsErr() then
    return Err("cannot commit migration transaction; inspect history before retrying")
  end
  Ok(())
end
