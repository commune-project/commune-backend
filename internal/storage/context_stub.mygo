package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import sql "go:database/sql"
import rand "go:crypto/rand"
import failure "github.com/commune-project/commune-backend/internal/failure"
# A remote context is recorded as an unresolved stub: the declaration is kept
# even when the authority cannot be resolved, and resolution never rejects the
# containing post.
func EnsureContextStub(
  ctx: context.Context,
  db: Ref[gorm.DB],
  contextURI: String
) -> Result[String, failure.Failure]
  let existing = ""
  let lookup = db.WithContext(ctx).Raw(
    "SELECT id FROM discussion_contexts WHERE context_uri = ?",
    contextURI
  ).Scan(Ref.new(existing))
  if MutationResult(lookup).IsErr() then
    return Err(Of("context unavailable"))
  end
  if lookup.RowsAffected == 1i64 then
    return Ok(existing)
  end
  let id = rand.Text()
  let inserted = db.WithContext(ctx).Exec(
    "INSERT INTO discussion_contexts(id,context_uri,resolution_state) VALUES (?,?,'unresolved') ON CONFLICT (context_uri) DO NOTHING",
    id,
    sql.NullString{
      String: contextURI,
      Valid: true,
    }
  )
  if MutationResult(inserted).IsErr() then
    return Err(Of("context creation failed"))
  end
  let resolved = ""
  let query = db.WithContext(ctx).Raw(
    "SELECT id FROM discussion_contexts WHERE context_uri = ?",
    contextURI
  ).Scan(Ref.new(resolved))
  return Required(query, resolved, "context creation failed")
end

# Deduplicates recipients before expansion so a context authority that is also a
# follower does not receive the same activity twice.
func UniqueRecipients(recipients: Slice[String]) -> Slice[String]
  recipients.Fold(
    [],
    func(acc: Slice[String], item: String) -> Slice[String]
      if item == "" || acc.Contains(item) then
        acc
      else
        acc.Append(item)
      end
    end
  )
end

func PostContextURIs(
  ctx: context.Context,
  db: Ref[gorm.DB],
  postID: String
) -> Result[Slice[String], failure.Failure]
  var uris: Slice[String] = []
  let query = db.WithContext(ctx).Raw(
    "SELECT coalesce(dc.context_uri,'') AS uri FROM post_contexts pc JOIN discussion_contexts dc ON dc.id = pc.context_id WHERE pc.post_id = ? AND dc.context_uri IS NOT NULL ORDER BY dc.id",
    postID
  ).Scan(Ref.new(uris))
  switch MutationResult(query)
    case Err(_) => Err(Of("context unavailable"))
    case Ok(_) => Ok(uris)
  end
end

func PrimaryPostContextURI(ctx: context.Context, db: Ref[gorm.DB], postID: String) -> String
  switch PostContextURIs(ctx, db, postID)
    case Err(_) => ""
    case Ok(uris) if uris.Len() == 0 => ""
    case Ok(uris) => uris.Get(0).Unwrap()
  end
end
