package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import rand "go:crypto/rand"
import sql "go:database/sql"
import regexp "go:regexp"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import auth "github.com/commune-project/commune-backend/internal/auth"

impl CommunityRepository
  func Create(self: CommunityRepository, ctx: context.Context, site: config.Site, identity: auth.Identity, name: String, title: String, mode: String, read: String, post: String) -> Result[CommunityRecord, String]
    let policy = auth.CommunityPolicy{HostSiteID: self.SiteID, FederationMode: mode, ReadPolicy: read, PostPolicy: post}
    if site.ID != self.SiteID || !identity.BelongsTo(self.SiteID) || !policy.Valid() || !regexp.MatchString("^[a-z0-9_][a-z0-9_-]{0,63}$", name).UnwrapOr(false) || strings.TrimSpace(title) == "" || (title as Slice[Byte]).Len() > 200 then
      return Err("invalid community input")
    end
    let canonical = config.CanonicalURI(site, "communities", name)
    if canonical.IsErr() then
      return Err("invalid community input")
    end
    let record = CommunityRecord{ID: rand.Text(), HostSiteID: site.ID, ActorURI: sql.NullString{String: if mode == "federated" then canonical.Unwrap() else "" end, Valid: mode == "federated"}, CreatorActorURI: identity.ActorURI, FederationMode: mode, ReadPolicy: read, PostPolicy: post, Name: name, Title: title, PolicyVersion: 1i64}
    let result = RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let active = QueryExists(tx.Table("accounts AS a").Joins("JOIN sites AS s ON s.id=a.site_id").Where("a.id=? AND a.site_id=? AND a.actor_uri=? AND NOT a.disabled AND s.canonical_origin=?", identity.AccountID, self.SiteID, identity.ActorURI, site.Origin))
      if active.IsErr() then
        return Err(active.UnwrapErr())
      end
      if !active.Unwrap() then
        return Err("forbidden")
      end
      let repository = SiteRepository{DB: tx, SiteID: self.SiteID}
      let blocked = repository.IsBlocked(ctx, identity.ActorURI)
      if blocked.IsErr() then
        return Err(blocked.UnwrapErr())
      end
      if blocked.Unwrap() then
        return Err("forbidden")
      end
      if mode == "federated" then
        if MutationResult(tx.Exec("INSERT INTO actors(uri,local_site_id,kind,inbox_uri) VALUES (?,?,'Group',?)", canonical.Unwrap(), self.SiteID, canonical.Unwrap() + "/inbox")).IsErr() then
          return Err("community creation failed")
        end
      end
      if MutationResult(tx.Table("communities").Create(Ref.new(record))).IsErr() then
        return Err("community creation failed")
      end
      if MutationResult(tx.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?)", record.ID, identity.ActorURI, identity.ActorURI)).IsErr() then
        return Err("community creation failed")
      end
      MutationResult(tx.Exec("INSERT INTO audit_events(acting_actor_uri,scope_kind,scope_id,action,target_id) VALUES (?,'community',?,'create-community',?)", identity.ActorURI, record.ID, record.ID))
    end)
    if result.IsErr() then
      return Err(result.UnwrapErr())
    end
    Ok(record)
  end
end
