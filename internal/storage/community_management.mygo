package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import auth "github.com/commune-project/commune-backend/internal/auth"

impl CommunityRepository
  func Manage(self: CommunityRepository, ctx: context.Context, id: String, identity: auth.Identity, remoteVerified: Bool, action: String, target: String, work: func(Ref[gorm.DB], CommunityRecord) -> Result[(), String]) -> Result[(), String]
    RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let repository = CommunityRepository{DB: tx, SiteID: self.SiteID}
      let loaded = repository.Load(ctx, id, true)
      if loaded.IsErr() then
        return Err(loaded.UnwrapErr())
      end
      let access = repository.Access(ctx, loaded.Unwrap(), identity, remoteVerified)
      if access.IsErr() then
        return Err(access.UnwrapErr())
      end
      if !access.Unwrap().Authority.Allows("manage-community") then
        return Err("forbidden")
      end
      let changed = work(tx, loaded.Unwrap())
      if changed.IsErr() then
        return Err(changed.UnwrapErr())
      end
      repository.Audit(ctx, access.Unwrap(), action, target)
    end)
  end

  func SetMember(self: CommunityRepository, ctx: context.Context, id: String, identity: auth.Identity, remoteVerified: Bool, actorURI: String, approved: Bool) -> Result[(), String]
    let action = if approved then "approve-member" else "revoke-member" end
    self.Manage(ctx, id, identity, remoteVerified, action, actorURI, func(tx: Ref[gorm.DB], community: CommunityRecord) -> Result[(), String]
      let valid = QueryExists(tx.Table("actors AS a").Where("a.uri = ? AND a.kind = 'Person' AND (? = 'federated' OR EXISTS (SELECT 1 FROM accounts WHERE actor_uri = a.uri AND site_id = ? AND NOT disabled))", actorURI, community.FederationMode, community.HostSiteID))
      if valid.IsErr() then
        return Err(valid.UnwrapErr())
      end
      if !valid.Unwrap() then
        return Err("invalid member")
      end
      let query = if approved then
        tx.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?) ON CONFLICT (community_id,actor_uri) DO UPDATE SET approved_by=EXCLUDED.approved_by,approved_at=now(),revoked_at=NULL", id, actorURI, identity.ActorURI)
      else
        tx.Exec("UPDATE community_members SET revoked_at=now() WHERE community_id=? AND actor_uri=? AND revoked_at IS NULL", id, actorURI)
      end
      MutationResult(query)
    end)
  end

  func SetManager(self: CommunityRepository, ctx: context.Context, id: String, identity: auth.Identity, remoteVerified: Bool, actorURI: String, assigned: Bool) -> Result[(), String]
    let action = if assigned then "assign-manager" else "revoke-manager" end
    self.Manage(ctx, id, identity, remoteVerified, action, actorURI, func(tx: Ref[gorm.DB], community: CommunityRecord) -> Result[(), String]
      let valid = QueryExists(tx.Table("actors AS a").Where("a.uri = ? AND a.kind = 'Person' AND (? = 'federated' OR EXISTS (SELECT 1 FROM accounts WHERE actor_uri=a.uri AND site_id=? AND NOT disabled))", actorURI, community.FederationMode, community.HostSiteID))
      if valid.IsErr() then
        return Err(valid.UnwrapErr())
      end
      if !valid.Unwrap() then
        return Err("invalid manager")
      end
      let query = if assigned then
        tx.Exec("INSERT INTO moderators(community_id,actor_uri,assigned_by) VALUES (?,?,?) ON CONFLICT (community_id,actor_uri) DO UPDATE SET assigned_by=EXCLUDED.assigned_by,assigned_at=now(),revoked_at=NULL", id, actorURI, identity.ActorURI)
      else
        tx.Exec("UPDATE moderators SET revoked_at=now() WHERE community_id=? AND actor_uri=? AND revoked_at IS NULL", id, actorURI)
      end
      MutationResult(query)
    end)
  end

  func SetPolicy(self: CommunityRepository, ctx: context.Context, id: String, identity: auth.Identity, remoteVerified: Bool, read: String, post: String) -> Result[(), String]
    self.Manage(ctx, id, identity, remoteVerified, "set-policy", id, func(tx: Ref[gorm.DB], community: CommunityRecord) -> Result[(), String]
      let policy = auth.CommunityPolicy{HostSiteID: community.HostSiteID, FederationMode: community.FederationMode, ReadPolicy: read, PostPolicy: post}
      if !policy.Valid() then
        return Err("invalid access policy")
      end
      MutationResult(tx.Exec("UPDATE communities SET read_policy=?,post_policy=?,policy_version=policy_version+1 WHERE id=? AND host_site_id=?", read, post, id, self.SiteID))
    end)
  end

  func SetPolicyAll(self: CommunityRepository, ctx: context.Context, id: String, identity: auth.Identity, remoteVerified: Bool, read: String, post: String, follow: String) -> Result[(), String]
    self.Manage(ctx, id, identity, remoteVerified, "set-policy", id, func(tx: Ref[gorm.DB], community: CommunityRecord) -> Result[(), String]
      let policy = auth.CommunityPolicy{HostSiteID: community.HostSiteID, FederationMode: community.FederationMode, ReadPolicy: read, PostPolicy: post}
      let currentFollow = LoadCommunityFollowRule(ctx, tx, id)
      if currentFollow.IsErr() then
        return Err(currentFollow.UnwrapErr())
      end
      let followPolicy = if follow == "" then currentFollow.Unwrap() else follow end
      if !policy.Valid() || (followPolicy != "open" && followPolicy != "members" && followPolicy != "approval" && followPolicy != "disabled") then
        return Err("invalid access policy")
      end
      if MutationResult(tx.Exec("UPDATE communities SET read_policy=?,post_policy=?,policy_version=policy_version+1 WHERE id=? AND host_site_id=?", read, post, id, self.SiteID)).IsErr() then
        return Err("policy update failed")
      end
      SetCommunityFollowRule(ctx, tx, id, followPolicy)
    end)
  end
end
