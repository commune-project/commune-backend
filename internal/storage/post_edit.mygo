package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import sql "go:database/sql"
import strings "go:strings"
import time "go:time"
import auth "github.com/commune-project/commune-backend/internal/auth"
import content "github.com/commune-project/commune-backend/internal/content"

impl PostRepository
  func Edit(
    self: PostRepository,
    ctx: context.Context,
    id: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    title: String,
    body: String
  ) -> Result[PostRecord, String]
    self.EditResolvedContent(ctx, id, identity, remoteVerified, title, body, "", [] as Slice[String], [] as Slice[ResolvedPostMention], false)
  end

  func EditContent(
    self: PostRepository,
    ctx: context.Context,
    id: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    title: String,
    body: String,
    contentFormat: String,
    attachmentIDs: Slice[String]
  ) -> Result[PostRecord, String]
    self.EditResolvedContent(ctx, id, identity, remoteVerified, title, body, contentFormat, attachmentIDs, [] as Slice[ResolvedPostMention], true)
  end

  func EditResolvedContent(
    self: PostRepository,
    ctx: context.Context,
    id: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    title: String,
    body: String,
    contentFormat: String,
    attachmentIDs: Slice[String],
    mentions: Slice[ResolvedPostMention],
    replaceAttachments: Bool
  ) -> Result[PostRecord, String]
    let trimmed = strings.TrimSpace(body)
    let cleanTitle = strings.TrimSpace(title)
    if trimmed == "" ||
      (trimmed as Slice[Byte]).Len() > 65536 ||
      (cleanTitle as Slice[Byte]).Len() > 200 then
      return Err("invalid post input")
    end
    self.MutateAuthor(
      ctx,
      id,
      identity,
      remoteVerified,
      func(tx: Ref[gorm.DB], post: PostRecord) -> Result[(), String]
        if post.DeletedAt.Valid then
          return Err("not found")
        end
        let format = if contentFormat == "" then if post.ContentFormat == "" then "legacy" else post.ContentFormat end else contentFormat end
        if format != "legacy" && format != "markdown" then
          return Err("invalid content format")
        end
        if post.Title.Valid && cleanTitle == "" || !post.Title.Valid && cleanTitle != "" then
          return Err("invalid post input")
        end
        let plain = content.PlainRichText(trimmed, format)
        if plain.IsErr() then
          return Err("invalid post input")
        end
        let updated = MutationResult(tx.Exec(
          "UPDATE posts SET title=?,body=?,content_format=?,search_text=?,updated_at=? WHERE id=? AND deleted_at IS NULL",
          sql.NullString {
            String: cleanTitle,
            Valid: cleanTitle != "",
          },
          trimmed,
          format,
          cleanTitle + " " + plain.Unwrap(),
          time.Now().UTC().Truncate(time.Microsecond),
          id
        ))
        if updated.IsErr() then
          return updated
        end
        var changed = post
        changed.Body = trimmed
        changed.ContentFormat = format
        var ids = attachmentIDs
        if !replaceAttachments then
          let states = LoadPostRichStates(ctx, tx, [post.ID])
          if states.IsErr() || states.Unwrap().Len() != 1 then
            return Err("post content unavailable")
          end
          let media = PostRichMedia(states.Unwrap().Get(0).Unwrap())
          if media.IsErr() then
            return Err(media.UnwrapErr())
          end
          ids = media.Unwrap().Map(func(item: content.RichMedia) -> String item.UploadID end)
        end
        let retained = RetainPostMentionsTx(ctx, tx, post, trimmed, format, mentions)
        if retained.IsErr() then
          return Err(retained.UnwrapErr())
        end
        ValidatePostContentTx(ctx, tx, self.SiteID, identity, changed, ids, retained.Unwrap())
      end
    )
  end
  func Delete(
    self: PostRepository,
    ctx: context.Context,
    id: String,
    identity: auth.Identity,
    remoteVerified: Bool
  ) -> Result[(), String]
    self.MutateAuthor(
      ctx,
      id,
      identity,
      remoteVerified,
      func(tx: Ref[gorm.DB], post: PostRecord) -> Result[(), String]
        if post.DeletedAt.Valid then
          return Ok(())
        end
        if MutationResult(tx.Exec("UPDATE media_bindings SET active=false WHERE post_id=? AND active", id)).IsErr() || MutationResult(tx.Exec("UPDATE post_mentions SET active=false WHERE post_id=? AND active", id)).IsErr() then
          return Err("post content unavailable")
        end
        MutationResult(tx.Exec(
          "UPDATE posts SET body='',search_text='',deleted_at=?,updated_at=? WHERE id=?",
          time.Now().UTC().Truncate(time.Microsecond),
          time.Now().UTC().Truncate(time.Microsecond),
          id
        ))
      end
    )
  end
  func MutateAuthor(
    self: PostRepository,
    ctx: context.Context,
    id: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    work: func(Ref[gorm.DB], PostRecord) -> Result[(), String]
  ) -> Result[PostRecord, String]
    var stored = PostRecord{}
    let result = RunTransaction(
      ctx,
      self.DB,
      func(tx: Ref[gorm.DB]) -> Result[(), String]
        let loaded = loadPostForUpdate(tx, id)
        if loaded.IsErr() then
          return Err(loaded.UnwrapErr())
        end
        let post = loaded.Unwrap()
        let received = QueryExists(tx.WithContext(ctx).Table("site_posts").Where(
          "site_id=? AND post_id=? AND hidden_at IS NULL",
          self.SiteID,
          id
        ))
        if received.IsErr() then
          return Err(received.UnwrapErr())
        end
        if !received.Unwrap() then
          return Err("not found")
        end
        let community = CommunityRepository { DB: tx, SiteID: self.SiteID }
        let access = community.CheckAuthorship(ctx, post.CommunityID, identity, remoteVerified)
        if access.IsErr() then
          return Err(access.UnwrapErr())
        end
        if !access.Unwrap().CanEditBody(post.AuthorActorURI) then
          return Err("forbidden")
        end
        let changed = work(tx, post)
        if changed.IsErr() then
          return Err(changed.UnwrapErr())
        end
        if MutationResult(tx.Table("posts").Where("id=?", id).Find(Ref.new(stored))).IsErr() then
          return Err("post update failed")
        end
        Ok(())
      end
    )
    if result.IsErr() then
      return Err(result.UnwrapErr())
    end
    Ok(stored)
  end
end

func loadPostForUpdate(tx: Ref[gorm.DB], id: String) -> Result[PostRecord, String]
  let record = PostRecord{}
  let found = tx.Raw("SELECT * FROM posts WHERE id=? FOR UPDATE", id).Scan(Ref.new(record))
  if MutationResult(found).IsErr() then
    return Err("post unavailable")
  end
  if found.RowsAffected != 1i64 then
    return Err("not found")
  end
  Ok(record)
end
