package storage

import testing "go:testing"
import context "go:context"
import config "github.com/commune-project/commune-backend/internal/config"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func TestPostgresSiteVoteSettingsIsolationAndAudit(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = MigrateGORM(ctx, db).Unwrap()
  let a = testSite("a", "https://a.example")
  let b = testSite("b", "https://b.example")
  let _ = ProvisionSite(ctx, db, a).Unwrap()
  let _ = ProvisionSite(ctx, db, b).Unwrap()
  let _ = ProvisionAdministrator(ctx, db, a, "admin-a", "admin-a-password", false).Unwrap()
  let admin = FindAccount(ctx, db, a.ID, "admin-a").Unwrap().Unwrap().Identity()
  let ordinary = AccountRepository{DB: db}.Create(ctx, a, "ordinary", "", "ordinary-password").Unwrap()
  if !SiteVoteUpEnabled(ctx, db, a.ID) || !SiteVoteDownEnabled(ctx, db, a.ID) then
    t.Fatal("site vote settings did not default enabled")
  end
  let updated = UpdateSiteVoteSettings(ctx, db, a.ID, admin, false, false, false, true)
  if updated.IsErr() || !SiteVoteUpEnabled(ctx, db, a.ID) || SiteVoteDownEnabled(ctx, db, a.ID) then
    t.Fatal("partial downvote update failed")
  end
  if !SiteVoteUpEnabled(ctx, db, b.ID) || !SiteVoteDownEnabled(ctx, db, b.ID) then
    t.Fatal("site A vote settings leaked into site B")
  end
  if UpdateSiteVoteSettings(ctx, db, a.ID, admin, false, true, true, false).IsErr() ||
    SiteVoteUpEnabled(ctx, db, a.ID) ||
    SiteVoteDownEnabled(ctx, db, a.ID) then
    t.Fatal("second partial update did not preserve the existing direction")
  end
  if UpdateSiteVoteSettings(ctx, db, a.ID, ordinary, true, true, true, true).IsOk() then
    t.Fatal("ordinary account changed site vote settings")
  end
  let audits = 0i64
  if MutationResult(db.Table("audit_events").Where(
    "scope_kind='site' AND scope_id=? AND action='set-vote-settings'",
    a.ID
  ).Count(Ref.new(audits))).IsErr() ||
    audits != 2i64 then
    t.Fatal("vote setting updates were not audited exactly once")
  end
end
