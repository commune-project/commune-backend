package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import time "go:time"
import strings "go:strings"
import rand "go:crypto/rand"
import mail "go:net/mail"
import config "github.com/commune-project/commune-backend/internal/config"
import auth "github.com/commune-project/commune-backend/internal/auth"

struct PasswordResetRepository
  DB: Ref[gorm.DB]
  Site: config.Site
  EncryptionKey: Slice[Byte]
  IPAttempts: Int
  EmailAttempts: Int
  TokenTTLSeconds: Int
  RateWindowSeconds: Int
end

struct ResetTokenRecord
  ID: String `gorm:"column:id"`
  SiteID: String `gorm:"column:site_id"`
  AccountID: Int64 `gorm:"column:account_id"`
  TokenHash: Slice[Byte] `gorm:"column:token_hash"`
  ExpiresAt: time.Time `gorm:"column:expires_at"`
end

struct ResetMailJob
  ID: String `gorm:"column:id"`
  ResetID: String `gorm:"column:reset_id"`
  EncryptedPayload: Slice[Byte] `gorm:"column:encrypted_payload"`
  Attempts: Int `gorm:"column:attempts"`
  Email: String `gorm:"column:email"`
end

func ResetEmail(email: String) -> Result[String, String]
  let address = strings.ToLower(strings.TrimSpace(email))
  let parsed = mail.ParseAddress(address)
  if address == "" || (address as Slice[Byte]).Len() > 254 || parsed.IsErr() || parsed.Unwrap().Address != address then
    return Err("invalid reset request")
  end
  Ok(address)
end

func PasswordResetHash(token: String) -> Slice[Byte]
  auth.TokenHash(token)
end

impl PasswordResetRepository
  func Charge(self: PasswordResetRepository, ctx: context.Context, ip: String, email: String, now: time.Time) -> Result[(), String]
    let start = now.Truncate(self.RateWindowSeconds as time.Duration * time.Second)
    let dimensions: Slice[String] = ["ip", "email"]
    let subjects: Slice[String] = [ip, email]
    let limits: Slice[Int] = [self.IPAttempts, self.EmailAttempts]
    var index: Int = 0
    while index < 2
      let count = 0
      let query = self.DB.WithContext(ctx).Raw("INSERT INTO password_reset_rate_limits(site_id,dimension,subject_hash,window_start,attempts) VALUES (?,?,?,?,1) ON CONFLICT(site_id,dimension,subject_hash,window_start) DO UPDATE SET attempts=password_reset_rate_limits.attempts+1 RETURNING attempts", self.Site.ID, dimensions.Get(index).Unwrap(), auth.TokenHash(subjects.Get(index).Unwrap()), start).Scan(Ref.new(count))
      if QueryFailed(query) then
        return Err("reset unavailable")
      end
      if count > limits.Get(index).Unwrap() then
        return Err("reset rate limited")
      end
      index = index + 1
    end
    Ok(())
  end

  func Request(self: PasswordResetRepository, ctx: context.Context, email: String, ip: String, now: time.Time) -> Result[(), String]
    let normalized = ResetEmail(email)
    if normalized.IsErr() then
      return Err(normalized.UnwrapErr())
    end
    let charged = self.Charge(ctx, ip, normalized.Unwrap(), now)
    if charged.IsErr() then
      return charged
    end
    RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let account = AccountRecord{}
      let found = tx.WithContext(ctx).Table("accounts").Where("site_id=? AND email=? AND NOT disabled", self.Site.ID, normalized.Unwrap()).Limit(1).Find(Ref.new(account))
      if MutationResult(found).IsErr() then
        return Err("reset unavailable")
      end
      if found.RowsAffected != 1i64 then
        return Ok(())
      end
      if MutationResult(tx.Exec("UPDATE password_reset_tokens SET consumed_at=? WHERE site_id=? AND account_id=? AND consumed_at IS NULL", now, self.Site.ID, account.ID)).IsErr() then
        return Err("reset unavailable")
      end
      let token = rand.Text()
      let tokenID = rand.Text()
      let expires = now.Add(self.TokenTTLSeconds as time.Duration * time.Second)
      if MutationResult(tx.Exec("INSERT INTO password_reset_tokens(id,site_id,account_id,token_hash,created_at,expires_at) VALUES (?,?,?,?,?,?)", tokenID, self.Site.ID, account.ID, auth.TokenHash(token), now, expires)).IsErr() then
        return Err("reset unavailable")
      end
      let link = self.Site.Origin + "/reset-password#token=" + token
      let sealed = auth.SealPasswordReset(self.EncryptionKey, link)
      if sealed.IsErr() then
        return Err("reset unavailable")
      end
      if MutationResult(tx.Exec("INSERT INTO password_reset_mail_jobs(id,reset_id,encrypted_payload,available_at) VALUES (?,?,?,?)", rand.Text(), tokenID, sealed.Unwrap(), now)).IsErr() then
        return Err("reset unavailable")
      end
      Ok(())
    end)
  end

  func Confirm(self: PasswordResetRepository, ctx: context.Context, token: String, password: String, now: time.Time) -> Result[(), String]
    if !auth.ValidToken(token) then
      return Err("invalid reset token")
    end
    let hash = auth.HashPassword(password)
    if hash.IsErr() then
      return Err("invalid reset password")
    end
    RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let record = ResetTokenRecord{}
      let query = tx.Raw("SELECT * FROM password_reset_tokens WHERE site_id=? AND token_hash=? AND expires_at>? AND consumed_at IS NULL FOR UPDATE", self.Site.ID, auth.TokenHash(token), now).Scan(Ref.new(record))
      if MutationResult(query).IsErr() then
        return Err("reset unavailable")
      end
      if query.RowsAffected != 1i64 then
        return Err("invalid reset token")
      end
      if MutationResult(tx.Exec("UPDATE accounts SET password_hash=? WHERE site_id=? AND id=? AND NOT disabled", hash.Unwrap(), self.Site.ID, record.AccountID)).IsErr() then
        return Err("reset unavailable")
      end
      if MutationResult(tx.Exec("UPDATE password_reset_tokens SET consumed_at=? WHERE id=?", now, record.ID)).IsErr() then
        return Err("reset unavailable")
      end
      if MutationResult(tx.Exec("UPDATE password_reset_mail_jobs SET state='failed',encrypted_payload=''::bytea,lease_token=NULL,lease_until=NULL WHERE reset_id=? AND state IN ('pending','leased')", record.ID)).IsErr() then
        return Err("reset unavailable")
      end
      MutationResult(tx.Exec("UPDATE sessions SET revoked_at=? WHERE site_id=? AND account_id=? AND revoked_at IS NULL", now, self.Site.ID, record.AccountID))
    end)
  end

  func Change(self: PasswordResetRepository, ctx: context.Context, identity: auth.Identity, current: String, password: String) -> Result[(), String]
    let hash = auth.HashPassword(password)
    if hash.IsErr() then
      return Err("invalid reset password")
    end
    RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let account = AccountRecord{}
      let query = tx.WithContext(ctx).Table("accounts").Where("site_id=? AND id=? AND actor_uri=? AND NOT disabled", self.Site.ID, identity.AccountID, identity.ActorURI).Limit(1).Find(Ref.new(account))
      if MutationResult(query).IsErr() then
        return Err("reset unavailable")
      end
      if query.RowsAffected != 1i64 || !auth.VerifyPassword(account.PasswordHash, current) then
        return Err("invalid current password")
      end
      MutationResult(tx.Exec("UPDATE accounts SET password_hash=? WHERE site_id=? AND id=?", hash.Unwrap(), self.Site.ID, identity.AccountID))
    end)
  end
end

func DeliverPasswordResetMail(
  ctx: context.Context,
  db: Ref[gorm.DB],
  key: Slice[Byte],
  now: time.Time,
  batch: Int,
  leaseSeconds: Int,
  maxAttempts: Int,
  retrySeconds: Int,
  retryMaxSeconds: Int,
  send: func(String, String) -> Result[(), String]
) -> Result[Int, String]
  if batch < 1 || batch > 1000 || leaseSeconds < 1 || maxAttempts < 1 || retrySeconds < 1 || retryMaxSeconds < retrySeconds then
    return Err("invalid reset mail limits")
  end
  let lease = rand.Text()
  let jobs: Slice[ResetMailJob] = []
  let query = db.WithContext(ctx).Raw(
    "WITH ready AS (SELECT j.id FROM password_reset_mail_jobs j JOIN password_reset_tokens t ON t.id=j.reset_id WHERE t.expires_at>? AND t.consumed_at IS NULL AND j.available_at<=? AND j.attempts<? AND (j.state='pending' OR (j.state='leased' AND j.lease_until<=?)) ORDER BY j.available_at,j.id FOR UPDATE OF j SKIP LOCKED LIMIT ?), claimed AS (UPDATE password_reset_mail_jobs j SET state='leased',lease_token=?,lease_until=?,attempts=attempts+1 FROM ready WHERE j.id=ready.id RETURNING j.*) SELECT c.*,a.email FROM claimed c JOIN password_reset_tokens t ON t.id=c.reset_id JOIN accounts a ON a.site_id=t.site_id AND a.id=t.account_id",
    now, now, maxAttempts, now, batch, lease, now.Add(leaseSeconds as time.Duration * time.Second)
  ).Scan(Ref.new(jobs))
  if QueryFailed(query) then
    return Err("reset mail unavailable")
  end
  var delivered: Int = 0
  var failed: Bool = false
  jobs.Each(func(job: ResetMailJob) -> ()
    let opened = auth.OpenPasswordReset(key, job.EncryptedPayload)
    let sent = if opened.IsOk() then send(job.Email, opened.Unwrap()) else Err[(), String]("invalid reset payload") end
    let terminal = sent.IsOk() || opened.IsErr() || job.Attempts >= maxAttempts
    let state = if sent.IsOk() then "sent" else if terminal then "failed" else "pending" end end
    let payload = if terminal then [] as Slice[Byte] else job.EncryptedPayload end
    let delay = VerificationRetrySeconds(retrySeconds, retryMaxSeconds, job.Attempts)
    let settle = db.WithContext(ctx).Exec("UPDATE password_reset_mail_jobs SET state=?,encrypted_payload=?,lease_token=NULL,lease_until=NULL,available_at=? WHERE id=? AND state='leased' AND lease_token=?", state, payload, now.Add(delay as time.Duration * time.Second), job.ID, lease)
    if QueryFailed(settle) then
      failed = true
    else if sent.IsOk() && settle.RowsAffected == 1i64 then
      delivered = delivered + 1
    end end
  end)
  if failed then
    return Err("reset mail unavailable")
  end
  Ok(delivered)
end
