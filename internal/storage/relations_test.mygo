package storage

import testing "go:testing"
import context "go:context"
import config "github.com/commune-project/commune-backend/internal/config"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func TestPostgresImportAndShareBoundaries(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = MigrateGORM(ctx, db).Unwrap()
  let site = config.Site{ID: "a", Origin: "https://a.example"}
  let other = config.Site{ID: "b", Origin: "https://b.example"}
  let _ = ProvisionSite(ctx, db, site).Unwrap()
  let _ = ProvisionSite(ctx, db, other).Unwrap()
  let accounts = AccountRepository{DB: db}
  let alice = accounts.Create(ctx, site, "alice", "", "alice-account-password").Unwrap()
  let carol = accounts.Create(ctx, other, "carol", "", "carol-account-password").Unwrap()
  let communities = CommunityRepository{DB: db, SiteID: site.ID}
  let posts = PostRepository{DB: db, SiteID: site.ID}
  let importer = PostRepository{DB: db, SiteID: "b"}
  let reader = FeedRepository{DB: db, SiteID: "b"}
  let open = communities.Create(ctx, site, alice, "open", "Open", "federated", "eligible_users", "eligible_users").Unwrap()
  let public2 = communities.Create(ctx, site, alice, "open2", "Open2", "federated", "eligible_users", "eligible_users").Unwrap()
  let locked = communities.Create(ctx, site, alice, "locked", "Locked", "federated", "members", "members").Unwrap()
  let localc = communities.Create(ctx, site, alice, "local", "Local", "local_only", "eligible_users", "eligible_users").Unwrap()
  let topic = posts.Publish(ctx, site, open.ID, alice, false, PublishInput{Title: "T", Body: "B", ParentID: ""}).Unwrap()
  let hidden = posts.Publish(ctx, site, locked.ID, alice, false, PublishInput{Title: "H", Body: "B", ParentID: ""}).Unwrap()
  let localTopic = posts.Publish(ctx, site, localc.ID, alice, false, PublishInput{Title: "L", Body: "B", ParentID: ""}).Unwrap()
  let imported = importer.Import(ctx, topic.ID, carol, false).Unwrap()
  if imported.ID != topic.ID then
    t.Fatal("explicit import returned another object")
  end
  let count: Int64 = 0i64
  let _ = MutationResult(db.Table("site_posts").Where("site_id='b' AND post_id=?", topic.ID).Count(Ref.new(count))).Unwrap()
  if count != 1i64 then
    t.Fatal("explicit import did not record exactly one reception")
  end
  let readable = reader.ReadObject(ctx, topic.ID, carol, false)
  if readable.IsErr() then
    t.Fatal("imported object was not readable at the importing site")
  end
  let deniedHidden = importer.Import(ctx, hidden.ID, carol, false)
  let deniedLocal = importer.Import(ctx, localTopic.ID, carol, false)
  if deniedHidden.IsOk() || deniedLocal.IsOk() then
    t.Fatal("restricted object was imported by an unauthorized viewer")
  end
  let _ = MutationResult(db.Table("site_posts").Where("site_id='b' AND post_id=?", hidden.ID).Count(Ref.new(count))).Unwrap()
  if count != 0i64 then
    t.Fatal("failed import still recorded a reception")
  end
  if posts.ShareTo(ctx, topic.ID, public2.ID, alice, false).IsErr() then
    t.Fatal("public object could not be shared to another public community")
  end
  let _ = MutationResult(db.Table("post_audiences").Where("post_id=? AND community_id=?", topic.ID, public2.ID).Count(Ref.new(count))).Unwrap()
  if count != 1i64 then
    t.Fatal("share did not record the target audience")
  end
  let toLocked = posts.ShareTo(ctx, topic.ID, locked.ID, alice, false)
  let toLocal = posts.ShareTo(ctx, topic.ID, localc.ID, alice, false)
  if toLocked.IsOk() || toLocal.IsOk() then
    t.Fatal("share widened a restricted boundary")
  end
  let fromLocked = posts.ShareTo(ctx, hidden.ID, public2.ID, alice, false)
  if fromLocked.IsOk() then
    t.Fatal("member-readable object was shared to a public community")
  end
  let _ = MutationResult(db.Table("post_audiences").Where("post_id=? AND community_id=?", topic.ID, locked.ID).Count(Ref.new(count))).Unwrap()
  if count != 0i64 then
    t.Fatal("rejected share persisted an audience row")
  end
  if posts.MoveTo(ctx, topic.ID, alice, false).IsOk() then
    t.Fatal("relocation was accepted")
  end
end
