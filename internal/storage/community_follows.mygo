package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import rand "go:crypto/rand"
import time "go:time"
import auth "github.com/commune-project/commune-backend/internal/auth"

# A subscription is not a membership: the follow row records delivery interest
# while community_members records authorization.
func SetCommunityFollow(ctx: context.Context, db: Ref[gorm.DB], communityID: String, actorURI: String, followURI: String, state: String) -> Result[(), String]
  if communityID == "" || actorURI == "" || followURI == "" then
    return Err("invalid follow")
  end
  if state != "pending" && state != "accepted" && state != "rejected" && state != "undone" then
    return Err("invalid follow state")
  end
  MutationResult(db.WithContext(ctx).Exec("INSERT INTO follows(community_id,actor_uri,follow_uri,state) VALUES (?,?,?,?) ON CONFLICT (community_id,actor_uri) DO UPDATE SET state=EXCLUDED.state, follow_uri=CASE WHEN EXCLUDED.state='undone' THEN follows.follow_uri ELSE EXCLUDED.follow_uri END, updated_at=now()", communityID, actorURI, followURI, state))
end

func CommunityFollowState(ctx: context.Context, db: Ref[gorm.DB], communityID: String, actorURI: String) -> Result[String, String]
  let state = ""
  let query = db.WithContext(ctx).Raw("SELECT state FROM follows WHERE community_id = ? AND actor_uri = ?", communityID, actorURI).Scan(Ref.new(state))
  return Required(query, state, "not subscribed")
end

func CommunityFollowURI(ctx: context.Context, db: Ref[gorm.DB], communityID: String, actorURI: String) -> Result[String, String]
  let uri = ""
  let query = db.WithContext(ctx).Raw("SELECT follow_uri FROM follows WHERE community_id = ? AND actor_uri = ?", communityID, actorURI).Scan(Ref.new(uri))
  return Required(query, uri, "not subscribed")
end

struct FollowRequestRecord
  ActorURI: String `gorm:"column:actor_uri" json:"actor_uri"`
  UpdatedAt: time.Time `gorm:"column:updated_at" json:"updated_at"`
end

func BrowserFollow(ctx: context.Context, db: Ref[gorm.DB], siteID: String, communityID: String, identity: auth.Identity, follow: Bool) -> Result[String, String]
  BrowserFollowWithURI(ctx, db, siteID, communityID, identity, follow, "")
end

func BrowserFollowWithURI(ctx: context.Context, db: Ref[gorm.DB], siteID: String, communityID: String, identity: auth.Identity, follow: Bool, activityURI: String) -> Result[String, String]
  let community = CommunityRepository{DB: db, SiteID: siteID}.Open(ctx, communityID, false)
  if community.IsErr() then
    return Err("not found")
  end
  let access = CommunityRepository{DB: db, SiteID: siteID}.Access(ctx, community.Unwrap(), identity, false)
  if access.IsErr() || !access.Unwrap().CanRead() then
    return Err("not found")
  end
  if access.Unwrap().Community.HostSiteID != siteID then
    let received = QueryExists(db.WithContext(ctx).Table("posts AS p").Joins(
      "JOIN site_posts sp ON sp.post_id=p.id AND sp.site_id=?",
      siteID
    ).Where("p.community_id=?", communityID))
    if received.IsErr() || !received.Unwrap() then
      return Err("not found")
    end
  end
  let site = SiteRepository{DB: db, SiteID: siteID}
  let blocked = site.IsBlocked(ctx, identity.ActorURI)
  if blocked.IsErr() then
    return Err(blocked.UnwrapErr())
  end
  if blocked.Unwrap() then
    return Err("forbidden")
  end
  let member = QueryExists(db.WithContext(ctx).Table("community_members").Where("community_id=? AND actor_uri=? AND revoked_at IS NULL", communityID, identity.ActorURI))
  let manager = QueryExists(db.WithContext(ctx).Table("moderators").Where("community_id=? AND actor_uri=? AND revoked_at IS NULL", communityID, identity.ActorURI))
  if member.IsErr() || manager.IsErr() then
    return Err("follow unavailable")
  end
  if !follow then
    let undoURI = if activityURI != "" then activityURI else "urn:commune:undo:" + rand.Text() end
    let undone = SetCommunityFollow(ctx, db, communityID, identity.ActorURI, undoURI, "undone")
    if undone.IsErr() then
      return Err(undone.UnwrapErr())
    end
    return Ok("undone")
  end
  let policyResult = LoadCommunityFollowRule(ctx, db, communityID)
  if policyResult.IsErr() then
    return Err(policyResult.UnwrapErr())
  end
  let policy = policyResult.Unwrap()
  if policy == "disabled" then
    return Err("feature_disabled")
  end
  if policy == "members" && !member.Unwrap() && !manager.Unwrap() then
    return Err("follow_requires_membership")
  end
  let state = if policy == "approval" && !member.Unwrap() && !manager.Unwrap() then "pending" else "accepted" end
  let followURI = if activityURI != "" then activityURI else "urn:commune:follow:" + rand.Text() end
  let saved = SetCommunityFollow(ctx, db, communityID, identity.ActorURI, followURI, state)
  if saved.IsErr() then
    return Err(saved.UnwrapErr())
  end
  Ok(state)
end

func PendingFollows(ctx: context.Context, db: Ref[gorm.DB], communityID: String, limit: Int, offset: Int) -> Result[Slice[FollowRequestRecord], String]
  var rows: Slice[FollowRequestRecord] = []
  let query = db.WithContext(ctx).Raw("SELECT actor_uri, updated_at FROM follows WHERE community_id=? AND state='pending' ORDER BY updated_at,actor_uri LIMIT ? OFFSET ?", communityID, limit, offset).Scan(Ref.new(rows))
  if MutationResult(query).IsErr() then
    return Err("follow requests unavailable")
  end
  Ok(rows)
end

func ReviewFollow(ctx: context.Context, db: Ref[gorm.DB], siteID: String, communityID: String, identity: auth.Identity, actorURI: String, accept: Bool) -> Result[(), String]
  let changed = ReviewFollowChanged(ctx, db, siteID, communityID, identity, actorURI, accept)
  if changed.IsErr() then
    return Err(changed.UnwrapErr())
  end
  Ok(())
end

func ReviewFollowChanged(ctx: context.Context, db: Ref[gorm.DB], siteID: String, communityID: String, identity: auth.Identity, actorURI: String, accept: Bool) -> Result[Bool, String]
  var changed = false
  let reviewed = CommunityRepository{DB: db, SiteID: siteID}.Manage(ctx, communityID, identity, false, "review-follow", actorURI, func(tx: Ref[gorm.DB], community: CommunityRecord) -> Result[(), String]
    let state = ""
    let found = tx.WithContext(ctx).Raw("SELECT state FROM follows WHERE community_id=? AND actor_uri=? FOR UPDATE", communityID, actorURI).Scan(Ref.new(state))
    if MutationResult(found).IsErr() || found.RowsAffected != 1i64 then
      return Err("not found")
    end
    let desired = if accept then "accepted" else "rejected" end
    if state == desired then
      return Ok(())
    end
    if state != "pending" then
      return Err("follow conflict")
    end
    if MutationResult(tx.Exec("UPDATE follows SET state=?,updated_at=now() WHERE community_id=? AND actor_uri=?", desired, communityID, actorURI)).IsErr() then
      return Err("follow review failed")
    end
    changed = true
    if accept then
      if MutationResult(tx.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?) ON CONFLICT (community_id,actor_uri) DO UPDATE SET approved_by=EXCLUDED.approved_by,approved_at=now(),revoked_at=NULL", communityID, actorURI, identity.ActorURI)).IsErr() then
        return Err("follow review failed")
      end
    end
    Ok(())
  end)
  if reviewed.IsErr() then
    return Err(reviewed.UnwrapErr())
  end
  Ok(changed)
end

# Managers advertised through the Group's attributedTo collection, confined to the
# community read policy.
func CommunityManagers(ctx: context.Context, db: Ref[gorm.DB], communityID: String) -> Result[Slice[String], String]
  var managers: Slice[String] = []
  let query = db.WithContext(ctx).Raw("SELECT creator_actor_uri AS actor_uri FROM communities WHERE id = ? UNION SELECT actor_uri FROM moderators WHERE community_id = ? AND revoked_at IS NULL ORDER BY 1", communityID, communityID).Scan(Ref.new(managers))
  if MutationResult(query).IsErr() then
    return Err("manager list unavailable")
  end
  Ok(managers)
end
