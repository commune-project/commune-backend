package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import time "go:time"
import rand "go:crypto/rand"
import io "go:io"
import os "go:os"
import auth "github.com/commune-project/commune-backend/internal/auth"
import config "github.com/commune-project/commune-backend/internal/config"

struct MediaUpload
  ID: String `gorm:"column:id" json:"id"`
  SiteID: String `gorm:"column:site_id" json:"-"`
  OwnerAccountID: Int64 `gorm:"column:owner_account_id" json:"-"`
  Purpose: String `gorm:"column:purpose" json:"purpose"`
  State: String `gorm:"column:state" json:"-"`
  ReservedBytes: Int64 `gorm:"column:reserved_bytes" json:"-"`
  SizeBytes: Int64 `gorm:"column:size_bytes" json:"size"`
  PreviewBytes: Int64 `gorm:"column:preview_bytes" json:"-"`
  MediaType: String `gorm:"column:media_type" json:"media_type"`
  OriginalName: String `gorm:"column:original_name" json:"name"`
  CreatedAt: time.Time `gorm:"column:created_at" json:"-"`
  ExpiresAt: time.Time `gorm:"column:expires_at" json:"expires_at"`
  LeaseToken: String `gorm:"column:lease_token" json:"-"`
  LeaseUntil: time.Time `gorm:"column:lease_until" json:"-"`
end

struct MediaBinding
  ID: String `gorm:"column:id" json:"id"`
  UploadID: String `gorm:"column:upload_id" json:"upload_id"`
  SiteID: String `gorm:"column:site_id" json:"-"`
  OwnerAccountID: Int64 `gorm:"column:owner_account_id" json:"-"`
  Purpose: String `gorm:"column:purpose" json:"purpose"`
  PostID: String `gorm:"column:post_id" json:"post_id,omitempty"`
  Active: Bool `gorm:"column:active" json:"-"`
end

struct MediaRepository
  DB: Ref[gorm.DB]
  SiteID: String
  Files: MediaFiles
  Settings: config.Media
end

func MediaBindingURL(id: String) -> String
  if id == "" then "" else "/api/v1/media/" + id end
end

func BindPostMedia(ctx: context.Context, tx: Ref[gorm.DB], siteID: String, identity: auth.Identity, postID: String, ids: Slice[String]) -> Result[Slice[String], String]
  MediaRepository{DB: tx, SiteID: siteID}.BindPostTx(ctx, tx, identity, postID, ids)
end

impl MediaRepository
  func Owner(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], identity: auth.Identity) -> Result[(), String]
    if identity.SiteID != self.SiteID || identity.AccountID <= 0i64 then
      return Err("forbidden")
    end
    let active = QueryExists(tx.WithContext(ctx).Table("accounts").Where("id=? AND site_id=? AND actor_uri=? AND NOT disabled", identity.AccountID, self.SiteID, identity.ActorURI))
    if active.IsErr() then
      return Err("media unavailable")
    end
    if !active.Unwrap() then
      return Err("forbidden")
    end
    let blocked = SiteRepository{DB: tx, SiteID: self.SiteID}.IsBlocked(ctx, identity.ActorURI)
    if blocked.IsErr() then
      return Err("media unavailable")
    end
    if blocked.Unwrap() then
      return Err("forbidden")
    end
    Ok(())
  end

  # Reserve the maximum original plus maximum PNG preview before reading any
  # bytes. All reservations for a site serialize on its durable site row.
  func Reserve(self: MediaRepository, ctx: context.Context, identity: auth.Identity, purpose: String, name: String) -> Result[MediaUpload, String]
    if !self.Settings.Enabled || (purpose != "post" && purpose != "avatar") then
      return Err("invalid media purpose")
    end
    let maxOriginal = if purpose == "avatar" then self.Settings.MaxImageBytes else self.Settings.MaxFileBytes end
    let previewBudget = self.Settings.PreviewDimension as Int64 * self.Settings.PreviewDimension as Int64 * 5i64 + 65536i64
    let reserve = maxOriginal as Int64 + previewBudget
    let now = time.Now().UTC()
    let row = MediaUpload{ID: rand.Text(), SiteID: self.SiteID, OwnerAccountID: identity.AccountID, Purpose: purpose, State: "uploading", ReservedBytes: reserve, OriginalName: MediaSafeName(name), CreatedAt: now, ExpiresAt: now.Add(self.Settings.TemporaryRetentionSeconds as time.Duration * time.Second), LeaseToken: rand.Text(), LeaseUntil: now.Add(10 as time.Duration * time.Minute)}
    let result = RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let site: String = ""
      let locked = tx.WithContext(ctx).Raw("SELECT id FROM sites WHERE id=? FOR UPDATE", self.SiteID).Scan(Ref.new(site))
      if QueryFailed(locked) || locked.RowsAffected != 1i64 then
        return Err("media unavailable")
      end
      let owner = self.Owner(ctx, tx, identity)
      if owner.IsErr() then
        return owner
      end
      let siteBytes: Int64 = 0i64
      let accountBytes: Int64 = 0i64
      if QueryFailed(tx.Raw("SELECT COALESCE((SELECT sum(reserved_bytes) FROM media_uploads WHERE site_id=?),0)+COALESCE((SELECT sum(size_bytes) FROM media_private_cache WHERE site_id=?),0)", self.SiteID, self.SiteID).Scan(Ref.new(siteBytes))) || QueryFailed(tx.Raw("SELECT COALESCE(sum(reserved_bytes),0) FROM media_uploads WHERE site_id=? AND owner_account_id=?", self.SiteID, identity.AccountID).Scan(Ref.new(accountBytes))) then
        return Err("media unavailable")
      end
      if reserve > self.Settings.SiteQuotaBytes as Int64 - siteBytes || reserve > self.Settings.AccountQuotaBytes as Int64 - accountBytes then
        return Err("media quota exceeded")
      end
      MutationResult(tx.Table("media_uploads").Create(Ref.new(row)))
    end)
    if result.IsErr() then
      return Err(result.UnwrapErr())
    end
    Ok(row)
  end

  func Upload(self: MediaRepository, ctx: context.Context, identity: auth.Identity, purpose: String, name: String, declared: String, reader: io.Reader) -> Result[MediaUpload, String]
    let reserved = self.Reserve(ctx, identity, purpose, name)
    if reserved.IsErr() then
      return Err(reserved.UnwrapErr())
    end
    var row = reserved.Unwrap()
    let limit = if purpose == "avatar" then self.Settings.MaxImageBytes else self.Settings.MaxFileBytes end
    let copied = self.Files.Stream(ctx, row.ID, reader, limit as Int64)
    if copied.IsErr() then
      let _ = self.Abort(row)
      return Err(copied.UnwrapErr())
    end
    if go[Bool] { code: "{ctx}.Err()!=nil"; in ctx = ctx } then
      let _ = self.Abort(row)
      return Err("upload canceled")
    end
    let inspected = self.Files.InspectContext(ctx, row.ID, declared, purpose, self.Settings)
    if inspected.IsErr() then
      let _ = self.Abort(row)
      return Err(inspected.UnwrapErr())
    end
    let info = inspected.Unwrap()
    if go[Bool] { code: "{ctx}.Err()!=nil"; in ctx = ctx } then
      let _ = self.Abort(row)
      return Err("upload canceled")
    end
    if info.Size + info.PreviewSize > row.ReservedBytes || self.Files.Publish(row.ID, "local").IsErr() then
      let _ = self.Abort(row)
      return Err("media unavailable")
    end
    let finalized = self.DB.WithContext(ctx).Exec("UPDATE media_uploads SET state='ready',size_bytes=?,preview_bytes=?,media_type=?,reserved_bytes=?,lease_token='',lease_until=? WHERE id=? AND state='uploading' AND lease_token=? AND lease_until>?", info.Size, info.PreviewSize, info.Type, info.Size + info.PreviewSize, time.Now(), row.ID, row.LeaseToken, time.Now())
    if QueryFailed(finalized) || finalized.RowsAffected != 1i64 then
      let _ = self.Abort(row)
      return Err("media unavailable")
    end
    row.State = "ready"
    row.SizeBytes = info.Size
    row.PreviewBytes = info.PreviewSize
    row.MediaType = info.Type
    row.ReservedBytes = info.Size + info.PreviewSize
    Ok(row)
  end

  # Background context deliberately survives a canceled HTTP request. Failed
  # unlink retains the durable reservation for the retrying cleaner.
  func Abort(self: MediaRepository, row: MediaUpload) -> Result[(), String]
    let ctx = context.Background()
    let marked = self.DB.WithContext(ctx).Exec("UPDATE media_uploads SET state='deleting',lease_until=? WHERE id=? AND state='uploading' AND lease_token=?", time.Now(), row.ID, row.LeaseToken)
    if QueryFailed(marked) || marked.RowsAffected != 1i64 then
      return Err("media unavailable")
    end
    self.DeleteFiles(ctx, self.DB, row.ID)
  end

  func DeleteFiles(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], id: String) -> Result[(), String]
    let temporary = self.Files.Remove("temporary", id)
    let preview = self.Files.Remove("previews", id)
    let source = self.Files.Remove("local", id)
    if temporary.IsErr() || preview.IsErr() || source.IsErr() then
      return Err("media unlink failed")
    end
    if MutationResult(tx.WithContext(ctx).Exec("DELETE FROM media_bindings WHERE upload_id=? AND NOT active", id)).IsErr() then
      return Err("media unavailable")
    end
    MutationResult(tx.WithContext(ctx).Exec("DELETE FROM media_uploads WHERE id=? AND state='deleting' AND NOT EXISTS(SELECT 1 FROM media_bindings WHERE upload_id=? AND active)", id, id))
  end

  # Caller owns tx. Lock the account first so concurrent profile replacements
  # serialize even when no previous avatar exists. Empty ID removes the avatar.
  func BindAvatarTx(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], identity: auth.Identity, uploadID: String) -> Result[String, String]
    let owner = self.Owner(ctx, tx, identity)
    if owner.IsErr() then
      return Err(owner.UnwrapErr())
    end
    let account = AccountRecord{}
    let locked = tx.WithContext(ctx).Raw("SELECT * FROM accounts WHERE id=? AND site_id=? AND NOT disabled FOR UPDATE", identity.AccountID, self.SiteID).Scan(Ref.new(account))
    if QueryFailed(locked) || locked.RowsAffected != 1i64 then
      return Err("forbidden")
    end
    if uploadID != "" then
      let existing = MediaBinding{}
      let found = tx.Table("media_bindings").Where("upload_id=? AND site_id=? AND owner_account_id=? AND purpose='avatar' AND active", uploadID, self.SiteID, identity.AccountID).Find(Ref.new(existing))
      if QueryFailed(found) then
        return Err("media unavailable")
      end
      if found.RowsAffected == 1i64 then
        return Ok(MediaBindingURL(existing.ID))
      end
    end
    if MutationResult(tx.Exec("UPDATE media_bindings SET active=false WHERE site_id=? AND owner_account_id=? AND purpose='avatar' AND active", self.SiteID, identity.AccountID)).IsErr() then
      return Err("media unavailable")
    end
    if uploadID == "" then
      return Ok("")
    end
    self.BindTx(ctx, tx, identity, uploadID, "avatar", "")
  end

  func BindPostTx(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], identity: auth.Identity, postID: String, uploadIDs: Slice[String]) -> Result[Slice[String], String]
    let owner = self.Owner(ctx, tx, identity)
    if owner.IsErr() then
      return Err(owner.UnwrapErr())
    end
    let post = loadPostForUpdate(tx.WithContext(ctx), postID)
    if post.IsErr() || post.Unwrap().DeletedAt.Valid then
      return Err("not found")
    end
    let readable = self.AllowPost(ctx, tx, identity, postID)
    if readable.IsErr() then
      return Err(readable.UnwrapErr())
    end
    let checked = CommunityRepository{DB: tx, SiteID: self.SiteID}.CheckAuthorship(ctx, post.Unwrap().CommunityID, identity, false)
    if checked.IsErr() then
      return Err(checked.UnwrapErr())
    end
    if !checked.Unwrap().CanEditBody(post.Unwrap().AuthorActorURI) then
      return Err("forbidden")
    end
    if uploadIDs.Len() > 32 then
      return Err("invalid media binding")
    end
    var urls: Slice[String] = []
    var i: Int = 0
    while i < uploadIDs.Len()
      let uploadID = uploadIDs.Get(i).Unwrap()
      i = i + 1
      let bound = self.BindTx(ctx, tx, identity, uploadID, "post", postID)
      if bound.IsErr() then
        return Err(bound.UnwrapErr())
      end
      urls = urls.Append(bound.Unwrap())
    end
    # Replacement is atomic with the parent post mutation. Old bindings never
    # authorize subsequent requests, but the immutable source is not reused.
    let retired = if uploadIDs.Len() == 0 then
      tx.Exec("UPDATE media_bindings SET active=false WHERE post_id=? AND site_id=? AND active", postID, self.SiteID)
    else
      tx.Exec("UPDATE media_bindings SET active=false WHERE post_id=? AND site_id=? AND active AND upload_id NOT IN ?", postID, self.SiteID, uploadIDs)
    end
    if MutationResult(retired).IsErr() then
      return Err("media unavailable")
    end
    Ok(urls)
  end

  func BindTx(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], identity: auth.Identity, uploadID: String, purpose: String, postID: String) -> Result[String, String]
    let upload = MediaUpload{}
    let loaded = tx.WithContext(ctx).Raw("SELECT * FROM media_uploads WHERE id=? AND site_id=? AND owner_account_id=? AND purpose=? AND state='ready' FOR UPDATE", uploadID, self.SiteID, identity.AccountID, purpose).Scan(Ref.new(upload))
    if QueryFailed(loaded) then
      return Err("media unavailable")
    end
    if loaded.RowsAffected != 1i64 then
      return Err("not found")
    end
    let existing = MediaBinding{}
    let found = tx.Table("media_bindings").Where("upload_id=?", uploadID).Find(Ref.new(existing))
    if QueryFailed(found) then
      return Err("media unavailable")
    end
    if found.RowsAffected != 0i64 then
      if existing.Active && existing.SiteID == self.SiteID && existing.Purpose == purpose && existing.PostID == postID && existing.OwnerAccountID == identity.AccountID then
        return Ok(MediaBindingURL(existing.ID))
      end
      return Err("media binding conflict")
    end
    if !upload.ExpiresAt.After(time.Now()) then
      return Err("not found")
    end
    let id = rand.Text()
    let inserted = tx.Exec("INSERT INTO media_bindings(id,upload_id,site_id,owner_account_id,purpose,post_id) VALUES (?,?,?,?,?,NULLIF(?,''))", id, uploadID, self.SiteID, identity.AccountID, purpose, postID)
    if QueryFailed(inserted) then
      return Err("media binding conflict")
    end
    Ok(MediaBindingURL(id))
  end

  # Callback runs with a shared upload lock until the transfer completes, so
  # cleanup cannot unlink files under an in-flight original/preview/HEAD read.
  func Read(self: MediaRepository, ctx: context.Context, identity: auth.Identity, id: String, preview: Bool, work: func(MediaUpload, Ref[os.File]) -> Result[(), String]) -> Result[(), String]
    if !MediaFileID(id) then
      return Err("not found")
    end
    RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
      let binding = MediaBinding{}
      let found = tx.Raw("SELECT * FROM media_bindings WHERE id=? AND active FOR SHARE", id).Scan(Ref.new(binding))
      if QueryFailed(found) then
        return Err("media unavailable")
      end
      var uploadID: String = id
      if found.RowsAffected == 1i64 then
        uploadID = binding.UploadID
        if binding.Purpose == "post" then
          # Shared sources can be visible at several receiving sites, but the
          # binding still belongs to its original site and author.
          let read = self.AllowPost(ctx, tx, identity, binding.PostID)
          if read.IsErr() then
            return read
          end
        else
          let current = QueryExists(tx.Table("profiles AS p").Joins("JOIN accounts a ON a.actor_uri=p.actor_uri").Where("p.avatar_binding_id=? AND a.site_id=? AND a.id=? AND NOT a.disabled", binding.ID, binding.SiteID, binding.OwnerAccountID))
          if current.IsErr() then
            return Err("media unavailable")
          end
          if !current.Unwrap() then
            return Err("not found")
          end
        end
      end
      let upload = MediaUpload{}
      let loaded = tx.Raw("SELECT * FROM media_uploads WHERE id=? AND state='ready' FOR SHARE", uploadID).Scan(Ref.new(upload))
      if QueryFailed(loaded) then
        return Err("media unavailable")
      end
      if loaded.RowsAffected != 1i64 then
        return Err("not found")
      end
      if found.RowsAffected == 0i64 then
        let bound = QueryExists(tx.Table("media_bindings").Where("upload_id=?", id))
        if bound.IsErr() then
          return Err("media unavailable")
        end
        if bound.Unwrap() || upload.SiteID != self.SiteID || upload.OwnerAccountID != identity.AccountID || !upload.ExpiresAt.After(time.Now()) then
          return Err("not found")
        end
        let owner = self.Owner(ctx, tx, identity)
        if owner.IsErr() then
          return Err("not found")
        end
      end
      if preview && upload.PreviewBytes == 0i64 then
        return Err("not found")
      end
      let file = self.Files.Open(if preview then "previews" else "local" end, upload.ID)
      if file.IsErr() then
        return Err(file.UnwrapErr())
      end
      let opened = file.Unwrap()
      go[()] { code: "defer {opened}.Close()"; in opened = opened }
      work(upload, opened)
    end)
  end

  func AllowPost(self: MediaRepository, ctx: context.Context, tx: Ref[gorm.DB], identity: auth.Identity, postID: String) -> Result[(), String]
    let browser = BrowserRepository{DB: tx, SiteID: self.SiteID}
    let viewer = browser.Viewer(ctx, identity)
    if viewer.IsErr() then
      return Err("media unavailable")
    end
    if identity.AccountID > 0i64 && (!viewer.Unwrap().Verified || identity.SiteID != self.SiteID) then
      return Err("not found")
    end
    let records: Slice[PostRecord] = []
    let read = tx.WithContext(ctx).Table("posts AS p").Joins("JOIN site_posts sp ON sp.post_id=p.id AND sp.site_id=?", self.SiteID).Where("p.id=? AND p.deleted_at IS NULL AND sp.hidden_at IS NULL AND NOT EXISTS(SELECT 1 FROM collection_memberships cm WHERE cm.post_id=p.id AND cm.community_id=p.community_id AND cm.state IN ('removed','rejected'))", postID).Find(Ref.new(records))
    if QueryFailed(read) then
      return Err("media unavailable")
    end
    if records.Len() != 1 then
      return Err("not found")
    end
    let ids: Slice[String] = [records.Get(0).Unwrap().CommunityID]
    let views = browser.Views(ctx, viewer.Unwrap(), ids)
    if views.IsErr() then
      return Err("media unavailable")
    end
    if views.Unwrap().Len() != 1 || !browser.Access(views.Unwrap().Get(0).Unwrap(), viewer.Unwrap()).CanRead() then
      return Err("not found")
    end
    browser.AuditViews(ctx, viewer.Unwrap(), views.Unwrap())
  end

  # SKIP LOCKED and durable deleting state provide worker exclusion and failed
  # unlink retries. The row lock coordinates with transfers and binding changes.
  func Cleanup(self: MediaRepository, ctx: context.Context, now: time.Time, max: Int) -> Result[Int, String]
    if max < 1 || max > 1000 then
      return Err("invalid cleanup limit")
    end
    var count: Int = 0
    while count < max
      var found: Bool = false
      let cleaned = RunTransaction(ctx, self.DB, func(tx: Ref[gorm.DB]) -> Result[(), String]
        let row = MediaUpload{}
        let selected = tx.Raw("SELECT u.* FROM media_uploads u WHERE u.site_id=? AND NOT EXISTS(SELECT 1 FROM media_bindings b WHERE b.upload_id=u.id AND b.active) AND ((u.state='uploading' AND u.lease_until<=?) OR (u.state='ready' AND u.expires_at<=?) OR u.state='deleting') ORDER BY u.created_at,u.id LIMIT 1 FOR UPDATE OF u SKIP LOCKED", self.SiteID, now, now).Scan(Ref.new(row))
        if QueryFailed(selected) then
          return Err("media unavailable")
        end
        if selected.RowsAffected == 0i64 then
          return Ok(())
        end
        found = true
        if MutationResult(tx.Exec("UPDATE media_uploads SET state='deleting',lease_until=? WHERE id=?", now, row.ID)).IsErr() then
          return Err("media unavailable")
        end
        self.DeleteFiles(ctx, tx, row.ID)
      end)
      if cleaned.IsErr() then
        return Err(cleaned.UnwrapErr())
      end
      if !found then
        return Ok(count)
      end
      count = count + 1
    end
    Ok(count)
  end
end
