package storage

import context "go:context"
import gorm "go:gorm.io/gorm"

func LoadObjectByURI(ctx: context.Context, db: Ref[gorm.DB], uri: String) -> Result[Option[PostRecord], String]
  if uri == "" then
    return Err("invalid object")
  end
  let record = PostRecord{}
  let query = db.WithContext(ctx).Table("posts").Where("object_uri = ?", uri).Limit(1).Find(Ref.new(record))
  if MutationResult(query).IsErr() then
    return Err("object unavailable")
  end
  if query.RowsAffected != 1i64 then
    return Ok[Option[PostRecord], String](None)
  end
  Ok(Some(record))
end
