package storage

import testing "go:testing"
import context "go:context"
import bytes "go:bytes"
import strings "go:strings"
import time "go:time"
import auth "github.com/commune-project/commune-backend/internal/auth"
import config "github.com/commune-project/commune-backend/internal/config"
import concurrency "github.com/mygo-lang/mygo/lib/concurrency"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

struct ResetPayloadTestRow
  EncryptedPayload: Slice[Byte] `gorm:"column:encrypted_payload"`
end

struct ResetHashTestRow
  TokenHash: Slice[Byte] `gorm:"column:token_hash"`
end

func ResetTokenFromLink(link: String) -> String
  strings.Split(link, "#token=").Get(1).UnwrapOr("")
end

func TestPostgresPasswordResetLifecycle(t: Ref[testing.T]) -> ()
  let orm = transport.ORM(testsupport.Postgres(t))
  if orm.IsErr() then
    t.Fatalf("cannot open reset test database: %s", orm.UnwrapErr())
  end
  let db = orm.Unwrap()
  let ctx = context.Background()
  let migrated = MigrateGORM(ctx, db)
  if migrated.IsErr() then
    t.Fatalf("reset migration failed: %s", migrated.UnwrapErr())
  end
  let site = testSite("a", "https://a.example")
  let other = testSite("b", "https://b.example")
  let provisioned = ProvisionSite(ctx, db, site)
  if provisioned.IsErr() then
    t.Fatalf("reset site provisioning failed: %s", provisioned.UnwrapErr())
  end
  let provisionedOther = ProvisionSite(ctx, db, other)
  if provisionedOther.IsErr() then
    t.Fatalf("reset other site provisioning failed: %s", provisionedOther.UnwrapErr())
  end
  let created = AccountRepository{DB: db}.Create(
    ctx,
    site,
    "alice",
    "alice@example.org",
    "old-password"
  )
  if created.IsErr() then
    t.Fatalf("reset account creation failed: %s", created.UnwrapErr())
  end
  let identity = created.Unwrap()
  let createdOther = AccountRepository { DB: db }.Create(
    ctx,
    other,
    "alice",
    "alice@example.org",
    "other-password"
  )
  if createdOther.IsErr() then
    t.Fatalf("reset other account creation failed: %s", createdOther.UnwrapErr())
  end
  let key = "0123456789abcdef0123456789abcdef" as Slice[Byte]
  let repository = PasswordResetRepository {
    DB: db,
    Site: site,
    EncryptionKey: key,
    IPAttempts: 10,
    EmailAttempts: 3,
    TokenTTLSeconds: 3600,
    RateWindowSeconds: 60,
  }
  let now = time.Now().UTC().Truncate(time.Microsecond)
  if repository.Request(ctx, " Alice@Example.org ", "192.0.2.1", now).IsErr() then
    t.Fatal("password reset request failed")
  end
  if repository.Request(ctx, "unknown@example.org", "192.0.2.1", now).IsErr() then
    t.Fatal("unknown reset address did not receive generic acceptance")
  end
  let tokenCount = 0i64
  let countQuery = db.Raw("SELECT count(*) FROM password_reset_tokens WHERE site_id=?", site.ID).Scan(Ref.new(tokenCount))
  if MutationResult(countQuery).IsErr() then
    t.Fatalf("cannot count reset tokens: %v", countQuery.Error)
  end
  if tokenCount != 1i64 then
    t.Fatal("unknown address created a reset token")
  end
  let payloadRow = Zero[ResetPayloadTestRow]()
  let encryptedQuery = db.Table("password_reset_mail_jobs").Select("encrypted_payload").Limit(1).Find(Ref.new(payloadRow))
  if MutationResult(encryptedQuery).IsErr() then
    t.Fatalf("cannot load reset payload: %v", encryptedQuery.Error)
  end
  let encrypted = payloadRow.EncryptedPayload
  var firstLink = ""
  let failed = DeliverPasswordResetMail(
    ctx,
    db,
    key,
    now,
    10,
    60,
    2,
    30,
    3600,
    func(recipient: String, link: String) -> Result[(), String]
      Err("smtp unavailable")
    end
  )
  if failed.IsErr() then
    t.Fatal("resettable mail failure was not retained for retry")
  end
  let state = ""
  let _ = MutationResult(db.Raw("SELECT state FROM password_reset_mail_jobs LIMIT 1").Scan(Ref.new(state))).Unwrap()
  if state != "pending" then
    t.Fatal("transient reset mail failure did not remain retryable")
  end
  let delivered = DeliverPasswordResetMail(
    ctx,
    db,
    key,
    now.Add(2 as time.Duration * time.Minute),
    10,
    60,
    2,
    30,
    3600,
    func(recipient: String, link: String) -> Result[(), String]
      firstLink = link
      Ok(())
    end
  )
  if delivered.IsErr() || delivered.Unwrap() != 1 then
    t.Fatal("reset mail retry did not deliver")
  end
  let token = ResetTokenFromLink(firstLink)
  if token == "" || strings.Contains(encrypted as String, token) then
    t.Fatal("reset token was missing or stored in plaintext")
  end
  let hashRow = Zero[ResetHashTestRow]()
  let _ = MutationResult(db.Table("password_reset_tokens").Select("token_hash").Where(
    "account_id=?",
    identity.AccountID
  ).Limit(1).Find(Ref.new(hashRow))).Unwrap()
  if !bytes.Equal(hashRow.TokenHash, auth.TokenHash(token)) then
    t.Fatal("stored reset digest did not match the delivered token")
  end
  let firstSession = SessionRepository { DB: db }.Issue(ctx, identity, now).Unwrap()
  let secondSession = SessionRepository { DB: db }.Issue(ctx, identity, now).Unwrap()
  if repository.Confirm(ctx, token, "short", now).IsOk() then
    t.Fatal("invalid reset password consumed a token")
  end
  if repository.Confirm(ctx, token, "new-password", now).IsErr() then
    t.Fatal("valid reset confirmation failed")
  end
  if AccountRepository{DB: db}.Authenticate(ctx, site.ID, "alice", "old-password").IsOk() ||
    AccountRepository{DB: db}.Authenticate(ctx, site.ID, "alice", "new-password").IsErr() then
    t.Fatal("reset did not replace the password")
  end
  if SessionRepository{DB: db}.Resolve(ctx, site.ID, firstSession.Session, now).IsOk() ||
    SessionRepository{DB: db}.Resolve(ctx, site.ID, secondSession.Session, now).IsOk() then
    t.Fatal("reset did not revoke existing sessions")
  end
  let otherRepo = PasswordResetRepository{
    DB: db,
    Site: other,
    EncryptionKey: key,
    IPAttempts: 10,
    EmailAttempts: 3,
    TokenTTLSeconds: 3600,
    RateWindowSeconds: 60,
  }
  let _ = otherRepo.Request(ctx, "alice@example.org", "192.0.2.2", now).Unwrap()
  var otherLink = ""
  let _ = DeliverPasswordResetMail(
    ctx,
    db,
    key,
    now.Add(5 as time.Duration * time.Minute),
    10,
    60,
    2,
    30,
    3600,
    func(recipient: String, link: String) -> Result[(), String]
      otherLink = link
      Ok(())
    end
  ).Unwrap()
  let otherToken = ResetTokenFromLink(otherLink)
  if repository.Confirm(ctx, otherToken, "cross-site-password", now).IsOk() then
    t.Fatal("cross-site reset token was accepted")
  end
  var expiredLink = ""
  let expiredRepo = PasswordResetRepository{
    DB: db,
    Site: other,
    EncryptionKey: key,
    IPAttempts: 10,
    EmailAttempts: 3,
    TokenTTLSeconds: 60,
    RateWindowSeconds: 60,
  }
  let _ = expiredRepo.Request(
    ctx,
    "alice@example.org",
    "192.0.2.3",
    now.Add(10 as time.Duration * time.Hour)
  ).Unwrap()
  let _ = DeliverPasswordResetMail(
    ctx,
    db,
    key,
    now.Add(10 as time.Duration * time.Hour),
    10,
    60,
    2,
    30,
    3600,
    func(recipient: String, link: String) -> Result[(), String]
      expiredLink = link
      Ok(())
    end
  ).Unwrap()
  let expiredToken = ResetTokenFromLink(expiredLink)
  if expiredRepo.Confirm(
    ctx,
    expiredToken,
    "expired-password",
    now.Add(10 as time.Duration * time.Hour).Add(2 as time.Duration * time.Minute)
  ).IsOk() ||
    AccountRepository{DB: db}.Authenticate(ctx, other.ID, "alice", "expired-password").IsOk() then
    t.Fatal("expired reset token changed the password")
  end
  let _ = repository.Request(
    ctx,
    "alice@example.org",
    "192.0.2.1",
    now.Add(4 as time.Duration * time.Hour)
  ).Unwrap()
  var resendLink = ""
  let _ = DeliverPasswordResetMail(
    ctx,
    db,
    key,
    now.Add(4 as time.Duration * time.Hour).Add(5 as time.Duration * time.Minute),
    10,
    60,
    2,
    30,
    3600,
    func(recipient: String, link: String) -> Result[(), String]
      resendLink = link
      Ok(())
    end
  ).Unwrap()
  let resendToken = ResetTokenFromLink(resendLink)
  if repository.Confirm(
    ctx,
    token,
    "old-token-password",
    now.Add(4 as time.Duration * time.Hour).Add(10 as time.Duration * time.Minute)
  ).IsOk() then
    t.Fatal("resend did not invalidate the previous token")
  end
  let results = concurrency.MakeChan[Result[(), String]](2)
  let attempts: Slice[String] = ["concurrent-one", "concurrent-two"]
  attempts.Each(func(password: String) -> ()
    concurrency.Spawn(func() -> ()
      let repositoryCopy = PasswordResetRepository {
        DB: db,
        Site: site,
        EncryptionKey: key,
        IPAttempts: 10,
        EmailAttempts: 3,
        TokenTTLSeconds: 3600,
        RateWindowSeconds: 60,
      }
      results.Send(repositoryCopy.Confirm(
        ctx,
        resendToken,
        password,
        now.Add(4 as time.Duration * time.Hour).Add(10 as time.Duration * time.Minute)
      ))
    end)
  end)
  let first = results.Receive().Unwrap()
  let second = results.Receive().Unwrap()
  if first.IsOk() == second.IsOk() then
    t.Fatal("concurrent reset confirmation was not single-use")
  end
end
