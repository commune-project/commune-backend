package storage

import context "go:context"
import gorm "go:gorm.io/gorm"
import sql "go:database/sql"
import time "go:time"
import auth "github.com/commune-project/commune-backend/internal/auth"

struct ReactionRepository
  DB: Ref[gorm.DB]
  SiteID: String
end

impl ReactionRepository
  # Like and Undo require current read access and act only on the issuing
  # actor's own reaction row.
  func Like(
    self: ReactionRepository,
    ctx: context.Context,
    postID: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    reactionURI: String
  ) -> Result[(), String]
    self.Vote(ctx, postID, identity, remoteVerified, 1, reactionURI)
  end

  # A vote is the same one-row state as a like. Score zero clears the row
  # without deleting it, so a later re-vote can reuse the same identity.
  func Vote(
    self: ReactionRepository,
    ctx: context.Context,
    postID: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    score: Int,
    reactionURI: String
  ) -> Result[(), String]
    if score != -1 && score != 0 && score != 1 then
      return Err("invalid vote")
    end
    if score == 0 then
      return self.Undo(ctx, postID, identity, remoteVerified)
    end
    let up = SiteVoteUpEnabled(ctx, self.DB, self.SiteID)
    let down = SiteVoteDownEnabled(ctx, self.DB, self.SiteID)
    if score == 1 && !up then
      return Err("feature_disabled")
    end
    if score == -1 && !down then
      return Err("feature_disabled")
    end
    self.React(
      ctx,
      postID,
      identity,
      remoteVerified,
      func(tx: Ref[gorm.DB], post: PostRecord) -> Result[(), String]
        if post.FederationMode == "local_only" && reactionURI != "" then
          return Err("invalid reaction")
        end
        MutationResult(tx.Exec(
          "INSERT INTO reactions(post_id,actor_uri,reaction_uri,score) VALUES (?,?,?,?) ON CONFLICT (post_id,actor_uri) DO UPDATE SET undone_at=NULL,reaction_uri=EXCLUDED.reaction_uri,score=EXCLUDED.score",
          postID,
          identity.ActorURI,
          sql.NullString { String: reactionURI, Valid: reactionURI != "" },
          score
        ))
      end
    )
  end
  func Undo(
    self: ReactionRepository,
    ctx: context.Context,
    postID: String,
    identity: auth.Identity,
    remoteVerified: Bool
  ) -> Result[(), String]
    self.React(
      ctx,
      postID,
      identity,
      remoteVerified,
      func(tx: Ref[gorm.DB], post: PostRecord) -> Result[(), String]
        MutationResult(tx.Exec(
          "UPDATE reactions SET undone_at=? WHERE post_id=? AND actor_uri=? AND undone_at IS NULL",
          time.Now().UTC().Truncate(time.Microsecond),
          postID,
          identity.ActorURI
        ))
      end
    )
  end
  func React(
    self: ReactionRepository,
    ctx: context.Context,
    postID: String,
    identity: auth.Identity,
    remoteVerified: Bool,
    work: func(Ref[gorm.DB], PostRecord) -> Result[(), String]
  ) -> Result[(), String]
    RunTransaction(
      ctx,
      self.DB,
      func(tx: Ref[gorm.DB]) -> Result[(), String]
        let loaded = loadPostForUpdate(tx, postID)
        if loaded.IsErr() then
          return Err(loaded.UnwrapErr())
        end
        let post = loaded.Unwrap()
        if post.DeletedAt.Valid then
          return Err("not found")
        end
        let received = QueryExists(tx.WithContext(ctx).Table("site_posts").Where(
          "site_id=? AND post_id=? AND hidden_at IS NULL",
          self.SiteID,
          postID
        ))
        if received.IsErr() then
          return Err(received.UnwrapErr())
        end
        if !received.Unwrap() then
          return Err("not found")
        end
        let community = CommunityRepository{DB: tx, SiteID: self.SiteID}
        let access = community.CheckAuthorship(ctx, post.CommunityID, identity, remoteVerified)
        if access.IsErr() then
          return Err(access.UnwrapErr())
        end
        if !access.Unwrap().CanRead() || !access.Unwrap().Subject.Verified then
          return Err("forbidden")
        end
        let communityBan = ActiveCommunityBan(ctx, tx, post.CommunityID, identity.ActorURI, time.Now())
        let siteBan = ActiveSiteBan(ctx, tx, self.SiteID, identity.ActorURI, time.Now())
        if communityBan.IsErr() || siteBan.IsErr() then
          return Err("moderation unavailable")
        end
        if communityBan.Unwrap() || siteBan.Unwrap() then
          return Err("forbidden")
        end
        let blocked = IsInteractionBlocked(ctx, tx, self.SiteID, post.AuthorActorURI, identity.ActorURI)
        if blocked.IsErr() then
          return Err(blocked.UnwrapErr())
        end
        if blocked.Unwrap() then
          return Err("forbidden")
        end
        work(tx, post)
      end
    )
  end
end
