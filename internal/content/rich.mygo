package content

import bytes "go:bytes"
import io "go:io"
import strings "go:strings"
import goldmark "go:github.com/yuin/goldmark"
import extension "go:github.com/yuin/goldmark/extension"
import gmhtml "go:github.com/yuin/goldmark/renderer/html"
import bluemonday "go:github.com/microcosm-cc/bluemonday"
import html "go:golang.org/x/net/html"
struct SanitizerAttribute
  Element: String
  Names: Slice[String]
end

struct SanitizerConfig
  HardWraps: Bool
  AllowRawHTML: Bool
  Elements: Slice[String]
  Attributes: Slice[SanitizerAttribute]
  URLSchemes: Slice[String]
  AllowRelativeURLs: Bool
end

struct Sanitizer
  Policy: Ref[bluemonday.Policy]
  Converter: goldmark.Markdown
end

let DefaultSanitizerConfig = SanitizerConfig {
  HardWraps: true,
  AllowRawHTML: false,
  Elements: [
    "p",
    "br",
    "hr",
    "em",
    "strong",
    "del",
    "ul",
    "ol",
    "li",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "blockquote",
    "pre",
    "code",
    "a",
    "img",
    "table",
    "thead",
    "tbody",
    "tr",
    "th",
    "td",
  ],
  Attributes: [
    SanitizerAttribute { Element: "a", Names: ["href", "title"] },
    SanitizerAttribute {
      Element: "img",
      Names: ["src", "alt", "title", "referrerpolicy"],
    },
  ],
  URLSchemes: ["http", "https"],
  AllowRelativeURLs: true,
}

func BuildRichConverter(hardWraps: Bool, allowRawHTML: Bool) -> goldmark.Markdown
  switch (hardWraps, allowRawHTML)
    case (true, true) then
      goldmark.New(
        goldmark.WithExtensions(
          extension.Linkify,
          extension.NewTable(extension.WithTableCellAlignMethod(extension.TableCellAlignNone)),
          extension.Strikethrough,
          extension.TaskList
        ),
        goldmark.WithRendererOptions(gmhtml.WithHardWraps(), gmhtml.WithUnsafe())
      )
    end
    case (true, false) then
      goldmark.New(
        goldmark.WithExtensions(
          extension.Linkify,
          extension.NewTable(extension.WithTableCellAlignMethod(extension.TableCellAlignNone)),
          extension.Strikethrough,
          extension.TaskList
        ),
        goldmark.WithRendererOptions(gmhtml.WithHardWraps())
      )
    end
    case (false, true) then
      goldmark.New(
        goldmark.WithExtensions(
          extension.Linkify,
          extension.NewTable(extension.WithTableCellAlignMethod(extension.TableCellAlignNone)),
          extension.Strikethrough,
          extension.TaskList
        ),
        goldmark.WithRendererOptions(gmhtml.WithUnsafe())
      )
    end
    case (false, false) then
      goldmark.New(goldmark.WithExtensions(
        extension.Linkify,
        extension.NewTable(extension.WithTableCellAlignMethod(extension.TableCellAlignNone)),
        extension.Strikethrough,
        extension.TaskList
      ))
    end
  end
end

func NewSanitizer(config: SanitizerConfig) -> Sanitizer
  let policy = bluemonday.NewPolicy()
  let _ = policy.RequireParseableURLs(true)
  let _ = policy.RequireNoFollowOnLinks(true)
  let _ = policy.RequireNoReferrerOnLinks(true)
  let _ = policy.AllowRelativeURLs(config.AllowRelativeURLs)
  go[()] {
    code: """{policy}.AllowElements({elements}...)"""
    in policy = policy
    in elements = config.Elements
  }
  config.Attributes.Each(func(item: SanitizerAttribute) -> ()
    go[()] {
      code: """{policy}.AllowAttrs({names}...).OnElements({element})"""
      in policy = policy
      in names = item.Names
      in element = item.Element
    }
  end)
  go[()] {
    code: """{policy}.AllowURLSchemes({schemes}...)"""
    in policy = policy
    in schemes = config.URLSchemes
  }
  Sanitizer {
    Policy: policy,
    Converter: BuildRichConverter(config.HardWraps, config.AllowRawHTML),
  }
end

impl Sanitizer
  func Default() -> Sanitizer
    NewSanitizer(DefaultSanitizerConfig)
  end
end

let DefaultSanitizer: Sanitizer = Sanitizer.Default()
# Format strings are persisted by callers; unknown formats fail closed.
func RenderRich(sanitizer: Sanitizer, source: String, format: String) -> Result[String, String]
  if (source as Slice[Byte]).Len() > 1048576 then
    return Err("content exceeds 1 MiB")
  end
  switch ContentFormat.Parse(format)
    case Err(_) => Err("unsupported content format")
    case Ok(kind) then
      switch kind
        case Legacy => Ok(RenderText(source))
        case Text => Ok(RenderText(source))
        case HTML => Ok(SanitizeRichHTML(sanitizer, source))
        case Markdown then
          let output = bytes.Buffer {}
          # The configured converter enables GFM, optional hard wraps and raw HTML;
          # the allowlist below remains the only executable-content boundary.
          if sanitizer.Converter.Convert(source as Slice[Byte], Ref.new(output) as io.Writer).IsErr() then
            Err("Markdown rendering failed")
          else
            Ok(SanitizeRichHTML(sanitizer, output.String()))
          end
        end
      end
    end
  end
end

# Search normalization follows the same interpretation as display, decodes HTML
# entities once, includes image alt text, and separates blocks before folding
# whitespace. It does not replace the author's editable source.
func PlainRichText(sanitizer: Sanitizer, source: String, format: String) -> Result[String, String]
  switch RenderRich(sanitizer, source, format)
    case Err(message) => Err(message)
    case Ok(rendered) then
      let tokenizer = html.NewTokenizer(strings.NewReader(rendered))
      let output = strings.Builder {}
      var done = false
      while !done
        let kind = tokenizer.Next()
        if kind == html.ErrorToken then
          done = true
        else
          let token = tokenizer.Token()
          if kind == html.TextToken then
            let _ = output.WriteString(token.Data)
          else
            if token.Data == "img" then
              token.Attr.Each(func(attr: html.Attribute) -> ()
                if attr.Key == "alt" then
                  let _ = output.WriteString(" " + attr.Val + " ")
                end
              end)
            else
              if token.Data != "a" &&
                token.Data != "em" &&
                token.Data != "strong" &&
                token.Data != "code" then
                let _ = output.WriteString(" ")
              end
            end
          end
        end
      end
      Ok(strings.Join(strings.Fields(output.String()), " "))
    end
  end
end

# The policy is built once from deployment configuration. No CSS, class/id, event
# attributes, SVG/MathML, forms, embeds, data URLs, or arbitrary schemes are in
# the built-in default; deployments may narrow or extend the validated set.
func SanitizeRichHTML(sanitizer: Sanitizer, source: String) -> String
  let policy = sanitizer.Policy
  # Parse and reserialize, never patch HTML with regular expressions. Override
  # any supplied image policy, then run the final allowlist once more.
  let clean = policy.Sanitize(source)
  let tokenizer = html.NewTokenizer(strings.NewReader(clean))
  let output = strings.Builder {}
  var done = false
  while !done
    let kind = tokenizer.Next()
    if kind == html.ErrorToken then
      done = true
    else
      var token = tokenizer.Token()
      if (kind == html.StartTagToken || kind == html.SelfClosingTagToken) &&
        token.Data == "img" then
        token.Attr = token.Attr.Filter(func(attr: html.Attribute) -> Bool
          attr.Key != "referrerpolicy"
        end).Append(html.Attribute { Namespace: "", Key: "referrerpolicy", Val: "no-referrer" })
      end
      let _ = output.WriteString(token.String())
    end
  end
  policy.Sanitize(output.String())
end
