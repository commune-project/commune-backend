package content

import testing "go:testing"
import strings "go:strings"
import html "go:golang.org/x/net/html"

func TestRichFormatBoundaries(t: Ref[testing.T]) -> ()
  let source = "# Heading\n\n**bold** &amp; `@code`\n\n- one\n- two\n\n> quote\n\n[link](https://example.org)\n\n![alt](https://example.org/image.png)\n\n<script>alert(1)</script>"
  let rendered = RenderRich(DefaultSanitizer(), source, "markdown").Unwrap()
  [
    "<h1>Heading</h1>",
    "<strong>bold</strong>",
    "<code>@code</code>",
    "<ul>",
    "<blockquote>",
    "https://example.org/image.png",
    "referrerpolicy=\"no-referrer\"",
    "noreferrer",
    "nofollow",
  ].Each(func(fragment: String) -> ()
    if !strings.Contains(rendered, fragment) then
      t.Fatalf("missing Markdown feature %s in %s", fragment, rendered)
    end
  end)
  if strings.Contains(rendered, "<script") then
    t.Fatal("Markdown raw HTML was enabled")
  end
  let legacy = "**literal** <b>old</b> &lt;tag&gt;"
  if RenderRich(DefaultSanitizer(), legacy, "legacy").Unwrap() != RenderText(legacy) ||
    RenderRich(DefaultSanitizer(), legacy, "text").Unwrap() != RenderText(legacy) then
    t.Fatal("legacy rendering changed")
  end
  if RenderRich(DefaultSanitizer(), "**literal** <strong>HTML</strong>", "html").Unwrap() !=
    "**literal** <strong>HTML</strong>" then
    t.Fatal("remote HTML was interpreted as Markdown")
  end
  if RenderRich(DefaultSanitizer(), "hello", "unknown").IsOk() || PlainRichText(DefaultSanitizer(), "hello", "unknown").IsOk() then
    t.Fatal("unknown format accepted")
  end
end

# Inspect parsed output, so alternate quote styles/case/encoding cannot make a
# string-based XSS assertion pass. Also check repeat sanitization convergence.
func AssertRichSafe(t: Ref[testing.T], rendered: String) -> ()
  let tokenizer = html.NewTokenizer(strings.NewReader(rendered))
  var done = false
  while !done
    let kind = tokenizer.Next()
    if kind == html.ErrorToken then
      done = true
    else
      if kind == html.StartTagToken || kind == html.SelfClosingTagToken then
        let token = tokenizer.Token()
        let allowed: Slice[String] = [
          "p",
          "br",
          "hr",
          "em",
          "strong",
          "ul",
          "ol",
          "li",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
          "blockquote",
          "pre",
          "code",
          "a",
          "img",
          "del",
          "table",
          "thead",
          "tbody",
          "tr",
          "th",
          "td",
        ]
        if !allowed.Contains(token.Data) then
          t.Fatalf("active/unexpected element survived: %s", rendered)
        end
        var imagePolicy = false
        token.Attr.Each(func(attr: html.Attribute) -> ()
          if attr.Key != "href" &&
            attr.Key != "src" &&
            attr.Key != "alt" &&
            attr.Key != "title" &&
            attr.Key != "rel" &&
            attr.Key != "referrerpolicy" then
            t.Fatalf("unsafe attribute survived: %s", rendered)
          end
          if attr.Key == "href" || attr.Key == "src" then
            let value = strings.ToLower(strings.TrimSpace(attr.Val))
            if strings.Contains(value, ":") &&
              !strings.HasPrefix(value, "http://") &&
              !strings.HasPrefix(value, "https://") then
              t.Fatalf("unsafe URL survived: %s", rendered)
            end
          end
          if attr.Key == "referrerpolicy" && attr.Val == "no-referrer" then
            imagePolicy = true
          end
        end)
        if token.Data == "img" && !imagePolicy then
          t.Fatalf("image can leak referrer: %s", rendered)
        end
      end
    end
  end
  if SanitizeRichHTML(DefaultSanitizer(), rendered) != rendered then
    t.Fatalf("sanitization did not converge: %s", rendered)
  end
end

func TestRichAdversarialHTML(t: Ref[testing.T]) -> ()
  let attacks: Slice[String] = [
    "<script>alert(1)</script><p>safe</p>",
    "<a href='jAvAsCrIpT:alert(1)' onclick='bad()'>safe</a>",
    "<a href='&#106;avascript&#58;alert(1)'>safe</a>",
    "<a href='java&#x09;script:alert(1)'>safe</a>",
    "<a href='java&#x0a;script:alert(1)'>safe</a>",
    "<img src='data:image/svg+xml,bad' onerror='bad()'><p>safe</p>",
    "<img src='vbscript:bad'><p>safe</p>",
    "<svg><a xlink:href='javascript:bad'>bad</a></svg><p>safe</p>",
    "<math><mtext><img src=x onerror=bad></mtext></math><p>safe</p>",
    "<iframe srcdoc='<script>bad()</script>'></iframe><p>safe</p>",
    "<object data='https://evil.invalid'></object><embed src=x><p>safe</p>",
    "<p style='background:url(javascript:bad)' class=x id=x>safe</p>",
    "<IMG SRC='https://example.org/a.png' SRCSET='javascript:bad' onload=bad referrerpolicy='unsafe-url'><p>safe</p>",
    "<form action='javascript:bad'><input autofocus onfocus=bad></form><p>safe</p>",
    "<!-- <img src=x onerror=bad> --><p>safe</p>",
    "<scr<script>ipt>bad</scr<script>ipt><p>safe</p>",
    "<a href='javascript:bad' <img src=x onerror=bad>>safe</a>",
    "<style>body{display:none}</style><p>safe</p>",
    "&lt;script&gt;literal&lt;/script&gt;<p>safe</p>",
  ]
  attacks.Each(func(source: String) -> ()
    let rendered = RenderRich(DefaultSanitizer(), source, "html").Unwrap()
    AssertRichSafe(t, rendered)
    if !strings.Contains(rendered, "safe") then
      t.Fatalf("safe text was lost: %s => %s", source, rendered)
    end
    AssertRichSafe(t, RenderRich(DefaultSanitizer(), source, "markdown").Unwrap())
  end)
  [
    "[x](javascript:alert%281%29)",
    "![x](data:image/svg+xml,bad)",
    "[x](vbscript:bad)",
    "[x](jav&#x61;script:bad)",
  ].Each(func(source: String) -> ()
    AssertRichSafe(t, RenderRich(DefaultSanitizer(), source, "markdown").Unwrap())
  end)
end

func TestPlainRichText(t: Ref[testing.T]) -> ()
  let cases: Slice[Slice[String]] = [
    [
      "markdown",
      "# 中文\n\n**bold** and `code` &amp; ![图像](https://example.org/a.png)",
      "中文 bold and code & 图像",
    ],
    [
      "html",
      "<p>中<strong>文</strong>&amp; hello</p><p>next<br>line</p><script>hidden</script>",
      "中文& hello next line",
    ],
    ["legacy", "a <b>bold</b> &lt;x&gt;", "a bold &lt;x&gt;"],
    ["html", "&lt;script&gt;literal&lt;/script&gt;", "<script>literal</script>"],
  ]
  cases.Each(func(item: Slice[String]) -> ()
    let output = PlainRichText(DefaultSanitizer(), item.Get(1).Unwrap(), item.Get(0).Unwrap()).Unwrap()
    if output != item.Get(2).Unwrap() then
      t.Fatalf("wrong plain text: %s", output)
    end
  end)
end

func TestRichBounds(t: Ref[testing.T]) -> ()
  let oversized = strings.Repeat("x", 1048577)
  if RenderRich(DefaultSanitizer(), oversized, "markdown").IsOk() ||
    ExtractMentionCandidates(oversized, "markdown").IsOk() ||
    PlainRichText(DefaultSanitizer(), oversized, "html").IsOk() then
    t.Fatal("oversized input accepted")
  end
  if ExtractMentionCandidates(strings.Repeat("@alice ", 65), "markdown").IsOk() then
    t.Fatal("candidate bound not enforced")
  end
end

func TestRichGFMAndHardWraps(t: Ref[testing.T]) -> ()
  let source = "line one\nline two\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\n~~gone~~ https://example.org\n\n- [x] done"
  let rendered = RenderRich(DefaultSanitizer(), source, "markdown").Unwrap()
  [
    "<br>",
    "<table>",
    "<del>gone</del>",
    "href=\"https://example.org\"",
    "done",
  ].Each(func(fragment: String) -> ()
    if !strings.Contains(rendered, fragment) then
      t.Fatalf("missing GFM feature %s in %s", fragment, rendered)
    end
  end)
  if strings.Contains(rendered, "align=") || strings.Contains(rendered, "text-align") then
    t.Fatalf("table alignment leaked: %s", rendered)
  end
  if strings.Contains(rendered, "<input") then
    t.Fatalf("task-list checkbox rendered: %s", rendered)
  end
end

func TestRichRawHTMLAllowlist(t: Ref[testing.T]) -> ()
  var config = DefaultSanitizerConfig()
  config.AllowRawHTML = true
  let sanitizer = NewSanitizer(config)
  let rendered = RenderRich(
    sanitizer,
    "<h2>heading</h2><script>bad()</script><p class=\"x\">safe</p>",
    "markdown"
  ).Unwrap()
  if !strings.Contains(rendered, "<h2>heading</h2>") ||
    strings.Contains(rendered, "<script") ||
    strings.Contains(rendered, "class=") then
    t.Fatalf("raw HTML allowlist mismatch: %s", rendered)
  end
end

func TestRichConfiguredAllowlist(t: Ref[testing.T]) -> ()
  var restricted = DefaultSanitizerConfig()
  restricted.Elements = ["p", "a", "img"]
  restricted.Attributes = [
    SanitizerAttribute{Element: "a", Names: ["href"]},
    SanitizerAttribute{Element: "img", Names: ["src", "alt"]},
  ]
  let rendered = RenderRich(
    NewSanitizer(restricted),
    "# Heading\n\n**bold** [x](https://e.example)",
    "markdown"
  ).Unwrap()
  if strings.Contains(rendered, "<h1>") || strings.Contains(rendered, "<strong>") then
    t.Fatalf("restricted allowlist kept omitted elements: %s", rendered)
  end
  if !strings.Contains(rendered, "Heading") || !strings.Contains(rendered, "bold") then
    t.Fatalf("restricted allowlist lost text: %s", rendered)
  end
  var empty = DefaultSanitizerConfig()
  empty.Elements = []
  empty.Attributes = []
  let bare = RenderRich(NewSanitizer(empty), "# Heading\n\n**bold**", "markdown").Unwrap()
  if strings.Contains(bare, "<") || !strings.Contains(bare, "Heading") || !strings.Contains(bare, "bold") then
    t.Fatalf("empty allowlist mismatch: %s", bare)
  end
end
