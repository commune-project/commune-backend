package server

import http "go:net/http"
import io "go:io"
import context "go:context"
import json "go:encoding/json"
import strings "go:strings"
import time "go:time"
import slog "go:log/slog"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-mygo/internal/config"
import storage "github.com/commune-project/commune-mygo/internal/storage"
import federation "github.com/commune-project/commune-mygo/internal/federation"

struct ActivityEnvelope
  ID: String `json:"id"`
  Actor: String `json:"actor"`
  Type: String `json:"type"`
  To: Slice[String] `json:"to"`
  CC: Slice[String] `json:"cc"`
end

func KnownActivityKind(kind: String) -> Bool
  kind == "Create" || kind == "Update" || kind == "Delete" || kind == "Like" || kind == "Undo" || kind == "Follow" || kind == "Accept" || kind == "Reject" || kind == "Announce" || kind == "Add" || kind == "Remove"
end

func InboxHandler(settings: config.Config, db: Ref[gorm.DB], site: config.Site, w: http.ResponseWriter, request: Ref[http.Request], ownerURI: String) -> ()
  let maxBytes = settings.Runtime.MaxBodyBytes
  let reader = http.MaxBytesReader(w, request.Body, (maxBytes + 1) as Int64)
  let body = io.ReadAll(reader)
  let _ = reader.Close()
  if body.IsErr() || body.Unwrap().Len() == 0 || body.Unwrap().Len() > maxBytes then
    WriteErrorJSON(w, 400, "invalid activity")
    return
  end
  let payload = body.Unwrap()
  if federation.HasDuplicateKeys(payload) then
    WriteErrorJSON(w, 400, "ambiguous activity")
    return
  end
  let envelope = ActivityEnvelope{}
  if json.Unmarshal(payload, Ref.new(envelope)).IsErr() || envelope.ID == "" || envelope.Actor == "" || !KnownActivityKind(envelope.Type) then
    WriteErrorJSON(w, 400, "invalid activity")
    return
  end
  let authorized = AuthorizeActivity(request, db, settings, payload, envelope.Actor)
  if authorized.IsErr() then
    slog.Warn("inbound signature rejected", "activity", envelope.ID, "actor", envelope.Actor, "kind", envelope.Type, "reason", authorized.UnwrapErr())
    WriteErrorJSON(w, 401, authorized.UnwrapErr())
    return
  end
  let action = AuthorizeInbound(request.Context(), db, settings, payload, envelope)
  if action.IsErr() then
    slog.Warn("inbound activity rejected", "activity", envelope.ID, "actor", envelope.Actor, "kind", envelope.Type, "reason", action.UnwrapErr())
    WriteErrorJSON(w, 403, action.UnwrapErr())
    return
  end
  let addressed = MergeAddresses(envelope.To, envelope.CC)
  let recipients = storage.LocalActors(request.Context(), db, site.ID, addressed)
  if recipients.IsErr() then
    WriteErrorJSON(w, 503, "receipt unavailable")
    return
  end
  var accepted = recipients.Unwrap()
  if ownerURI != "" && !accepted.Contains(ownerURI) then
    let owner = storage.LocalActors(request.Context(), db, site.ID, [ownerURI])
    if owner.IsErr() then
      WriteErrorJSON(w, 503, "receipt unavailable")
      return
    end
    accepted = owner.Unwrap().Fold(accepted, func(acc: Slice[String], item: String) -> Slice[String]
      acc.Append(item)
    end)
  end
  if accepted.Len() == 0 then
    WriteErrorJSON(w, 400, "no local recipient")
    return
  end
  let received = storage.ReceiveActivity(request.Context(), db, site.ID, accepted, envelope.ID, envelope.Actor, envelope.Type, payload)
  if received.IsErr() then
    let reason = received.UnwrapErr()
    slog.Warn("inbound receipt rejected", "activity", envelope.ID, "actor", envelope.Actor, "kind", envelope.Type, "reason", reason)
    if reason == "conflicting activity" then
      WriteErrorJSON(w, 409, reason)
    else
      WriteErrorJSON(w, 400, reason)
    end
    return
  end
  let parsedActivity = federation.ParseActivity(payload)
  if parsedActivity.IsErr() then
    slog.Warn("inbound activity rejected", "activity", envelope.ID, "actor", envelope.Actor, "kind", envelope.Type, "reason", "invalid activity")
    WriteErrorJSON(w, 400, "invalid activity")
    return
  end
  let applied = ApplyActivity(request.Context(), db, site, parsedActivity.Unwrap(), payload, addressed)
  if applied.IsErr() then
    slog.Warn("inbound activity failed", "activity", envelope.ID, "actor", envelope.Actor, "kind", envelope.Type, "reason", applied.UnwrapErr())
    WriteErrorJSON(w, 400, applied.UnwrapErr())
    return
  end
  var note = ""
  if applied.Unwrap() then
    note = "previously delivered public copies cannot be recalled"
  end
  WriteJSON(w, 202, InboxResult{Receipts: received.Unwrap(), Note: note})
end

struct InboxResult
  Receipts: Int64 `json:"receipts"`
  Note: String `json:"note,omitempty"`
end

func FetchLimitsFrom(settings: config.Config) -> federation.FetchLimits
  federation.FetchLimits{TimeoutSeconds: settings.Federation.FetchTimeoutSeconds, MaxBytes: settings.Federation.MaxFetchBytes, MaxRedirects: settings.Federation.MaxRedirects, AllowPrivate: settings.Federation.AllowPrivateNetwork}
end

# A valid outer signature authorizes forwarding, not authorship of nested or
# mutated state: the claimed author must match, an embedded activity from a
# different actor must be confirmed against its canonical copy, and an update or
# delete may only target an object the signer actually owns.
func AuthorizeInbound(ctx: context.Context, db: Ref[gorm.DB], settings: config.Config, payload: Slice[Byte], envelope: ActivityEnvelope) -> Result[(), String]
  let parsed = federation.ParseActivity(payload)
  if parsed.IsErr() then
    return Err("invalid activity")
  end
  let activity = parsed.Unwrap()
  if activity.ID != envelope.ID || activity.Actor != envelope.Actor || activity.Type != envelope.Type then
    return Err("inconsistent activity")
  end
  if !federation.CreateAuthorMatches(activity) then
    return Err("forged author")
  end
  let embedded = federation.VerifyEmbeddedActivity(ctx, activity, FetchLimitsFrom(settings))
  if embedded.IsErr() then
    return Err(embedded.UnwrapErr())
  end
  if activity.Type == "Update" || activity.Type == "Delete" then
    if activity.ObjectURI == "" then
      return Err("invalid activity")
    end
    let replica = storage.LoadReplicaCommunity(ctx, db, activity.ObjectURI)
    if replica.IsErr() then
      return Err(replica.UnwrapErr())
    end
    if replica.Unwrap().IsSome() then
      if activity.Actor != activity.ObjectURI then
        return Err("forged mutation")
      end
      return Ok(())
    end
    let stored = storage.LoadObjectByURI(ctx, db, activity.ObjectURI)
    if stored.IsErr() || stored.Unwrap().IsNone() then
      return Err("unknown object")
    end
    if !federation.AuthorObjectMutable(activity.Type, activity.Actor, stored.Unwrap().Unwrap().AuthorActorURI) then
      return Err("forged mutation")
    end
  end
  Ok(())
end

func MergeAddresses(first: Slice[String], second: Slice[String]) -> Slice[String]
  let combined = first.Fold([] as Slice[String], func(acc: Slice[String], item: String) -> Slice[String]
    acc.Append(item)
  end)
  second.Fold(combined, func(acc: Slice[String], item: String) -> Slice[String]
    acc.Append(item)
  end)
end

# The signer must be the activity author, must own the presented key, and must
# have sent a fresh request whose digest covers the received body.
func AuthorizeActivity(request: Ref[http.Request], db: Ref[gorm.DB], settings: config.Config, payload: Slice[Byte], actorURI: String) -> Result[(), String]
  let signatureHeader = request.Header.Get("Signature")
  let digestHeader = request.Header.Get("Digest")
  let date = request.Header.Get("Date")
  let parsed = federation.ParseSignatureHeader(signatureHeader)
  if parsed.IsErr() then
    return Err("invalid signature header")
  end
  let keyID = parsed.Unwrap().KeyID
  if !federation.KeyOwnedByActor(keyID, actorURI) then
    return Err("invalid signature")
  end
  if digestHeader != federation.BodyDigest(payload) then
    return Err("invalid digest")
  end
  let actor = storage.LoadActor(request.Context(), db, actorURI)
  if actor.IsErr() || actor.Unwrap().IsNone() then
    return Err("unknown signer")
  end
  let key = actor.Unwrap().Unwrap().PublicKeyPEM
  if !key.Valid || key.String == "" then
    return Err("unknown signer key")
  end
  let verified = federation.VerifyRequest(key.String, "POST", request.URL.Path, request.Host, date, digestHeader, signatureHeader, time.Now(), settings.Federation.ClockSkewSeconds as Int64)
  if verified.IsErr() then
    return Err(verified.UnwrapErr())
  end
  Ok(())
end
