package server

import testing "go:testing"
import context "go:context"
import time "go:time"
import http "go:net/http"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import federation "github.com/commune-project/commune-backend/internal/federation"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func TestPostgresProfileOwnerHTTP(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let site = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let alice = storage.AccountRepository{DB: db}.Create(ctx, site, "alice", "private@example.org", "alice-password").Unwrap()
  let tokens = storage.SessionRepository{DB: db}.Issue(ctx, alice, time.Now()).Unwrap()
  let cookies = tokens.Cookies(time.Now().Add(time.Hour)).Map(func(cookie: http.Cookie) -> Ref[http.Cookie]
    Ref.new(cookie)
  end)
  let handler = (func(w: http.ResponseWriter, request: Ref[http.Request]) -> ()
    let _ = ProfileRoute(settings, db, site, w, request, Segments(request.URL.Path))
  end) as http.HandlerFunc
  let current = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/profile"})
  if current.Code != 401 then
    t.Fatal("current profile requires session")
  end
  let publicProfile = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/profiles/alice"})
  if publicProfile.Code != 200 || publicProfile.Header().Get("Cache-Control") != "no-store" || strings.Contains(publicProfile.Body.String(), "private@example.org") || strings.Contains(publicProfile.Body.String(), "password") then
    t.Fatal("public profile unavailable or private identity leaked")
  end
  var call = forumCall{Method: "PATCH", Origin: site.Origin, Path: "/api/v1/profile", Payload: `{"display_name":"Alice","biography":"**hello** <script>bad()</script>"}`, Cookies: cookies, Source: site.Origin}
  if doForum(handler, call).Code != 403 then
    t.Fatal("missing CSRF accepted")
  end
  call.CSRF = tokens.CSRF
  call.Source = "https://evil.example"
  if doForum(handler, call).Code != 403 then
    t.Fatal("cross origin profile mutation accepted")
  end
  call.Source = site.Origin
  let saved = doForum(handler, call)
  if saved.Code != 200 then
    t.Fatalf("profile save failed: %s", saved.Body.String())
  end
  let profile = storage.LoadProfile(ctx, db, alice.ActorURI).Unwrap()
  if !strings.Contains(profile.BiographyHTML, "<strong>hello</strong>") || strings.Contains(profile.BiographyHTML, "<script") then
    t.Fatal("biography did not use safe Markdown renderer")
  end
  let activityCount = 0i64
  let _ = storage.MutationResult(db.Table("activities").Where("actor_uri=? AND kind='Update'", alice.ActorURI).Count(Ref.new(activityCount))).Unwrap()
  if activityCount != 1i64 then
    t.Fatal("profile save did not create durable authoritative update")
  end
  let bob = storage.AccountRepository{DB: db}.Create(ctx, site, "bob", "", "bob-password").Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO media_uploads(id,site_id,owner_account_id,purpose,state,reserved_bytes,size_bytes,media_type,expires_at,lease_token,lease_until) VALUES ('profile-avatar-one',?,?,'avatar','ready',100,20,'image/png',now()+interval '1 day','',now()),('profile-avatar-two',?,?,'avatar','ready',100,20,'image/png',now()+interval '1 day','',now()),('profile-avatar-foreign',?,?,'avatar','ready',100,20,'image/png',now()+interval '1 day','',now())", site.ID, alice.AccountID, site.ID, alice.AccountID, site.ID, bob.AccountID)).Unwrap()
  var avatarCall = call
  avatarCall.Payload = `{"avatar_upload_id":"profile-avatar-one"}`
  if doForum(handler, avatarCall).Code != 200 then
    t.Fatal("owned avatar bind failed")
  end
  let firstAvatar = storage.LoadProfile(ctx, db, alice.ActorURI).Unwrap()
  let person = federation.ResolvePerson(ctx, db, site, "alice").Unwrap()
  if firstAvatar.AvatarBindingID == "" || person.Icon.URL != firstAvatar.AvatarURL || !strings.HasPrefix(person.Icon.URL, site.Origin + "/api/v1/media/") then
    t.Fatal("avatar binding did not propagate to Person")
  end
  avatarCall.Payload = `{"avatar_upload_id":"profile-avatar-foreign"}`
  if doForum(handler, avatarCall).Code == 200 || storage.LoadProfile(ctx, db, alice.ActorURI).Unwrap().AvatarURL != firstAvatar.AvatarURL then
    t.Fatal("foreign avatar accepted or failed binding changed profile")
  end
  avatarCall.Payload = `{"avatar_upload_id":"profile-avatar-two"}`
  if doForum(handler, avatarCall).Code != 200 then
    t.Fatal("avatar replacement failed")
  end
  let active = 0i64
  let _ = storage.MutationResult(db.Table("media_bindings").Where("id=? AND active", firstAvatar.AvatarBindingID).Count(Ref.new(active))).Unwrap()
  if active != 0i64 then
    t.Fatal("replacement left previous public avatar binding active")
  end
  avatarCall.Payload = `{"avatar_upload_id":null}`
  if doForum(handler, avatarCall).Code != 200 || storage.LoadProfile(ctx, db, alice.ActorURI).Unwrap().AvatarURL != "" then
    t.Fatal("avatar removal failed")
  end
  let invalid: Slice[String] = [`{"username":"rename"}`, `{"email":"change@example.org"}`, `{"actor_uri":"https://evil.example/a"}`, `{"display_name":null}`, `{"display_name":123}`, `{"display_name":"` + strings.Repeat("x", settings.Rendering.MaxDisplayNameLength + 1) + `"}`]
  invalid.Each(func(payload: String) -> ()
    var rejected = call
    rejected.Payload = payload
    if doForum(handler, rejected).Code != 400 then
      t.Fatal("immutable/private/invalid field accepted")
    end
  end)
  let _ = storage.MutationResult(db.Exec("UPDATE accounts SET disabled=true WHERE id=?", alice.AccountID)).Unwrap()
  if doForum(handler, call).Code != 401 then
    t.Fatal("disabled account edited profile")
  end
end
