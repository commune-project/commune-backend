package server

import http "go:net/http"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import auth "github.com/commune-project/commune-backend/internal/auth"
import federation "github.com/commune-project/commune-backend/internal/federation"

struct EditPostInput
  Title: String `json:"title"`
  Body: String `json:"body"`
  ContentFormat: String `json:"content_format"`
  AttachmentIDs: Slice[String] `json:"attachment_ids"`
end

struct ReplyInput
  Body: String `json:"body"`
  ContextURI: String `json:"context_uri"`
  ContentFormat: String `json:"content_format"`
  AttachmentIDs: Slice[String] `json:"attachment_ids"`
end

func PostRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> ()
  let id = parts.Get(3).Unwrap()
  if parts.Len() == 4 then
    if request.Method == "GET" then
      let _ = BrowserReadRoute(settings, db, site, w, request, parts)
    else
      let actor = RequireMutation(settings, db, site, request)
      if actor.IsErr() then
        Fail(w, actor.UnwrapErr())
      else
        PostMutation(settings, db, site, w, request, id, actor.Unwrap())
      end
    end
  else
    PostSectionRoute(settings, db, site, w, request, parts, id)
  end
end

func PostMutation(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  id: String,
  identity: auth.Identity
) -> ()
  if request.Method == "PATCH" then
    let input = EditPostInput{}
    let decoded = DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input))
    if decoded.IsErr() then
      WriteErrorJSON(w, 400, decoded.UnwrapErr())
    else
      let existing = storage.FeedRepository{DB: db, SiteID: site.ID}.ReadObject(request.Context(), id, identity, false)
      if existing.IsErr() then
        Fail(w, existing.UnwrapErr())
        return
      end
      if existing.Unwrap().AuthorActorURI != identity.ActorURI then
        Fail(w, "forbidden")
        return
      end
      let format = if input.ContentFormat == "" then existing.Unwrap().ContentFormat else input.ContentFormat end
      let mentions = ResolvePostMentions(request.Context(), settings, db, site, identity, existing.Unwrap().CommunityID, input.Body, format, true)
      if mentions.IsErr() then
        Fail(w, mentions.UnwrapErr())
        return
      end
      var updated = storage.PostRecord{}
      let saved = storage.RunTransaction(request.Context(), db, func(tx: Ref[gorm.DB]) -> Result[(), String]
        let result = storage.PostRepository{DB: tx, SiteID: site.ID}.EditResolvedContent(request.Context(), id, identity, false, input.Title, input.Body, input.ContentFormat, input.AttachmentIDs, mentions.Unwrap(), !PostAttachmentIDsMissing(input.AttachmentIDs))
        if result.IsErr() then return Err(result.UnwrapErr()) end
        updated = result.Unwrap()
        QueuePostMutation(request.Context(), settings, tx, site, updated, "Update")
      end)
      let edited = if saved.IsErr() then Err[storage.PostRecord, String](saved.UnwrapErr()) else Ok[storage.PostRecord, String](updated) end
      if edited.IsErr() then
        Fail(w, edited.UnwrapErr())
      else
        WriteBrowserPost(db, site, w, request, 200, identity, edited.Unwrap())
      end
    end
  else
    if request.Method == "DELETE" then
      let deleted = storage.RunTransaction(request.Context(), db, func(tx: Ref[gorm.DB]) -> Result[(), String]
        let removed = storage.PostRepository{DB: tx, SiteID: site.ID}.Delete(request.Context(), id, identity, false)
        if removed.IsErr() then return removed end
        let loaded = storage.LoadObjectByID(request.Context(), tx, id)
        if loaded.IsErr() || loaded.Unwrap().IsNone() then return Err("post unavailable") end
        QueuePostMutation(request.Context(), settings, tx, site, loaded.Unwrap().Unwrap(), "Delete")
      end)
      if deleted.IsErr() then
        Fail(w, deleted.UnwrapErr())
      else
        w.WriteHeader(204)
      end
    else
      MethodNotAllowed(w, "GET, PATCH, DELETE")
    end
  end
end

func PostSectionRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String],
  id: String
) -> ()
  let section = parts.Get(4).Unwrap()
  if section == "replies" then
    ReplyRoute(settings, db, site, w, request, id)
    return
  end
  let actor = RequireMutation(settings, db, site, request)
  if actor.IsErr() then
    Fail(w, actor.UnwrapErr())
    return
  end
  let identity = actor.Unwrap()
  if section == "likes" then
    let reactions = storage.ReactionRepository{DB: db, SiteID: site.ID}
    var result: Result[(), String] = Err("not found")
    if request.Method == "POST" then
      result = reactions.Like(request.Context(), id, identity, false, "")
    end
    if request.Method == "DELETE" then
      result = reactions.Undo(request.Context(), id, identity, false)
    end
    Settle(w, result)
    return
  end
  if section == "import" && request.Method == "POST" then
    let posts = storage.PostRepository{DB: db, SiteID: site.ID}
    let imported = posts.Import(request.Context(), id, identity, false)
    if imported.IsErr() then
      Fail(w, imported.UnwrapErr())
    else
      WriteBrowserPost(db, site, w, request, 201, identity, imported.Unwrap())
    end
    return
  end
  if section == "hide" && (request.Method == "POST" || request.Method == "DELETE") then
    let feed = storage.FeedRepository{DB: db, SiteID: site.ID}
    let hidden = feed.SetHidden(request.Context(), id, request.Method == "POST", identity)
    Settle(w, hidden)
    return
  end
  WriteErrorJSON(w, 404, "not found")
end

func ReplyRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  id: String
) -> ()
  let feed = storage.FeedRepository{DB: db, SiteID: site.ID}
  if request.Method == "GET" then
    let _ = BrowserReadRoute(settings, db, site, w, request, Segments(request.URL.Path))
  else
    if request.Method == "POST" then
      let actor = RequireMutation(settings, db, site, request)
      if actor.IsErr() then
        Fail(w, actor.UnwrapErr())
        return
      end
      let parent = feed.ReadObject(request.Context(), id, actor.Unwrap(), false)
      if parent.IsErr() then
        Fail(w, parent.UnwrapErr())
        return
      end
      let input = ReplyInput{}
      let decoded = DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input))
      if decoded.IsErr() then
        WriteErrorJSON(w, 400, decoded.UnwrapErr())
        return
      end
      let mentions = ResolvePostMentions(request.Context(), settings, db, site, actor.Unwrap(), parent.Unwrap().CommunityID, input.Body, input.ContentFormat, false)
      if mentions.IsErr() then
        Fail(w, mentions.UnwrapErr())
        return
      end
      let published = PublishForumPost(settings, db,
        request.Context(),
        site,
        parent.Unwrap().CommunityID,
        actor.Unwrap(),
        false,
        storage.PublishInput{
          Title: "",
          Body: input.Body,
          ParentID: id,
          ContextURI: input.ContextURI,
          ContentFormat: input.ContentFormat,
          AttachmentIDs: input.AttachmentIDs,
          Mentions: mentions.Unwrap(),
        }
      )
      if published.IsErr() then
        Fail(w, published.UnwrapErr())
      else
        WriteBrowserPost(db, site, w, request, 201, actor.Unwrap(), published.Unwrap())
      end
    else
      MethodNotAllowed(w, "GET, POST")
    end
  end
end

func Settle(w: http.ResponseWriter, result: Result[(), String]) -> ()
  if result.IsErr() then
    Fail(w, result.UnwrapErr())
  else
    w.WriteHeader(204)
  end
end
