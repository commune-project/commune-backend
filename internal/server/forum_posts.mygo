package server

import http "go:net/http"
import json "go:encoding/json"
import time "go:time"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import auth "github.com/commune-project/commune-backend/internal/auth"
import federation "github.com/commune-project/commune-backend/internal/federation"
import failure "github.com/commune-project/commune-backend/internal/failure"

struct EditPostInput
  ExpectedVersion: Int64 `json:"expected_version"`
  Title: String `json:"title"`
  Body: String `json:"body"`
  ContentFormat: String `json:"content_format"`
  AttachmentIDs: Slice[String] `json:"attachment_ids"`
end

struct ReplyInput
  Body: String `json:"body"`
  ContextURI: String `json:"context_uri"`
  ContentFormat: String `json:"content_format"`
  AttachmentIDs: Slice[String] `json:"attachment_ids"`
end

struct VoteInput
  Score: json.RawMessage `json:"score"`
end

func PostRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> ()
  let id = parts.Get(3).UnwrapOr("")
  switch (parts.Len(), request.Method)
    case (4, "GET") => let _ = BrowserReadRoute(settings, db, site, w, request, parts)
    case (4, _) then
      switch RequireMutation(settings, db, site, request)
        case Err(reason) => FailFailure(w, reason)
        case Ok(actor) => PostMutation(settings, db, site, w, request, id, actor)
      end
    end
    case _ => PostSectionRoute(settings, db, site, w, request, parts, id)
  end
end
func PostMutation(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  id: String,
  identity: auth.Identity
) -> ()
  switch request.Method
    case "PATCH" then
      var input = Zero[EditPostInput]()
      let decoded = DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input))
      if decoded.IsErr() then
        WriteErrorJSON(w, 400, decoded.UnwrapErr().Render())
        return
      end
      if input.ExpectedVersion <= 0i64 then
        WriteErrorJSON(w, 400, "invalid expected version")
        return
      end
      let existing = storage.FeedRepository {
        DB: db,
        SiteID: site.ID,
      }.ReadObject(request.Context(), id, identity, false)
      if existing.IsErr() then
        FailFailure(w, existing.UnwrapErr())
        return
      end
      if existing.Unwrap().AuthorActorURI != identity.ActorURI then
        FailFailure(w, Of("forbidden"))
        return
      end
      let format = if input.ContentFormat == "" => existing.Unwrap().ContentFormat else input.ContentFormat
      let mentions = ResolvePostMentions(
        request.Context(),
        settings,
        db,
        site,
        identity,
        existing.Unwrap().CommunityID,
        input.Body,
        format,
        true
      )
      if mentions.IsErr() then
        FailFailure(w, mentions.UnwrapErr())
        return
      end
      var updated = Zero[storage.PostRecord]()
      let saved = storage.RunTransaction(
        request.Context(),
        db,
        func(tx: Ref[gorm.DB]) -> Result[(), failure.Failure]
          let result = storage.PostRepository {
            DB: tx,
            SiteID: site.ID,
          }.EditResolvedContent(
            request.Context(),
            id,
            identity,
            false,
            input.Title,
            input.Body,
            input.ContentFormat,
            input.AttachmentIDs,
            mentions.Unwrap(),
            !PostAttachmentIDsMissing(input.AttachmentIDs),
            input.ExpectedVersion,
            settings.Rendering.Sanitizer
          )
          if result.IsErr() then
            return Err(result.UnwrapErr())
          end
          updated = result.Unwrap()
          QueuePostMutation(request.Context(), settings, tx, site, updated, "Update")
        end
      )
      let edited = saved.MapWithOk(updated)
      if edited.IsErr() then
        FailFailure(w, edited.UnwrapErr())
        return
      end
      WriteBrowserPost(settings.Rendering.Sanitizer, db, site, w, request, 200, identity, edited.Unwrap())
    end
    case "DELETE" then
      let deleted = storage.RunTransaction(
        request.Context(),
        db,
        func(tx: Ref[gorm.DB]) -> Result[(), failure.Failure]
          let removed = storage.PostRepository {
            DB: tx,
            SiteID: site.ID,
          }.Delete(request.Context(), id, identity, false)
          if removed.IsErr() then
            return removed
          end
          let loaded = storage.LoadObjectByID(request.Context(), tx, id)
          if loaded.IsErr() || loaded.Unwrap().IsNone() then
            return Err(Of("post unavailable"))
          end
          QueuePostMutation(request.Context(), settings, tx, site, loaded.Unwrap().Unwrap(), "Delete")
        end
      )
      if deleted.IsErr() then
        FailFailure(w, deleted.UnwrapErr())
        return
      end
      w.WriteHeader(204)
    end
    case _ => MethodNotAllowed(w, "GET, PATCH, DELETE")
  end
end
func PostSectionRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String],
  id: String
) -> ()
  let section = parts.Get(4).Unwrap()
  if section == "replies" then
    ReplyRoute(settings, db, site, w, request, id)
    return
  end
  if section == "vote" && request.Method != "POST" then
    MethodNotAllowed(w, "POST")
    return
  end
  if section == "likes" && request.Method != "POST" && request.Method != "DELETE" then
    MethodNotAllowed(w, "POST, DELETE")
    return
  end
  WithActor(
    settings,
    db,
    site,
    w,
    request,
    func(identity: auth.Identity) -> Result[(), failure.Failure]
      if (section == "save" && (request.Method == "POST" || request.Method == "DELETE")) ||
        (section == "read" && request.Method == "POST") ||
        (section == "hide-for-me" && (request.Method == "POST" || request.Method == "DELETE")) then
        let readable = storage.FeedRepository { DB: db, SiteID: site.ID }.ReadObject(
          request.Context(),
          id,
          identity,
          false
        )
        if readable.IsErr() then
          return Err(readable.UnwrapErr())
        end
        if readable.Unwrap().DeletedAt.Valid then
          return Err(Of("not found"))
        end
        let state = storage.ContentStateRepository {
          DB: db,
          SiteID: site.ID,
          AccountID: identity.AccountID,
        }
        let result = switch section
          case "save" => state.Save(request.Context(), id, request.Method == "POST")
          case "read" => state.Read(request.Context(), id)
          case _ => state.Hide(request.Context(), id, request.Method == "POST")
        end
        Settle(w, result)
        return Ok(())
      end
      if section == "vote" then
        var input = Zero[VoteInput]()
        if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
          WriteErrorJSON(w, 400, "invalid vote")
          return Ok(())
        end
        let score = ParseVoteValue(input.Score)
        if score.IsErr() then
          WriteErrorJSON(w, 400, "invalid vote")
          return Ok(())
        end
        Settle(w, ApplyLocalVote(request.Context(), settings, db, site, id, identity, score.Unwrap()))
        return Ok(())
      end
      if section == "likes" then
        let score = if request.Method == "POST" => 1 else 0
        Settle(w, ApplyLocalVote(request.Context(), settings, db, site, id, identity, score))
        return Ok(())
      end
      if section == "import" && request.Method == "POST" then
        let posts = storage.PostRepository { DB: db, SiteID: site.ID }
        let imported = posts.Import(request.Context(), id, identity, false)
        if imported.IsErr() then
          return Err(imported.UnwrapErr())
        end
        WriteBrowserPost(
          settings.Rendering.Sanitizer,
          db,
          site,
          w,
          request,
          201,
          identity,
          imported.Unwrap()
        )
        return Ok(())
      end
      if section == "hide" && (request.Method == "POST" || request.Method == "DELETE") then
        let feed = storage.FeedRepository { DB: db, SiteID: site.ID }
        Settle(w, feed.SetHidden(request.Context(), id, request.Method == "POST", identity))
        return Ok(())
      end
      WriteErrorJSON(w, 404, "not found")
      Ok(())
    end
  )
end

func ReplyRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  id: String
) -> ()
  let feed = storage.FeedRepository { DB: db, SiteID: site.ID }
  if request.Method == "GET" then
    let _ = BrowserReadRoute(settings, db, site, w, request, Segments(request.URL.Path))
    return
  end
  if request.Method != "POST" then
    MethodNotAllowed(w, "GET, POST")
    return
  end
  WithActor(
    settings,
    db,
    site,
    w,
    request,
    func(actor: auth.Identity) -> Result[(), failure.Failure]
      let parent = feed.ReadObject(request.Context(), id, actor, false)
      if parent.IsErr() then
        return Err(parent.UnwrapErr())
      end
      let communityBan = storage.ActiveCommunityBan(
        request.Context(),
        db,
        parent.Unwrap().CommunityID,
        actor.ActorURI,
        time.Now()
      )
      let siteBan = storage.ActiveSiteBan(request.Context(), db, site.ID, actor.ActorURI, time.Now())
      if communityBan.IsErr() || siteBan.IsErr() then
        return Err(Of("moderation unavailable"))
      end
      if communityBan.Unwrap() || siteBan.Unwrap() then
        return Err(Of("forbidden"))
      end
      let blocked = storage.IsInteractionBlocked(
        request.Context(),
        db,
        site.ID,
        parent.Unwrap().AuthorActorURI,
        actor.ActorURI
      )
      if blocked.IsErr() then
        return Err(blocked.UnwrapErr())
      end
      if blocked.Unwrap() then
        return Err(Of("forbidden"))
      end
      var input = Zero[ReplyInput]()
      let decoded = DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input))
      if decoded.IsErr() then
        WriteErrorJSON(w, 400, decoded.UnwrapErr().Render())
        return Ok(())
      end
      let mentions = ResolvePostMentions(
        request.Context(),
        settings,
        db,
        site,
        actor,
        parent.Unwrap().CommunityID,
        input.Body,
        input.ContentFormat,
        false
      )
      if mentions.IsErr() then
        return Err(mentions.UnwrapErr())
      end
      let published = PublishForumPost(
        settings,
        db,
        request.Context(),
        site,
        parent.Unwrap().CommunityID,
        actor,
        false,
        storage.PublishInput {
          Title: "",
          Body: input.Body,
          ParentID: id,
          ContextURI: input.ContextURI,
          ContentFormat: input.ContentFormat,
          AttachmentIDs: input.AttachmentIDs,
          Mentions: mentions.Unwrap(),
        }
      )
      if published.IsErr() then
        return Err(published.UnwrapErr())
      end
      WriteBrowserPost(settings.Rendering.Sanitizer, db, site, w, request, 201, actor, published.Unwrap())
      Ok(())
    end
  )
end
func Settle(w: http.ResponseWriter, result: Result[(), failure.Failure]) -> ()
  if result.IsErr() then
    FailFailure(w, result.UnwrapErr())
  else
    w.WriteHeader(204)
  end
end
