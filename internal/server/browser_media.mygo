package server

import json "go:encoding/json"
import content "github.com/commune-project/commune-backend/internal/content"
import storage "github.com/commune-project/commune-backend/internal/storage"
import federation "github.com/commune-project/commune-backend/internal/federation"
import strings "go:strings"

struct PostAttachmentOutput
  URL: String `json:"url"`
  MediaType: String `json:"media_type"`
  Name: String `json:"name,omitempty"`
  PreviewURL: String `json:"preview_url,omitempty"`
end

func BrowserPostMedia(post: storage.PostRecord, local: Slice[content.RichMedia], restricted: Bool, cached: Slice[storage.PrivateMediaCache], output: PostOutput) -> Result[PostOutput, String]
  var result = output
  result.Attachments = local.Map(func(item: content.RichMedia) -> PostAttachmentOutput
    PostAttachmentOutput{URL: "/api/v1/media/" + item.BindingID, MediaType: item.MediaType, PreviewURL: if item.MediaType == "image/png" || item.MediaType == "image/jpeg" || item.MediaType == "image/gif" then "/api/v1/media/" + item.BindingID + "/preview" else "" end}
  end)
  if post.RichMetadata == "" then return Ok(result) end
  let metadata = federation.RichMetadata{}
  if json.Unmarshal(post.RichMetadata as Slice[Byte], Ref.new(metadata)).IsErr() then return Err("media unavailable") end
  var references: Slice[content.RemoteMediaReference] = []
  metadata.Attachment.Each(func(item: federation.RichAttachment) -> ()
    var target = item.URL
    if restricted then
      let matches = cached.Filter(func(row: storage.PrivateMediaCache) -> Bool row.PostID == post.ID && row.OriginURI == item.URL && row.ErrorState != "invalidated" end)
      target = if matches.Len() == 1 then "/api/v1/media/private/" + matches.Get(0).Unwrap().ID else "" end
    end
    if target != "" then
      let preview = if restricted && strings.HasPrefix(item.MediaType, "image/") then target + "/preview" else "" end
      references = references.Append(content.RemoteMediaReference{Origin: item.URL, URL: if preview != "" then preview else target end})
      result.Attachments = result.Attachments.Append(PostAttachmentOutput{URL: target, MediaType: item.MediaType, Name: item.Name, PreviewURL: preview})
    end
  end)
  if restricted then result.BodyHTML = content.RewritePrivateMedia(result.BodyHTML, references) end
  Ok(result)
end
