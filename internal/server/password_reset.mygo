package server

import http "go:net/http"
import base64 "go:encoding/base64"
import strconv "go:strconv"
import strings "go:strings"
import time "go:time"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import auth "github.com/commune-project/commune-backend/internal/auth"

struct PasswordResetRequestInput
  Email: String `json:"email"`
end

struct PasswordResetConfirmInput
  Token: String `json:"token"`
  Password: String `json:"password"`
end

struct PasswordChangeInput
  CurrentPassword: String `json:"current_password"`
  NewPassword: String `json:"new_password"`
end

func PasswordResetRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request]
) -> Bool
  let path = request.URL.Path
  if path != "/api/v1/auth/password/reset" && path != "/api/v1/auth/password/reset/confirm" && path != "/api/v1/auth/password/change" then
    return false
  end
  if request.Method != "POST" then
    MethodNotAllowed(w, "POST")
    return true
  end
  if !SameOrigin(settings, request) then
    WriteErrorJSON(w, 403, "origin denied")
    return true
  end
  let key = base64.StdEncoding.DecodeString(settings.Registration.OutboxSecret)
  if key.IsErr() || key.Unwrap().Len() != 32 then
    WriteErrorJSON(w, 503, "reset unavailable")
    return true
  end
  let repository = storage.PasswordResetRepository{
    DB: db,
    Site: site,
    EncryptionKey: key.Unwrap(),
    IPAttempts: settings.Registration.IPLimit,
    EmailAttempts: settings.Registration.EmailLimit,
    TokenTTLSeconds: settings.Registration.TokenTTLSeconds,
    RateWindowSeconds: settings.Registration.RateWindowSeconds,
  }
  if path == "/api/v1/auth/password/reset" then
    let input = PasswordResetRequestInput{}
    if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
      WriteErrorJSON(w, 400, "invalid reset request")
      return true
    end
    let ip = RegistrationClientIP(settings, request)
    if ip.IsErr() then
      WriteErrorJSON(w, 400, "invalid client address")
      return true
    end
    let result = repository.Request(request.Context(), input.Email, ip.Unwrap(), time.Now())
    if result.IsErr() then
      if result.UnwrapErr() == "reset rate limited" then
        w.Header().Set("Retry-After", strconv.Itoa(settings.Registration.RateWindowSeconds))
        WriteErrorJSON(w, 429, "reset rate limited")
      else if strings.HasPrefix(result.UnwrapErr(), "invalid ") then
        WriteErrorJSON(w, 400, result.UnwrapErr())
      else
        WriteErrorJSON(w, 503, "reset unavailable")
      end end
    else
      w.WriteHeader(202)
    end
    return true
  end
  if path == "/api/v1/auth/password/reset/confirm" then
    let input = PasswordResetConfirmInput{}
    if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
      WriteErrorJSON(w, 400, "invalid reset request")
      return true
    end
    let result = repository.Confirm(request.Context(), input.Token, input.Password, time.Now())
    if result.IsErr() then
      if strings.HasPrefix(result.UnwrapErr(), "invalid ") then
        WriteErrorJSON(w, 400, result.UnwrapErr())
      else
        WriteErrorJSON(w, 503, "reset unavailable")
      end
    else
      w.WriteHeader(204)
    end
    return true
  end
  let session = Authenticated(db, site, request)
  if session.IsErr() then
    Fail(w, session.UnwrapErr())
    return true
  end
  if !AuthorizeMutation(settings, session.Unwrap(), request) then
    WriteErrorJSON(w, 403, "CSRF denied")
    return true
  end
  let input = PasswordChangeInput{}
  if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
    WriteErrorJSON(w, 400, "invalid reset request")
    return true
  end
  let result = repository.Change(request.Context(), session.Unwrap().Identity, input.CurrentPassword, input.NewPassword)
  if result.IsErr() then
    if strings.HasPrefix(result.UnwrapErr(), "invalid ") then
      WriteErrorJSON(w, 400, result.UnwrapErr())
    else
      WriteErrorJSON(w, 503, "reset unavailable")
    end
    return true
  end
  let token = ReadSession(request)
  if token.IsOk() then
    let sessions = storage.SessionRepository{DB: db}
    let _ = sessions.RevokeOthers(request.Context(), site.ID, session.Unwrap().Identity.AccountID, auth.TokenHash(token.Unwrap()), time.Now())
  end
  w.WriteHeader(204)
  true
end
