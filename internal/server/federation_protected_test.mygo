package server

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import httptest "go:net/http/httptest"
import strings "go:strings"
import io "go:io"
import time "go:time"
import config "github.com/commune-project/commune-mygo/internal/config"
import storage "github.com/commune-project/commune-mygo/internal/storage"
import federation "github.com/commune-project/commune-mygo/internal/federation"
import testsupport "github.com/commune-project/commune-mygo/internal/testsupport"
import transport "go:github.com/commune-project/commune-mygo/internal/testtransport"

func signedGet(handler: http.HandlerFunc, origin: String, path: String, actorURI: String, privateKey: String, date: String) -> Ref[httptest.ResponseRecorder]
  let host = strings.TrimPrefix(origin, "https://")
  let signing = federation.GetSigningString("GET", path, host, date)
  let signature = federation.SignSignature(privateKey, signing).Unwrap()
  let header = federation.FormatGetSignatureHeader(actorURI + "#main-key", signature)
  let request = httptest.NewRequest("GET", origin + path, strings.NewReader("") as io.Reader)
  request.Header.Set("Accept", "application/activity+json")
  request.Header.Set("Date", date)
  request.Header.Set("Signature", header)
  let recorder = httptest.NewRecorder()
  handler.ServeHTTP(recorder as http.ResponseWriter, request)
  recorder
end

func TestPostgresProtectedMemberReads(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let a = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, a).Unwrap()
  let accounts = storage.AccountRepository{DB: db}
  let alice = accounts.Create(ctx, a, "alice", "", "alice-account-password").Unwrap()
  let communities = storage.CommunityRepository{DB: db, SiteID: a.ID}
  let posts = storage.PostRepository{DB: db, SiteID: a.ID}
  let restricted = communities.Create(ctx, a, alice, "restricted", "Restricted", "federated", "members", "members").Unwrap()
  let open = communities.Create(ctx, a, alice, "open", "Open", "federated", "eligible_users", "eligible_users").Unwrap()
  let private = posts.Publish(ctx, a, restricted.ID, alice, false, storage.PublishInput{Title: "Members", Body: "inside", ParentID: ""}).Unwrap()
  let public = posts.Publish(ctx, a, open.ID, alice, false, storage.PublishInput{Title: "Open", Body: "outside", ParentID: ""}).Unwrap()
  let memberKey = storage.GeneratePrivatePEM().Unwrap()
  let outsiderKey = storage.GeneratePrivatePEM().Unwrap()
  let instanceKey = storage.GeneratePrivatePEM().Unwrap()
  let member = "https://peer.example/users/member"
  let outsider = "https://peer.example/users/outsider"
  let instance = "https://peer.example/actor"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?, 'Person', ?), (?, 'Person', ?), (?, 'Person', ?)", member, storage.PublicPEMFromPrivate(memberKey).Unwrap(), outsider, storage.PublicPEMFromPrivate(outsiderKey).Unwrap(), instance, storage.PublicPEMFromPrivate(instanceKey).Unwrap())).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?)", restricted.ID, member, alice.ActorURI)).Unwrap()
  let handler = Handler(settings, db)
  let date = time.Now().UTC().Format(http.TimeFormat)
  let privatePath = "/objects/" + private.ID
  let publicPath = "/objects/" + public.ID
  if getAP(handler, a.Origin, privatePath, "application/activity+json").Code != 404 then
    t.Fatal("an unsigned read reached a member-readable object")
  end
  let memberRead = signedGet(handler, a.Origin, privatePath, member, memberKey, date)
  if memberRead.Code != 200 || !strings.Contains(memberRead.Body.String(), "inside") then
    t.Fatalf("a member could not read a member-readable object: %d %s", memberRead.Code, memberRead.Body.String())
  end
  if signedGet(handler, a.Origin, privatePath, outsider, outsiderKey, date).Code != 404 then
    t.Fatal("a signed non-member read reached a member-readable object")
  end
  if signedGet(handler, a.Origin, privatePath, instance, instanceKey, date).Code != 404 then
    t.Fatal("an instance key without member delegation reached a member-readable object")
  end
  if signedGet(handler, a.Origin, privatePath, instance, memberKey, date).Code != 404 then
    t.Fatal("a key that does not belong to the named actor was accepted")
  end
  if getAP(handler, a.Origin, publicPath, "application/activity+json").Code != 200 then
    t.Fatal("an openly readable object required a signature")
  end
  let openPath = "/communities/restricted/outbox"
  if getAP(handler, a.Origin, openPath, "application/activity+json").Code != 404 then
    t.Fatal("an unsigned read reached a member-readable collection")
  end
  let memberOutbox = signedGet(handler, a.Origin, openPath, member, memberKey, date)
  if memberOutbox.Code != 200 || !strings.Contains(memberOutbox.Body.String(), "\"totalItems\":1") then
    t.Fatalf("a member could not read the protected collection: %d %s", memberOutbox.Code, memberOutbox.Body.String())
  end
  if signedGet(handler, a.Origin, openPath, outsider, outsiderKey, date).Code != 404 then
    t.Fatal("a signed non-member read reached a member-readable collection")
  end
  if signedGet(handler, a.Origin, "/communities/open/outbox", member, memberKey, date).Code != 200 then
    t.Fatal("an openly readable collection rejected a signed member read")
  end
end
