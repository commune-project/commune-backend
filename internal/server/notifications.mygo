package server

import http "go:net/http"
import strconv "go:strconv"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"

struct NotificationCountOutput
  Count: Int64 `json:"count"`
end

struct NotificationReadAllInput
  ThroughCursor: String `json:"through_cursor"`
end

# Main dispatch calls this before BrowserReadRoute and mutation routing.
func NotificationRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  if parts.Get(2).UnwrapOr("") != "notifications" then
    return false
  end
  w.Header().Set("Cache-Control", "no-store")
  let section = parts.Get(3).UnwrapOr("")
  let list = parts.Len() == 3
  let count = parts.Len() == 4 && section == "unread-count"
  let all = parts.Len() == 4 && section == "read-all"
  let single = parts.Len() == 5 && parts.Get(4).UnwrapOr("") == "read"
  if !list && !count && !all && !single then
    WriteErrorJSON(w, 404, "not found")
    return true
  end
  let method = if list || count then
    "GET"
  else
    "POST"
  end
  if request.Method != method then
    MethodNotAllowed(w, method)
    return true
  end
  WithSession(db, site, w, request, func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
    if method == "POST" && !AuthorizeMutation(settings, session, request) then
      WriteErrorJSON(w, 403, "CSRF denied")
      return Ok(())
    end
    let repository = storage.BrowserRepository { DB: db, SiteID: site.ID }
    let viewer = repository.Viewer(request.Context(), session.Identity)
    if viewer.IsErr() then
      return Err(viewer.UnwrapErr())
    end
    if list then
      let page = PageFromQuery(settings, request)
      if page.IsErr() then
        return Err(page.UnwrapErr())
      end
      switch repository.Notifications(request.Context(), viewer.Unwrap(), page.Unwrap(), settings.Runtime.MaxPageSize)
        case Err(reason) => return Err(reason)
        case Ok(rows) then
          WriteJSON(w, 200, rows)
          Ok(())
        end
      end
    elsif count then
      switch repository.NotificationUnreadCount(request.Context(), viewer.Unwrap())
        case Err(reason) => return Err(reason)
        case Ok(unread) then
          WriteJSON(w, 200, NotificationCountOutput { Count: unread })
          Ok(())
        end
      end
    elsif all then
      var input = Zero[NotificationReadAllInput]()
      switch DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input))
        case Err(reason) then
          WriteErrorJSON(w, 400, reason.Render())
          Ok(())
        end
        case Ok(_) then
          let cursor = storage.ParseNotificationCursor(input.ThroughCursor)
          if cursor.IsErr() then
            WriteErrorJSON(w, 400, "invalid cursor")
            return Ok(())
          end
          switch repository.ReadAllNotifications(request.Context(), viewer.Unwrap(), cursor.Unwrap())
            case Err(reason) => return Err(reason)
            case Ok(_) then
              w.WriteHeader(204)
              Ok(())
            end
          end
        end
      end
    else
      let id = strconv.ParseInt(section, 10, 64)
      if id.IsErr() || id.Unwrap() <= 0i64 then
        WriteErrorJSON(w, 400, "invalid notification")
        return Ok(())
      end
      switch repository.ReadNotification(request.Context(), viewer.Unwrap(), id.Unwrap())
        case Err(reason) => return Err(reason)
        case Ok(_) then
          w.WriteHeader(204)
          Ok(())
        end
      end
    end
  end)
  true
end
