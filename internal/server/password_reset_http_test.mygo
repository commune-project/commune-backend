package server

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import httptest "go:net/http/httptest"
import io "go:io"
import strings "go:strings"
import time "go:time"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import auth "github.com/commune-project/commune-backend/internal/auth"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func resetHTTPToken(t: Ref[testing.T], db: Ref[gorm.DB], siteID: String, origin: String) -> String
  let job = Zero[storage.ResetMailJob]()
  let query = db.Table("password_reset_mail_jobs AS j").Select("j.*").Joins(
    "JOIN password_reset_tokens t ON t.id=j.reset_id"
  ).Where("t.site_id=? AND t.consumed_at IS NULL", siteID).Order("t.created_at DESC").Limit(1).Find(Ref.new(job))
  if storage.MutationResult(query).IsErr() || query.RowsAffected != 1i64 then
    t.Fatal("reset mail job missing")
  end
  let key = strings.Repeat("k", 32) as Slice[Byte]
  let link = auth.OpenPasswordReset(key, job.EncryptedPayload)
  if link.IsErr() then
    t.Fatal("reset mail payload could not be opened")
  end
  strings.TrimPrefix(link.Unwrap(), origin + "/reset-password#token=")
end

func TestPostgresPasswordResetHTTP(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  var settings = registrationSettings()
  settings.Sites = settings.Sites.Map(func(site: config.Site) -> config.Site
    var disabledRegistration = site
    disabledRegistration.RegistrationEnabled = false
    disabledRegistration
  end)
  let site = settings.Sites.Get(0).Unwrap()
  let other = settings.Sites.Get(1).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, other).Unwrap()
  let _ = storage.AccountRepository{DB: db}.Create(ctx, site, "alice", "alice@example.org", "alice-password").Unwrap()
  let _ = storage.AccountRepository{DB: db}.Create(ctx, site, "bob", "bob@example.org", "bob-password").Unwrap()
  let handler = Handler(settings, db)
  let resetPath = "/api/v1/auth/password/reset"
  let known = registrationRequest(handler, site.Origin, resetPath, `{"email":" Alice@Example.org "}`, "198.51.100.30:1234", "")
  let unknown = registrationRequest(handler, site.Origin, resetPath, `{"email":"unknown@example.org"}`, "198.51.100.30:1234", "")
  if known.Code != 202 || unknown.Code != 202 || known.Body.String() != unknown.Body.String() ||
    known.Header().Get("Cache-Control") != "no-store" then
    t.Fatal("reset request was not generic or no-store")
  end
  let invalid = registrationRequest(handler, site.Origin, resetPath, `{"email":"not-an-email"}`, "198.51.100.30:1234", "")
  if invalid.Code != 400 then
    t.Fatal("invalid reset address was accepted")
  end
  let request = httptest.NewRequest("POST", site.Origin + resetPath, strings.NewReader(`{"email":"alice@example.org"}`) as io.Reader)
  request.Header.Set("Origin", "https://foreign.example")
  request.Header.Set("Content-Type", "application/json")
  request.RemoteAddr = "198.51.100.30:1234"
  let foreign = httptest.NewRecorder()
  handler.ServeHTTP(foreign as http.ResponseWriter, request)
  if foreign.Code != 403 then
    t.Fatal("foreign-origin reset request was accepted")
  end
  let token = resetHTTPToken(t, db, site.ID, site.Origin)
  if token == "" then t.Fatal("reset token extraction failed") end
  let confirmPath = "/api/v1/auth/password/reset/confirm"
  if registrationRequest(handler, other.Origin, confirmPath, `{"token":"` + token + `","password":"new-password"}`, "198.51.100.30:1234", "").Code != 400 then
    t.Fatal("cross-site reset token was accepted")
  end
  if registrationRequest(handler, site.Origin, confirmPath, `{"token":"` + token + `","password":"short"}`, "198.51.100.30:1234", "").Code != 400 then
    t.Fatal("invalid reset password was accepted")
  end
  if registrationRequest(handler, site.Origin, confirmPath, `{"token":"` + token + `","password":"new-password"}`, "198.51.100.30:1234", "").Code != 204 then
    t.Fatal("valid reset confirmation failed")
  end
  if registrationRequest(handler, site.Origin, confirmPath, `{"token":"` + token + `","password":"second-password"}`, "198.51.100.30:1234", "").Code != 400 then
    t.Fatal("consumed reset token was reused")
  end
  if doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: "/api/v1/auth/login", Payload: `{"login":"alice","password":"alice-password"}`, Cookies: [], CSRF: "", Source: site.Origin}).Code != 401 ||
    doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: "/api/v1/auth/login", Payload: `{"login":"alice","password":"alice-password"}`, Cookies: [], CSRF: "", Source: site.Origin}).Code != 200 then
    t.Fatal("reset did not replace the login password")
  end
  let bobCookies = login(handler, site.Origin, "bob", "bob-password")
  let bobCSRF = csrfOf(bobCookies)
  let otherBob = login(handler, site.Origin, "bob", "bob-password")
  let changePath = "/api/v1/auth/password/change"
  if doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: changePath, Payload: `{"current_password":"wrong","new_password":"bob-new-password"}`, Cookies: bobCookies, CSRF: bobCSRF, Source: site.Origin}).Code != 400 then
    t.Fatal("wrong current password was accepted")
  end
  if doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: changePath, Payload: `{"current_password":"bob-password","new_password":"bob-new-password"}`, Cookies: bobCookies, CSRF: "", Source: site.Origin}).Code != 403 then
    t.Fatal("password change without CSRF was accepted")
  end
  if doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: changePath, Payload: `{"current_password":"bob-password","new_password":"bob-new-password"}`, Cookies: bobCookies, CSRF: bobCSRF, Source: site.Origin}).Code != 204 then
    t.Fatal("authenticated password change failed")
  end
  if doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/auth/session", Payload: "", Cookies: bobCookies, CSRF: "", Source: ""}).Code != 200 ||
    doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/auth/session", Payload: "", Cookies: otherBob, CSRF: "", Source: ""}).Code != 401 then
    t.Fatal("password change did not preserve only the current session")
  end
end

func TestPostgresPasswordResetHTTPRateLimit(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  var settings = registrationSettings()
  settings.Registration.IPLimit = 1
  settings.Registration.EmailLimit = 10
  settings.Registration.RateWindowSeconds = 90
  let site = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let _ = storage.AccountRepository{DB: db}.Create(ctx, site, "alice", "alice@example.org", "alice-password").Unwrap()
  let handler = Handler(settings, db)
  let path = "/api/v1/auth/password/reset"
  let first = registrationRequest(handler, site.Origin, path, `{"email":"alice@example.org"}`, "198.51.100.40:1234", "")
  let limited = registrationRequest(handler, site.Origin, path, `{"email":"alice@example.org"}`, "198.51.100.40:1234", "")
  if first.Code != 202 || limited.Code != 429 || limited.Header().Get("Retry-After") != "90" then
    t.Fatal("reset IP rate limit or Retry-After was incorrect")
  end
end
