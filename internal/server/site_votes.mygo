package server

import http "go:net/http"
import json "go:encoding/json"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import auth "github.com/commune-project/commune-backend/internal/auth"
import failure "github.com/commune-project/commune-backend/internal/failure"

struct SiteVoteSettingsOutput
  UpvotesEnabled: Bool `json:"upvotes_enabled"`
  DownvotesEnabled: Bool `json:"downvotes_enabled"`
end

struct SiteVoteSettingsPatch
  UpvotesEnabled: json.RawMessage `json:"upvotes_enabled"`
  DownvotesEnabled: json.RawMessage `json:"downvotes_enabled"`
end

impl SiteVoteSettingsOutput
  func FromFlags(up: Bool, down: Bool) -> SiteVoteSettingsOutput
    SiteVoteSettingsOutput { UpvotesEnabled: up, DownvotesEnabled: down }
  end
end

func SiteVoteRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  let resource = parts.Get(2).UnwrapOr("")
  let admin = resource == "admin"
  if (resource != "site" && !admin) ||
    parts.Len() != 4 ||
    parts.Get(3).UnwrapOr("") != "vote-settings" then
    return false
  end
  w.Header().Set("Cache-Control", "no-store")
  if !admin then
    if request.Method != "GET" then
      MethodNotAllowed(w, "GET")
      return true
    end
    let up = storage.SiteVoteUpEnabled(request.Context(), db, site.ID)
    let down = storage.SiteVoteDownEnabled(request.Context(), db, site.ID)
    WriteJSON(w, 200, SiteVoteSettingsOutput.FromFlags(up, down))
    return true
  end
  if request.Method != "PUT" then
    MethodNotAllowed(w, "PUT")
    return true
  end
  WithActor(settings, db, site, w, request, func(actor: auth.Identity) -> Result[(), failure.Failure]
    var patch = Zero[SiteVoteSettingsPatch]()
    switch DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(patch))
      case Err(_) then
        WriteErrorJSON(w, 400, "invalid vote settings")
        Ok(())
      end
      case Ok(_) then
        let hasUp = (patch.UpvotesEnabled as Slice[Byte]).Len() > 0
        let hasDown = (patch.DownvotesEnabled as Slice[Byte]).Len() > 0
        if !hasUp && !hasDown then
          WriteErrorJSON(w, 400, "invalid vote settings")
          return Ok(())
        end
        var up = false
        var down = false
        if hasUp && json.Unmarshal(patch.UpvotesEnabled as Slice[Byte], Ref.new(up)).IsErr() then
          WriteErrorJSON(w, 400, "invalid vote settings")
          return Ok(())
        end
        if hasDown && json.Unmarshal(patch.DownvotesEnabled as Slice[Byte], Ref.new(down)).IsErr() then
          WriteErrorJSON(w, 400, "invalid vote settings")
          return Ok(())
        end
        switch storage.UpdateSiteVoteSettings(request.Context(), db, site.ID, actor, up, down, hasUp, hasDown)
          case Err(reason) => return Err(reason)
          case Ok(_) then
            let savedUp = storage.SiteVoteUpEnabled(request.Context(), db, site.ID)
            let savedDown = storage.SiteVoteDownEnabled(request.Context(), db, site.ID)
            WriteJSON(w, 200, SiteVoteSettingsOutput.FromFlags(savedUp, savedDown))
            Ok(())
          end
        end
      end
    end
  end)
  true
end
