package server

import net "go:net"
import smtp "go:net/smtp"
import tls "go:crypto/tls"
import time "go:time"
import strconv "go:strconv"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"

func SendVerificationSMTP(settings: config.SMTP, recipient: String, link: String) -> Result[(), String]
  if strings.ContainsAny(recipient + settings.From, "\r\n") then
    return Err("invalid mail address")
  end
  let address = net.JoinHostPort(settings.Host, strconv.Itoa(settings.Port))
  let timeout = settings.TimeoutSeconds as time.Duration * time.Second
  var connection: Result[net.Conn, String] = Err("smtp unavailable")
  if settings.TLSMode == "tls" then
    let dialer = net.Dialer{Timeout: timeout}
    let security = tls.Config{ServerName: settings.Host, MinVersion: tls.VersionTLS12 as UInt16}
    let secured = tls.DialWithDialer(Ref.new(dialer), "tcp", address, Ref.new(security))
    if secured.IsOk() then
      connection = Ok(secured.Unwrap() as net.Conn)
    end
  else
    let plain = net.DialTimeout("tcp", address, timeout)
    if plain.IsOk() then
      connection = Ok(plain.Unwrap())
    end
  end
  if connection.IsErr() then
    return Err("smtp unavailable")
  end
  let socket = connection.Unwrap()
  let _ = socket.SetDeadline(time.Now().Add(timeout))
  let client = smtp.NewClient(socket, settings.Host)
  if client.IsErr() then
    let _ = socket.Close()
    return Err("smtp unavailable")
  end
  let mailer = client.Unwrap()
  go[()] { code: "defer {mailer}.Close()"; in mailer = mailer }
  if settings.TLSMode == "starttls" then
    let security = tls.Config{ServerName: settings.Host, MinVersion: tls.VersionTLS12 as UInt16}
    if mailer.StartTLS(Ref.new(security)).IsErr() then
      return Err("smtp TLS unavailable")
    end
  end
  if settings.Username != "" then
    if settings.TLSMode == "test" || mailer.Auth(smtp.PlainAuth("", settings.Username, settings.Password, settings.Host)).IsErr() then
      return Err("smtp authentication failed")
    end
  end
  if mailer.Mail(settings.From).IsErr() || mailer.Rcpt(recipient).IsErr() then
    return Err("smtp recipient unavailable")
  end
  let output = mailer.Data()
  if output.IsErr() then
    return Err("smtp unavailable")
  end
  let message = "From: " + settings.From + "\r\nTo: " + recipient + "\r\nSubject: Verify your Commune email\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\nComplete registration and choose your password:\r\n" + link + "\r\n"
  let written = output.Unwrap().Write(message as Slice[Byte])
  let closed = output.Unwrap().Close()
  if written.IsErr() || closed.IsErr() then
    return Err("smtp unavailable")
  end
  let _ = mailer.Quit()
  Ok(())
end

func SendPasswordResetSMTP(settings: config.SMTP, recipient: String, link: String) -> Result[(), String]
  if strings.ContainsAny(recipient + settings.From, "\r\n") then
    return Err("invalid mail address")
  end
  let address = net.JoinHostPort(settings.Host, strconv.Itoa(settings.Port))
  let timeout = settings.TimeoutSeconds as time.Duration * time.Second
  var connection: Result[net.Conn, String] = Err("smtp unavailable")
  if settings.TLSMode == "tls" then
    let dialer = net.Dialer{Timeout: timeout}
    let security = tls.Config{ServerName: settings.Host, MinVersion: tls.VersionTLS12 as UInt16}
    let secured = tls.DialWithDialer(Ref.new(dialer), "tcp", address, Ref.new(security))
    if secured.IsOk() then
      connection = Ok(secured.Unwrap() as net.Conn)
    end
  else
    let plain = net.DialTimeout("tcp", address, timeout)
    if plain.IsOk() then
      connection = Ok(plain.Unwrap())
    end
  end
  if connection.IsErr() then
    return Err("smtp unavailable")
  end
  let socket = connection.Unwrap()
  let _ = socket.SetDeadline(time.Now().Add(timeout))
  let client = smtp.NewClient(socket, settings.Host)
  if client.IsErr() then
    let _ = socket.Close()
    return Err("smtp unavailable")
  end
  let mailer = client.Unwrap()
  go[()] { code: "defer {mailer}.Close()"; in mailer = mailer }
  if settings.TLSMode == "starttls" then
    let security = tls.Config{ServerName: settings.Host, MinVersion: tls.VersionTLS12 as UInt16}
    if mailer.StartTLS(Ref.new(security)).IsErr() then
      return Err("smtp TLS unavailable")
    end
  end
  if settings.Username != "" then
    if settings.TLSMode == "test" || mailer.Auth(smtp.PlainAuth("", settings.Username, settings.Password, settings.Host)).IsErr() then
      return Err("smtp authentication failed")
    end
  end
  if mailer.Mail(settings.From).IsErr() || mailer.Rcpt(recipient).IsErr() then
    return Err("smtp recipient unavailable")
  end
  let output = mailer.Data()
  if output.IsErr() then
    return Err("smtp unavailable")
  end
  let message = "From: " + settings.From + "\r\nTo: " + recipient + "\r\nSubject: Reset your Commune password\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\n\r\nChoose a new password:\r\n" + link + "\r\n"
  let written = output.Unwrap().Write(message as Slice[Byte])
  let closed = output.Unwrap().Close()
  if written.IsErr() || closed.IsErr() then
    return Err("smtp unavailable")
  end
  let _ = mailer.Quit()
  Ok(())
end
