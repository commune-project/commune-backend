package server

import testing "go:testing"
import context "go:context"
import json "go:encoding/json"
import httptest "go:net/http/httptest"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func mentionOutputFor(items: Slice[MentionCandidateOutput], actorURI: String) -> Option[MentionCandidateOutput]
  items.Filter(func(item: MentionCandidateOutput) -> Bool
    item.ActorURI == actorURI
  end).Get(0)
end

func assertMentionCandidateHeaders(t: Ref[testing.T], response: Ref[httptest.ResponseRecorder]) -> ()
  if response.Header().Get("Cache-Control") != "no-store" ||
    response.Header().Get("Referrer-Policy") != "no-referrer" then
    t.Fatal("mention candidate response headers missing")
  end
end

func TestMentionCandidatesRoute(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let site = settings.Sites.Get(0).Unwrap()
  let other = settings.Sites.Get(1).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, other).Unwrap()
  let accounts = storage.AccountRepository{DB: db}
  let _ = accounts.Create(ctx, site, "alice", "", "alice-password").Unwrap()
  let bob = accounts.Create(ctx, site, "bob", "", "bob-password").Unwrap()
  let rainbow = accounts.Create(ctx, site, "rainbow", "", "rainbow-password").Unwrap()
  let carol = accounts.Create(ctx, other, "carol", "", "carol-password").Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO profiles(actor_uri,display_name,avatar_url) VALUES (?,?,?)", bob.ActorURI, "Bobby", "https://forum-a.example/avatar/bob.png")).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO profiles(actor_uri,display_name) VALUES (?,?)", rainbow.ActorURI, "O'Brien Rainbow 100%Real")).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO profiles(actor_uri,display_name) VALUES (?,?)", carol.ActorURI, "Bonnie")).Unwrap()
  let remyURI = "https://remote.example/users/remy"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,inbox_uri,acct) VALUES (?,'Person',?,?)", remyURI, "https://remote.example/inbox", "remy@remote.example")).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO profiles(actor_uri,display_name,avatar_url) VALUES (?,?,?)", remyURI, "Remy", "https://remote.example/avatar/remy.png")).Unwrap()
  let handler = Handler(settings, db)
  let cookies = login(handler, site.Origin, "alice", "alice-password")
  let anonymous = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo", Payload: "", Cookies: [], CSRF: "", Source: site.Origin})
  if anonymous.Code != 401 then
    t.Fatalf("anonymous candidate lookup returned %d", anonymous.Code)
  end
  assertMentionCandidateHeaders(t, anonymous)
  let invalid: Slice[String] = [
    "/api/v1/mentions/candidates?q=a",
    "/api/v1/mentions/candidates?q=" + strings.Repeat("a", 65),
    "/api/v1/mentions/candidates?q=bo&limit=0",
    "/api/v1/mentions/candidates?q=bo&limit=21",
    "/api/v1/mentions/candidates?q=bo&limit=abc",
  ]
  invalid.Each(func(path: String) -> ()
    let response = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: path, Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
    if response.Code != 400 then
      t.Fatalf("invalid candidate request %s returned %d", path, response.Code)
    end
    assertMentionCandidateHeaders(t, response)
  end)
  let method = doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo", Payload: "", Cookies: cookies, CSRF: csrfOf(cookies), Source: site.Origin})
  if method.Code != 405 || method.Header().Get("Allow") != "GET" then
    t.Fatalf("candidate method validation returned %d", method.Code)
  end
  assertMentionCandidateHeaders(t, method)
  var jobsBefore: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("actor_handle_jobs").Count(Ref.new(jobsBefore))).Unwrap()
  var notificationsBefore: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("notification_events").Count(Ref.new(notificationsBefore))).Unwrap()
  var deliveriesBefore: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("delivery_jobs").Count(Ref.new(deliveriesBefore))).Unwrap()
  let valid = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  if valid.Code != 200 then
    t.Fatalf("candidate lookup returned %d: %s", valid.Code, valid.Body.String())
  end
  assertMentionCandidateHeaders(t, valid)
  let page = Zero[MentionCandidatePage]()
  let _ = json.Unmarshal(valid.Body.Bytes(), Ref.new(page)).Unwrap()
  if page.Items.Len() != 3 ||
    page.Items.Get(0).Unwrap().ActorURI != bob.ActorURI ||
    page.Items.Get(1).Unwrap().ActorURI != carol.ActorURI ||
    page.Items.Get(2).Unwrap().ActorURI != rainbow.ActorURI then
    t.Fatalf("candidate projection or ordering failed: %s", valid.Body.String())
  end
  let bobOutput = mentionOutputFor(page.Items, bob.ActorURI).Unwrap()
  if bobOutput.Acct != "bob@forum-a.example" || bobOutput.DisplayName != "Bobby" || bobOutput.Avatar != "https://forum-a.example/avatar/bob.png" then
    t.Fatal("local candidate DTO failed")
  end
  let carolOutput = mentionOutputFor(page.Items, carol.ActorURI).Unwrap()
  if carolOutput.Acct != "carol@forum-b.example" || carolOutput.DisplayName != "Bonnie" then
    t.Fatal("colocated candidate DTO failed")
  end
  let remote = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=rem", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  if remote.Code != 200 then
    t.Fatalf("remote candidate lookup returned %d", remote.Code)
  end
  let remotePage = Zero[MentionCandidatePage]()
  let _ = json.Unmarshal(remote.Body.Bytes(), Ref.new(remotePage)).Unwrap()
  let remyOutput = mentionOutputFor(remotePage.Items, remyURI).Unwrap()
  if remyOutput.Acct != "remy@remote.example" || remyOutput.DisplayName != "Remy" || remyOutput.Avatar != "https://remote.example/avatar/remy.png" then
    t.Fatal("remote candidate DTO failed")
  end
  let withoutCommunity = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  let withCommunity = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo&community_id=missing", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  if withCommunity.Code != 200 || withCommunity.Body.String() != withoutCommunity.Body.String() then
    t.Fatal("optional community_id changed candidate results")
  end
  let empty = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=zzzz", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  if empty.Code != 200 || !strings.Contains(empty.Body.String(), "\"items\":[]") then
    t.Fatalf("empty candidate response failed: %s", empty.Body.String())
  end
  var jobsAfter: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("actor_handle_jobs").Count(Ref.new(jobsAfter))).Unwrap()
  var notificationsAfter: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("notification_events").Count(Ref.new(notificationsAfter))).Unwrap()
  var deliveriesAfter: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("delivery_jobs").Count(Ref.new(deliveriesAfter))).Unwrap()
  if jobsAfter != jobsBefore || notificationsAfter != notificationsBefore || deliveriesAfter != deliveriesBefore then
    t.Fatal("candidate route wrote federation or notification state")
  end
  let _ = storage.MutationResult(db.Exec("DROP TABLE profiles CASCADE")).Unwrap()
  let unavailable = doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: "/api/v1/mentions/candidates?q=bo", Payload: "", Cookies: cookies, CSRF: "", Source: site.Origin})
  if unavailable.Code != 503 then
    t.Fatalf("candidate storage failure returned %d", unavailable.Code)
  end
  assertMentionCandidateHeaders(t, unavailable)
end
