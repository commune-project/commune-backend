package server

import context "go:context"
import http "go:net/http"
import strings "go:strings"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import auth "github.com/commune-project/commune-backend/internal/auth"
import content "github.com/commune-project/commune-backend/internal/content"
import failure "github.com/commune-project/commune-backend/internal/failure"

struct CommunityViewerOutput
  IsMember: Bool `json:"is_member"`
  IsCreator: Bool `json:"is_creator"`
  IsManager: Bool `json:"is_manager"`
  ManagementScope: String `json:"management_scope"`
  IsFollowing: Bool `json:"is_following"`
  FollowState: String `json:"follow_state"`
  CanFollow: Bool `json:"can_follow"`
end

struct CommunityPermissions
  CanPost: Bool `json:"can_post"`
  CanManage: Bool `json:"can_manage"`
  CanManageMembers: Bool `json:"can_manage_members"`
  CanManageManagers: Bool `json:"can_manage_managers"`
end

struct PostPermissions
  CanEdit: Bool `json:"can_edit"`
  CanDelete: Bool `json:"can_delete"`
  CanLike: Bool `json:"can_like"`
  CanVote: Bool `json:"can_vote"`
  CanUpvote: Bool `json:"can_upvote"`
  CanDownvote: Bool `json:"can_downvote"`
  CanReply: Bool `json:"can_reply"`
  CanHide: Bool `json:"can_hide"`
  CanSave: Bool `json:"can_save"`
  CanHideForMe: Bool `json:"can_hide_for_me"`
  CanModerate: Bool `json:"can_moderate"`
end

struct CommunityPage
  Items: Slice[CommunityOutput] `json:"items"`
  Limit: Int `json:"limit"`
  Offset: Int `json:"offset"`
end

struct RosterPage
  Items: Slice[storage.RosterEntry] `json:"items"`
  Limit: Int `json:"limit"`
  Offset: Int `json:"offset"`
end

impl CommunityOutput
  func FromView(
    ctx: context.Context,
    repository: storage.BrowserRepository,
    view: storage.CommunityView,
    viewer: storage.BrowserViewer
  ) -> CommunityOutput
    var output = CommunityOutput.FromRecord(view.Record)
    let access = repository.Access(view, viewer)
    let managed = access.Authority.Allows("manage-community")
    let state = if view.FollowState.Valid then
      view.FollowState.String
    else
      "none"
    end
    let loadedRule = storage.LoadCommunityFollowRule(ctx, repository.DB, view.Record.ID)
    let policy = if loadedRule.IsErr() then
      "open"
    else
      loadedRule.Unwrap()
    end
    let accepted = state == "accepted"
    let pending = state == "pending"
    let canFollow = viewer.Verified &&
      !accepted &&
      !pending &&
      (policy == "open" ||
        (policy == "approval" && !view.Member && !view.Manager) ||
        (policy == "members" && (view.Member || view.Manager)))
    output.Viewer = CommunityViewerOutput {
      IsMember: viewer.Verified && view.Member,
      IsCreator: viewer.Verified && view.Record.CreatorActorURI == viewer.Identity.ActorURI,
      IsManager: viewer.Verified && view.Manager,
      ManagementScope: access.Authority.Scope,
      IsFollowing: accepted,
      FollowState: state,
      CanFollow: canFollow,
    }
    output.FollowPolicy = policy
    output.FollowerCount = if viewer.Verified && (view.Record.ReadPolicy != "members" || managed) then
      view.FollowerCount
    else
      0i64
    end
    output.Permissions = CommunityPermissions {
      CanPost: view.Record.HostSiteID == repository.SiteID &&
        viewer.Identity.BelongsTo(repository.SiteID) &&
        access.CanPost(),
      CanManage: managed,
      CanManageMembers: managed,
      CanManageManagers: managed,
    }
    output
  end
end

func BrowserPostAuthor(state: storage.PostRichState) -> AuthorOutput
  if state.AuthorUsername != "" && strings.HasPrefix(state.Origin, "https://") then
    return AuthorOutput{
      Acct: state.AuthorUsername + "@" + strings.TrimPrefix(state.Origin, "https://"),
      DisplayName: state.AuthorDisplayName,
    }
  end
  AuthorOutput{Acct: state.AuthorAcct, DisplayName: state.AuthorDisplayName}
end

func BrowserPosts(
  sanitizer: content.Sanitizer,
  ctx: context.Context,
  repository: storage.BrowserRepository,
  viewer: storage.BrowserViewer,
  records: Slice[storage.PostRecord]
) -> Result[Slice[PostOutput], failure.Failure]
  var outputs: Slice[PostOutput] = []
  let ids = records.Map(func(post: storage.PostRecord) -> String
    post.ID
  end)
  let communityIDs = records.Map(func(post: storage.PostRecord) -> String
    post.CommunityID
  end)
  let views = repository.Views(ctx, viewer, communityIDs)
  let stats = repository.Stats(ctx, viewer, ids)
  let richStates = storage.LoadPostRichStates(ctx, repository.DB, ids)
  var cached: Slice[storage.PrivateMediaCache] = []
  let remoteMedia = records.Any(func(post: storage.PostRecord) -> Bool post.RichMetadata != "" end)
  if remoteMedia &&
    storage.MutationResult(repository.DB.WithContext(ctx).Table("media_private_cache").Where(
      "site_id=? AND post_id IN ? AND error_state<>'invalidated'",
      repository.SiteID,
      ids
    ).Find(Ref.new(cached))).IsErr() then
    return Err(Of("media unavailable"))
  end
  if views.IsErr() || stats.IsErr() || richStates.IsErr() then
    return Err(Of("feed unavailable"))
  end
  # Index the joined rows once; the projection below is per-record.
  let viewList = views.Unwrap()
  let statList = stats.Unwrap()
  let richList = richStates.Unwrap()
  let viewsById = viewList.Fold(
    {} as Map[String, storage.CommunityView],
    func(acc: Map[String, storage.CommunityView], view: storage.CommunityView) -> Map[String, storage.CommunityView]
      let _ = acc.Set(view.Record.ID, view)
      acc
    end
  )
  let statsById = statList.Fold(
    {} as Map[String, storage.PostStats],
    func(acc: Map[String, storage.PostStats], stat: storage.PostStats) -> Map[String, storage.PostStats]
      let _ = acc.Set(stat.ID, stat)
      acc
    end
  )
  let richById = richList.Fold(
    {} as Map[String, storage.PostRichState],
    func(acc: Map[String, storage.PostRichState], state: storage.PostRichState) -> Map[String, storage.PostRichState]
      let _ = acc.Set(state.ID, state)
      acc
    end
  )
  if viewsById.Len() != viewList.Len() ||
    statsById.Len() != statList.Len() ||
    richById.Len() != richList.Len() then
    return Err(Of("feed unavailable"))
  end
  var index: Int = 0
  while index < records.Len()
    let record = records.Get(index).Unwrap()
    index = index + 1
    let found = viewsById.Get(record.CommunityID)
    let counts = statsById.Get(record.ID)
    if found.IsNone() || counts.IsNone() then
      return Err(Of("feed unavailable"))
    end
    let access = repository.Access(found.Unwrap(), viewer)
    if !access.CanRead() then
      return Err(Of("not found"))
    end
    let hosted = access.Community.HostSiteID == repository.SiteID
    let active = !record.DeletedAt.Valid
    let edit = hosted && active && access.CanEditBody(record.AuthorActorURI)
    var output = PostOutput.FromRecord(sanitizer, record)
    let rich = richById.Get(record.ID)
    if rich.IsNone() then
      return Err(Of("post content unavailable"))
    end
    let richState = rich.Unwrap()
    output.Author = BrowserPostAuthor(richState)
    let rendered = storage.RenderStoredPost(sanitizer, record, richState, false)
    let media = richState.RichMedia()
    if rendered.IsErr() || media.IsErr() then
      return Err(Of("post content unavailable"))
    end
    output.BodyHTML = rendered.Unwrap()
    output.AttachmentIDs = media.Unwrap().Map(func(item: content.RichMedia) -> String item.UploadID end)
    let attachments = BrowserPostMedia(sanitizer, record, media.Unwrap(), access.Community.ReadPolicy == "members", cached, output)
    if attachments.IsErr() then
      return Err(attachments.UnwrapErr())
    end
    output = attachments.Unwrap()
    let stat = counts.Unwrap()
    output.Score = stat.Score
    output.Upvotes = stat.Upvotes
    output.Downvotes = stat.Downvotes
    output.VotedByMe = stat.VotedByMe
    output.LikeCount = stat.Upvotes
    output.LikedByMe = viewer.Verified && stat.LikedByMe
    output.ReplyCount = stat.ReplyCount
    output.SavedByMe = viewer.Verified && stat.SavedByMe
    output.ReadByMe = viewer.Verified && stat.ReadByMe
    output.HiddenByMe = viewer.Verified && stat.HiddenByMe
    let up = if viewer.VoteSettingsLoaded then
      viewer.UpvotesEnabled
    else
      true
    end
    let down = if viewer.VoteSettingsLoaded then
      viewer.DownvotesEnabled
    else
      true
    end
    output.Permissions = PostPermissions {
      CanEdit: edit,
      CanDelete: edit,
      CanLike: hosted && active && access.Subject.Verified && access.CanRead() && up,
      CanVote: hosted && active && access.Subject.Verified && access.CanRead() && (up || down),
      CanUpvote: hosted && active && access.Subject.Verified && access.CanRead() && up,
      CanDownvote: hosted && active && access.Subject.Verified && access.CanRead() && down,
      CanReply: hosted && active && viewer.Identity.BelongsTo(repository.SiteID) && access.CanPost(),
      CanHide: viewer.Roles.SiteAdministrator || viewer.Roles.DeploymentSuperadministrator,
      CanSave: viewer.Verified && access.CanRead() && active,
      CanHideForMe: viewer.Verified && active,
      CanModerate: hosted && access.Authority.Allows("manage-community"),
    }
    outputs = outputs.Append(output)
  end
  let audit = repository.AuditViews(ctx, viewer, views.Unwrap())
  if audit.IsErr() then
    return Err(audit.UnwrapErr())
  end
  Ok(outputs)
end

func ThreadBefore(left: PostOutput, right: PostOutput, mode: ThreadSortMode) -> Bool
  switch mode
    case New then
      if !left.AuthoredAt.Equal(right.AuthoredAt) then
        return left.AuthoredAt.After(right.AuthoredAt)
      end
    end
    case Top then
      if left.Score != right.Score then
        return left.Score > right.Score
      end
      if !left.AuthoredAt.Equal(right.AuthoredAt) then
        return left.AuthoredAt.After(right.AuthoredAt)
      end
    end
    case Controversial then
      let leftBalance = if left.Upvotes < left.Downvotes => left.Upvotes else left.Downvotes
      let rightBalance = if right.Upvotes < right.Downvotes => right.Upvotes else right.Downvotes
      if leftBalance != rightBalance then
        return leftBalance > rightBalance
      end
      if left.Score != right.Score then
        return left.Score < right.Score
      end
      if !left.AuthoredAt.Equal(right.AuthoredAt) then
        return left.AuthoredAt.After(right.AuthoredAt)
      end
    end
    case Old then
      if !left.AuthoredAt.Equal(right.AuthoredAt) then
        return left.AuthoredAt.Before(right.AuthoredAt)
      end
    end
  end
  left.ID < right.ID
end

func SortThread(items: Slice[PostOutput], mode: ThreadSortMode) -> Slice[PostOutput]
  items.SortedBy(func(left: PostOutput, right: PostOutput) -> Bool
    ThreadBefore(left, right, mode)
  end)
end

func ThreadChildren(all: Slice[PostOutput], parentID: String, mode: ThreadSortMode) -> Slice[PostOutput]
  var children: Slice[PostOutput] = []
  all.Each(func(item: PostOutput) -> ()
    if item.ParentID == parentID then
      var child = item
      child.Children = ThreadChildren(all, item.ID, mode)
      child.ChildCount = child.Children.Len()
      children = children.Append(child)
    end
  end)
  SortThread(children, mode)
end

func BrowserThread(
  sanitizer: content.Sanitizer,
  ctx: context.Context,
  repository: storage.BrowserRepository,
  viewer: storage.BrowserViewer,
  rows: Slice[storage.ThreadRow],
  parentID: String,
  mode: ThreadSortMode
) -> Result[Slice[PostOutput], failure.Failure]
  let records = rows.Map(func(row: storage.ThreadRow) -> storage.PostRecord
    row.Post
  end)
  let outputs = BrowserPosts(sanitizer, ctx, repository, viewer, records)
  if outputs.IsErr() then
    return Err(outputs.UnwrapErr())
  end
  let adjusted = outputs.Unwrap().ZipWith(rows, func(item: PostOutput, row: storage.ThreadRow) -> PostOutput
    var updated = item
    updated.Depth = row.Depth
    updated
  end)
  Ok(ThreadChildren(adjusted, parentID, mode))
end

func WriteBrowserPost(
  sanitizer: content.Sanitizer,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  status: Int,
  identity: auth.Identity,
  record: storage.PostRecord
) -> ()
  let repository = storage.BrowserRepository { DB: db, SiteID: site.ID }
  let viewer = repository.Viewer(request.Context(), identity)
  if viewer.IsErr() then
    FailFailure(w, viewer.UnwrapErr())
    return
  end
  let records: Slice[storage.PostRecord] = [record]
  let outputs = BrowserPosts(sanitizer, request.Context(), repository, viewer.Unwrap(), records)
  if outputs.IsErr() then
    FailFailure(w, outputs.UnwrapErr())
  else
    WriteJSON(w, status, outputs.Unwrap().Get(0).Unwrap())
  end
end

func WriteBrowserCommunity(
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  status: Int,
  identity: auth.Identity,
  record: storage.CommunityRecord
) -> ()
  let repository = storage.BrowserRepository { DB: db, SiteID: site.ID }
  let viewer = repository.Viewer(request.Context(), identity)
  if viewer.IsErr() then
    FailFailure(w, viewer.UnwrapErr())
    return
  end
  let ids: Slice[String] = [record.ID]
  let views = repository.Views(request.Context(), viewer.Unwrap(), ids)
  if views.IsErr() || views.Unwrap().Len() != 1 then
    Fail(w, "community unavailable")
  else
    WriteJSON(
      w,
      status,
      CommunityOutput.FromView(request.Context(), repository, views.Unwrap().Get(0).Unwrap(), viewer.Unwrap())
    )
  end
end
