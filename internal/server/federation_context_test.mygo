package server

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import strings "go:strings"
import time "go:time"
import config "github.com/commune-project/commune-mygo/internal/config"
import storage "github.com/commune-project/commune-mygo/internal/storage"
import auth "github.com/commune-project/commune-mygo/internal/auth"
import testsupport "github.com/commune-project/commune-mygo/internal/testsupport"
import transport "go:github.com/commune-project/commune-mygo/internal/testtransport"

func TestPostgresDiscussionContextCollection(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let a = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, a).Unwrap()
  let accounts = storage.AccountRepository{DB: db}
  let alice = accounts.Create(ctx, a, "alice", "", "alice-account-password").Unwrap()
  let communities = storage.CommunityRepository{DB: db, SiteID: a.ID}
  let posts = storage.PostRepository{DB: db, SiteID: a.ID}
  let open = communities.Create(ctx, a, alice, "open", "Open", "federated", "eligible_users", "eligible_users").Unwrap()
  let restricted = communities.Create(ctx, a, alice, "restricted", "Restricted", "federated", "members", "members").Unwrap()
  let local = communities.Create(ctx, a, alice, "local", "Local", "local_only", "eligible_users", "eligible_users").Unwrap()
  let topic = posts.Publish(ctx, a, open.ID, alice, false, storage.PublishInput{Title: "Topic", Body: "Body", ParentID: ""}).Unwrap()
  let reply = posts.Publish(ctx, a, open.ID, alice, false, storage.PublishInput{Body: "Reply", ParentID: topic.ID}).Unwrap()
  let contextRow = storage.CreateDiscussionContext(ctx, db, open, topic.ID, a.Origin).Unwrap()
  let _ = storage.AttachPostToContext(ctx, db, topic.ID, contextRow.ID).Unwrap()
  let _ = storage.AttachPostToContext(ctx, db, reply.ID, contextRow.ID).Unwrap()
  let restrictedTopic = posts.Publish(ctx, a, restricted.ID, alice, false, storage.PublishInput{Title: "Secret", Body: "Body", ParentID: ""}).Unwrap()
  let restrictedContext = storage.CreateDiscussionContext(ctx, db, restricted, restrictedTopic.ID, a.Origin).Unwrap()
  let _ = storage.AttachPostToContext(ctx, db, restrictedTopic.ID, restrictedContext.ID).Unwrap()
  let localTopic = posts.Publish(ctx, a, local.ID, alice, false, storage.PublishInput{Title: "Local", Body: "Body", ParentID: ""}).Unwrap()
  let localContext = storage.CreateDiscussionContext(ctx, db, local, localTopic.ID, a.Origin).Unwrap()
  let _ = storage.AttachPostToContext(ctx, db, localTopic.ID, localContext.ID).Unwrap()
  let handler = Handler(settings, db)
  let accept = "application/activity+json"
  if !contextRow.ContextURI.Valid then
    t.Fatal("a federated discussion did not receive a context identity")
  end
  let listed = getAP(handler, a.Origin, "/contexts/" + contextRow.ID, accept)
  if listed.Code != 200 || !strings.Contains(listed.Body.String(), "\"type\":\"OrderedCollection\"") || !strings.Contains(listed.Body.String(), "\"totalItems\":2") then
    t.Fatalf("the context collection was wrong: %d %s", listed.Code, listed.Body.String())
  end
  if !strings.Contains(listed.Body.String(), contextRow.ContextURI.String) then
    t.Fatal("the context collection did not use its canonical identity")
  end
  let page = getAP(handler, a.Origin, "/contexts/" + contextRow.ID + "?page=1", accept)
  if page.Code != 200 || !strings.Contains(page.Body.String(), "\"type\":\"OrderedCollectionPage\"") || !strings.Contains(page.Body.String(), topic.ObjectURI.String) then
    t.Fatalf("the context page did not list the discussion: %d %s", page.Code, page.Body.String())
  end
  if localContext.ContextURI.Valid then
    t.Fatal("a local-only discussion received a protocol context")
  end
  if getAP(handler, a.Origin, "/contexts/" + localContext.ID, accept).Code != 404 then
    t.Fatal("a local-only discussion exposed an ActivityPub context")
  end
  if getAP(handler, a.Origin, "/contexts/" + restrictedContext.ID, accept).Code != 404 then
    t.Fatal("an unsigned read reached a member-readable context")
  end
  let memberKey = storage.GeneratePrivatePEM().Unwrap()
  let member = "https://peer.example/users/member"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?, 'Person', ?)", member, storage.PublicPEMFromPrivate(memberKey).Unwrap())).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?)", restricted.ID, member, alice.ActorURI)).Unwrap()
  let date = time.Now().UTC().Format(http.TimeFormat)
  let memberRead = signedGet(handler, a.Origin, "/contexts/" + restrictedContext.ID, member, memberKey, date)
  if memberRead.Code != 200 || !strings.Contains(memberRead.Body.String(), "\"totalItems\":1") then
    t.Fatalf("a member could not read the protected context: %d %s", memberRead.Code, memberRead.Body.String())
  end
  let outsiderKey = storage.GeneratePrivatePEM().Unwrap()
  let outsider = "https://peer.example/users/outsider"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?, 'Person', ?)", outsider, storage.PublicPEMFromPrivate(outsiderKey).Unwrap())).Unwrap()
  let outsiderRead = signedGet(handler, a.Origin, "/contexts/" + restrictedContext.ID, outsider, outsiderKey, date)
  if outsiderRead.Code != 404 || strings.Contains(outsiderRead.Body.String(), restrictedTopic.ObjectURI.String) then
    t.Fatal("a non-member received protected context or membership evidence")
  end
  let _ = storage.MutationResult(db.Exec("UPDATE community_members SET revoked_at=now() WHERE community_id=? AND actor_uri=?", restricted.ID, member)).Unwrap()
  if signedGet(handler, a.Origin, "/contexts/" + restrictedContext.ID, member, memberKey, date).Code != 404 then
    t.Fatal("a revoked member retained protected context access")
  end
  let managerKey = storage.GeneratePrivatePEM().Unwrap()
  let manager = "https://peer.example/users/manager"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?, 'Person', ?)", manager, storage.PublicPEMFromPrivate(managerKey).Unwrap())).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO moderators(community_id,actor_uri,assigned_by) VALUES (?,?,?)", restricted.ID, manager, alice.ActorURI)).Unwrap()
  if signedGet(handler, a.Origin, "/contexts/" + restrictedContext.ID, manager, managerKey, date).Code != 200 then
    t.Fatal("a current manager could not read the protected context")
  end
  let _ = storage.MutationResult(db.Exec("UPDATE moderators SET revoked_at=now() WHERE community_id=? AND actor_uri=?", restricted.ID, manager)).Unwrap()
  if signedGet(handler, a.Origin, "/contexts/" + restrictedContext.ID, manager, managerKey, date).Code != 404 then
    t.Fatal("a revoked manager retained protected context access")
  end
  var fetchCount = 0
  let fetcher = func(fetchCtx: context.Context, fetchSettings: config.Config, uri: String) -> Result[Slice[Byte], String]
    fetchCount = fetchCount + 1
    let body = "{\"id\":\"" + restrictedContext.ContextURI.String + "\",\"type\":\"OrderedCollection\",\"attributedTo\":\"" + restricted.ActorURI.String + "\"}"
    Ok(body as Slice[Byte])
  end
  let deniedBackfill = BackfillDiscussion(ctx, settings, db, a, restrictedContext.ID, auth.Identity{ActorURI: outsider}, true, fetcher)
  if deniedBackfill.IsOk() || fetchCount != 0 then
    t.Fatal("a non-member caused protected context backfill or remote fetch")
  end
  let _ = storage.MutationResult(db.Exec("UPDATE community_members SET revoked_at=NULL WHERE community_id=? AND actor_uri=?", restricted.ID, member)).Unwrap()
  let memberBackfill = BackfillDiscussion(ctx, settings, db, a, restrictedContext.ID, auth.Identity{ActorURI: member}, true, fetcher)
  if memberBackfill.IsErr() then
    t.Fatalf("a current member could not authorize protected context traversal: %s", memberBackfill.UnwrapErr())
  end
  if fetchCount != 1 then
    t.Fatalf("a current member caused %d protected context fetches", fetchCount)
  end
  let fetchBeforeLocal = fetchCount
  if BackfillDiscussion(ctx, settings, db, a, localContext.ID, auth.Identity{ActorURI: member}, true, fetcher).IsOk() || fetchCount != fetchBeforeLocal then
    t.Fatal("a local-only context initiated remote synchronization")
  end
end
