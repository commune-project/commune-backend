package server

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import time "go:time"
import config "github.com/commune-project/commune-mygo/internal/config"
import storage "github.com/commune-project/commune-mygo/internal/storage"
import testsupport "github.com/commune-project/commune-mygo/internal/testsupport"
import transport "go:github.com/commune-project/commune-mygo/internal/testtransport"

func TestPostgresRemoteAdministrationRevocation(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let a = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, a).Unwrap()
  let accounts = storage.AccountRepository{DB: db}
  let alice = accounts.Create(ctx, a, "alice", "", "alice-account-password").Unwrap()
  let communities = storage.CommunityRepository{DB: db, SiteID: a.ID}
  let community = communities.Create(ctx, a, alice, "news", "News", "federated", "eligible_users", "eligible_users").Unwrap()
  let other = communities.Create(ctx, a, alice, "other", "Other", "federated", "eligible_users", "eligible_users").Unwrap()
  let managerKey = storage.GeneratePrivatePEM().Unwrap()
  let manager = "https://peer.example/users/manager"
  let first = "https://peer.example/users/first"
  let second = "https://peer.example/users/second"
  let subscriber = "https://fan.example/users/reader"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?, 'Person', ?), (?, 'Person', NULL), (?, 'Person', NULL), (?, 'Person', 'https://fan.example/inbox')", manager, storage.PublicPEMFromPrivate(managerKey).Unwrap(), first, second, subscriber)).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO moderators(community_id,actor_uri,assigned_by) VALUES (?,?,?)", community.ID, manager, alice.ActorURI)).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO follows(community_id,actor_uri,follow_uri,state) VALUES (?,?,?,'accepted')", community.ID, subscriber, "https://fan.example/activities/f1")).Unwrap()
  let handler = Handler(settings, db)
  let date = time.Now().UTC().Format(http.TimeFormat)
  let add = func(id: String, target: storage.CommunityRecord, member: String) -> String
    "{\"id\":\"https://peer.example/activities/" + id + "\",\"actor\":\"" + manager + "\",\"type\":\"Add\",\"to\":[\"" + alice.ActorURI + "\"],\"target\":\"" + target.ActorURI.String + "\",\"object\":\"" + member + "\",\"commune:role\":\"member\"}"
  end
  if signedPost(handler, a.Origin, "/users/alice/inbox", add("a1", community, first), manager, managerKey, date).Code != 202 then
    t.Fatal("remote authorized management failed")
  end
  if !storage.IsCurrentMember(ctx, db, community.ID, first).Unwrap() then
    t.Fatal("the remote manager's change was not applied")
  end
  let count: Int64 = 0i64
  let _ = storage.MutationResult(db.Table("activities").Where("actor_uri = ? AND kind = 'Announce'", community.ActorURI.String).Count(Ref.new(count))).Unwrap()
  if count != 1i64 then
    t.Fatal("an accepted management action was not announced")
  end
  let _ = storage.MutationResult(db.Table("delivery_jobs").Where("recipient_actor_uri = ?", subscriber).Count(Ref.new(count))).Unwrap()
  if count != 1i64 then
    t.Fatal("the management announcement was not delivered to eligible followers")
  end
  let _ = storage.MutationResult(db.Exec("UPDATE moderators SET revoked_at = now() WHERE community_id = ? AND actor_uri = ?", community.ID, manager)).Unwrap()
  let _ = signedPost(handler, a.Origin, "/users/alice/inbox", add("a2", community, second), manager, managerKey, date)
  if storage.IsCurrentMember(ctx, db, community.ID, second).Unwrap() then
    t.Fatal("a revoked remote manager still changed membership")
  end
  let _ = storage.MutationResult(db.Table("activities").Where("actor_uri = ? AND kind = 'Announce'", community.ActorURI.String).Count(Ref.new(count))).Unwrap()
  if count != 1i64 then
    t.Fatal("a revoked manager's action was announced")
  end
  let _ = signedPost(handler, a.Origin, "/users/alice/inbox", add("a3", other, manager), manager, managerKey, date)
  if storage.IsCurrentMember(ctx, db, other.ID, manager).Unwrap() || storage.IsCommunityManager(ctx, db, other.ID, manager).Unwrap() then
    t.Fatal("remote management leaked into another community")
  end
end
