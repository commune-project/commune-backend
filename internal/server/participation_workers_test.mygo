package server

import testing "go:testing"
import context "go:context"
import time "go:time"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"

func ParticipationStopped(signal: Chan[()]) -> Bool
  let timer = time.NewTimer(2 as time.Duration * time.Second)
  go[()] { code: "defer {timer}.Stop()"; in timer = timer }
  go[Bool] {
    code: "select { case <-{signal}: return true; case <-{timer}.C: return false }"
    in signal = signal
    in timer = timer
  }
end

func TestParticipationWorkerCancellation(t: Ref[testing.T]) -> ()
  var settings = config.Load("../../config/example.json").Unwrap()
  let db = storage.OpenPostgres("postgres://unused@127.0.0.1:1/unused?sslmode=disable").Unwrap()
  let pool = db.DB().Unwrap()
  go[()] { code: "defer {pool}.Close()"; in pool = pool }
  let (ctx, cancel) = context.WithCancel(context.Background())
  cancel()
  if !ParticipationStopped(StartParticipationWorkers(ctx, settings, db)) then
    t.Fatal("disabled workers did not immediately stop")
  end
  settings.ParticipationWorkers.Enabled = true
  settings.ParticipationWorkers.MailWorkers = 2
  settings.ParticipationWorkers.NotificationWorkers = 2
  settings.ParticipationWorkers.MediaWorkers = 2
  settings.ParticipationWorkers.ActorWorkers = 2
  if !ParticipationStopped(StartParticipationWorkers(ctx, settings, db)) then
    t.Fatal("cancelled workers leaked or ignored shutdown context")
  end
end
