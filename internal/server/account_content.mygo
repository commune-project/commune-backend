package server

import http "go:net/http"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import failure "github.com/commune-project/commune-backend/internal/failure"

func AccountContentRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  if parts.Len() != 4 || parts.Get(2).UnwrapOr("") != "account" then
    return false
  end
  let source = parts.Get(3).UnwrapOr("")
  if source != "saved" && source != "read" && source != "hidden" && source != "liked" then
    return false
  end
  if request.Method != "GET" then
    MethodNotAllowed(w, "GET")
    return true
  end
  WithSession(db, site, w, request, func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
    let page = PageFromQuery(settings, request)
    if page.IsErr() then
      return Err(page.UnwrapErr())
    end
    let repository = storage.BrowserRepository { DB: db, SiteID: site.ID }
    let viewer = repository.Viewer(request.Context(), session.Identity)
    if viewer.IsErr() then
      return Err(viewer.UnwrapErr())
    end
    let records = switch source
      case "saved" => repository.SavedPosts(request.Context(), viewer.Unwrap(), page.Unwrap(), settings.Runtime.MaxPageSize)
      case "read" => repository.ReadPosts(request.Context(), viewer.Unwrap(), page.Unwrap(), settings.Runtime.MaxPageSize)
      case "hidden" => repository.HiddenPosts(request.Context(), viewer.Unwrap(), page.Unwrap(), settings.Runtime.MaxPageSize)
      case _ => repository.LikedPosts(request.Context(), viewer.Unwrap(), page.Unwrap(), settings.Runtime.MaxPageSize)
    end
    if records.IsErr() then
      return Err(records.UnwrapErr())
    end
    let outputs = BrowserPosts(settings.Rendering.Sanitizer, request.Context(), repository, viewer.Unwrap(), records.Unwrap())
    if outputs.IsErr() then
      return Err(outputs.UnwrapErr())
    end
    WriteJSON(w, 200, PostPage { Items: outputs.Unwrap(), Limit: page.Unwrap().Limit, Offset: page.Unwrap().Offset })
    Ok(())
  end)
  true
end
