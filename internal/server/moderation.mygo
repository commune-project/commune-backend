package server

import http "go:net/http"
import strconv "go:strconv"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"

struct ReportInput
  TargetKind: String `json:"target_kind"`
  TargetID: String `json:"target_id"`
  CommunityID: String `json:"community_id"`
  Reason: String `json:"reason"`
end

struct ReportResolveInput
  State: String `json:"state"`
  Note: String `json:"note"`
end

struct BanInput
  Actor: String `json:"actor"`
  Reason: String `json:"reason"`
  ExpiresAt: String `json:"expires_at"`
end

struct ReportPage
  Items: Slice[storage.ReportRecord] `json:"items"`
  Limit: Int `json:"limit"`
  Offset: Int `json:"offset"`
end

struct ModlogPage
  Items: Slice[storage.ModerationLogRecord] `json:"items"`
  Limit: Int `json:"limit"`
  Offset: Int `json:"offset"`
end

func ModerationRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  let resource = parts.Get(2).UnwrapOr("")
  if resource == "modlog" && parts.Len() == 3 then
    return ModlogRoute(settings, db, site, w, request)
  end
  if resource == "reports" then
    if parts.Len() == 3 then
      return ReportsRoute(settings, db, site, w, request)
    end
    if parts.Len() == 5 && parts.Get(4).UnwrapOr("") == "resolve" then
      return ResolveReportRoute(settings, db, site, w, request, parts.Get(3).UnwrapOr(""))
    end
    return false
  end
  if resource == "admin" && parts.Len() == 4 && parts.Get(3).UnwrapOr("") == "bans" then
    return AdminBanRoute(settings, db, site, w, request)
  end
  false
end

func ModlogRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request]
) -> Bool
  if request.Method != "GET" then
    MethodNotAllowed(w, "GET")
    return true
  end
  WithSession(
    db,
    site,
    w,
    request,
    func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
      let page = PageFromQuery(settings, request)
      if page.IsErr() then
        return Err(page.UnwrapErr())
      end
      let rows = storage.ModerationLog(
        request.Context(),
        db,
        site.ID,
        session.Identity,
        request.URL.Query().Get("community_id"),
        page.Unwrap().Limit,
        page.Unwrap().Offset
      )
      if rows.IsErr() then
        return Err(rows.UnwrapErr())
      end
      WriteJSON(
        w,
        200,
        ModlogPage {
          Items: rows.Unwrap(),
          Limit: page.Unwrap().Limit,
          Offset: page.Unwrap().Offset,
        }
      )
      Ok(())
    end
  )
  true
end

func ReportsRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request]
) -> Bool
  WithSession(
    db,
    site,
    w,
    request,
    func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
      if request.Method == "GET" then
        let page = PageFromQuery(settings, request)
        if page.IsErr() then
          return Err(page.UnwrapErr())
        end
        let state = ParseReportState(request.URL.Query().Get("state"), true)
        if state.IsErr() then
          return Err(state.UnwrapErr())
        end
        let rows = storage.ListReports(
          request.Context(),
          db,
          site.ID,
          session.Identity,
          state.Unwrap(),
          request.URL.Query().Get("community_id"),
          page.Unwrap().Limit,
          page.Unwrap().Offset
        )
        if rows.IsErr() then
          return Err(rows.UnwrapErr())
        end
        WriteJSON(
          w,
          200,
          ReportPage {
            Items: rows.Unwrap(),
            Limit: page.Unwrap().Limit,
            Offset: page.Unwrap().Offset,
          }
        )
        return Ok(())
      end
      if request.Method != "POST" then
        MethodNotAllowed(w, "GET, POST")
        return Ok(())
      end
      if !AuthorizeMutation(settings, session, request) then
        WriteErrorJSON(w, 403, "CSRF denied")
        return Ok(())
      end
      var input = Zero[ReportInput]()
      if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
        WriteErrorJSON(w, 400, "invalid report")
        return Ok(())
      end
      var communityID = input.CommunityID
      if input.TargetKind == "post" then
        let post = storage.FeedRepository { DB: db, SiteID: site.ID }.ReadObject(request.Context(), input.TargetID, session.Identity, false)
        if post.IsErr() then
          return Err(Of("not found"))
        end
        if post.Unwrap().AuthorActorURI == session.Identity.ActorURI then
          WriteErrorJSON(w, 400, "invalid report")
          return Ok(())
        end
        communityID = post.Unwrap().CommunityID
      end
      if input.TargetKind == "community" then
        let community = storage.CommunityRepository { DB: db, SiteID: site.ID }.Check(request.Context(), input.TargetID, session.Identity, false)
        if community.IsErr() || !community.Unwrap().CanRead() then
          return Err(Of("not found"))
        end
        communityID = input.TargetID
      end
      if input.TargetKind == "person" then
        if input.TargetID == session.Identity.ActorURI then
          WriteErrorJSON(w, 400, "invalid report")
          return Ok(())
        end
        let known = storage.QueryExists(db.WithContext(request.Context()).Table("actors").Where("uri=? AND kind='Person'", input.TargetID))
        if known.IsErr() || !known.Unwrap() then
          return Err(Of("not found"))
        end
      end
      if input.TargetKind != "post" && input.TargetKind != "community" && input.TargetKind != "person" then
        return Err(Of("invalid report"))
      end
      let created = storage.CreateReport(
        request.Context(),
        db,
        site.ID,
        session.Identity,
        input.TargetKind,
        input.TargetID,
        communityID,
        input.Reason
      )
      if created.IsErr() then
        return Err(created.UnwrapErr())
      end
      w.WriteHeader(if created.Unwrap() => 201 else 200)
      Ok(())
    end
  )
  true
end

func ResolveReportRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  rawID: String
) -> Bool
  if request.Method != "POST" then
    MethodNotAllowed(w, "POST")
    return true
  end
  WithSession(db, site, w, request, func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
    if !AuthorizeMutation(settings, session, request) then
      WriteErrorJSON(w, 403, "CSRF denied")
      return Ok(())
    end
    let id = strconv.ParseInt(rawID, 10, 64)
    if id.IsErr() || id.Unwrap() <= 0i64 then
      WriteErrorJSON(w, 400, "invalid report")
      return Ok(())
    end
    var input = Zero[ReportResolveInput]()
    if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
      WriteErrorJSON(w, 400, "invalid report")
      return Ok(())
    end
    let resolution = ParseReportResolutionState(input.State)
    if resolution.IsErr() then
      WriteErrorJSON(w, 400, "invalid report state")
      return Ok(())
    end
    Settle(w, storage.ResolveReport(request.Context(), db, site.ID, session.Identity, id.Unwrap(), input.State, input.Note))
    Ok(())
  end)
  true
end

func AdminBanRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request]
) -> Bool
  if request.Method != "POST" && request.Method != "DELETE" then
    MethodNotAllowed(w, "POST, DELETE")
    return true
  end
  WithSession(db, site, w, request, func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
    if !AuthorizeMutation(settings, session, request) then
      WriteErrorJSON(w, 403, "CSRF denied")
      return Ok(())
    end
    var input = Zero[BanInput]()
    if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(input)).IsErr() then
      WriteErrorJSON(w, 400, "invalid ban")
      return Ok(())
    end
    let expiry = ParseBanExpiry(input.ExpiresAt)
    if expiry.IsErr() then
      WriteErrorJSON(w, 400, "invalid ban")
      return Ok(())
    end
    let result = if request.Method == "POST" then
      storage.BanSite(request.Context(), db, site.ID, session.Identity, input.Actor, input.Reason, expiry.Unwrap())
    else
      storage.UnbanSite(request.Context(), db, site.ID, session.Identity, input.Actor)
    end
    Settle(w, result)
    Ok(())
  end)
  true
end
