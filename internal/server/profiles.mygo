package server

import context "go:context"
import http "go:net/http"
import json "go:encoding/json"
import time "go:time"
import utf8 "go:unicode/utf8"
import strings "go:strings"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import auth "github.com/commune-project/commune-backend/internal/auth"
import storage "github.com/commune-project/commune-backend/internal/storage"
import content "github.com/commune-project/commune-backend/internal/content"
import federation "github.com/commune-project/commune-backend/internal/federation"
import failure "github.com/commune-project/commune-backend/internal/failure"

struct ProfilePatch
  DisplayName: json.RawMessage `json:"display_name"`
  Biography: json.RawMessage `json:"biography"`
  AvatarUploadID: json.RawMessage `json:"avatar_upload_id"`
end

struct AvatarBinding
  ID: String
  URL: String
end

func BindProfileAvatar(
  ctx: context.Context,
  tx: Ref[gorm.DB],
  site: config.Site,
  settings: config.Config,
  identity: auth.Identity,
  uploadID: String
) -> Result[AvatarBinding, failure.Failure]
  let media: storage.MediaRepository = storage.MediaRepository{
    DB: tx,
    SiteID: site.ID,
    Files: Zero[storage.MediaFiles](),
    Settings: settings.Media,
  }
  let bound = media.BindAvatarTx(ctx, tx, identity, uploadID)
  if bound.IsErr() then
    return Err(bound.UnwrapErr())
  end
  if bound.Unwrap() == "" then
    return Ok(Zero[AvatarBinding]())
  end
  Ok(AvatarBinding{
    ID: strings.TrimPrefix(bound.Unwrap(), "/api/v1/media/"),
    URL: site.Origin + bound.Unwrap(),
  })
end

# Binding and profile changes share tx; no filesystem handle is needed here.
func ProfilesRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  ProfileRoute(settings, db, site, w, request, parts)
end

func ProfileRoute(
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  w: http.ResponseWriter,
  request: Ref[http.Request],
  parts: Slice[String]
) -> Bool
  let resource = parts.Get(2).UnwrapOr("")
  let publicRead = resource == "profiles" && parts.Len() == 4
  let current = resource == "profile" && parts.Len() == 3
  if !publicRead && !current then
    return false
  end
  w.Header().Set("Cache-Control", "no-store")
  w.Header().Set("Referrer-Policy", "no-referrer")
  if publicRead then
    if request.Method != "GET" then
      MethodNotAllowed(w, "GET")
      return true
    end
    let viewer = BrowserIdentity(db, site, request, false)
    if viewer.IsErr() then
      FailFailure(w, viewer.UnwrapErr())
      return true
    end
    let raw = parts.Get(3).Unwrap()
    if request.URL.Query().Get("resolve") == "1" then
      switch ResolveRemoteProfile(request.Context(), settings, db, site, viewer.Unwrap(), raw)
        case Err(reason) => FailFailure(w, reason)
        case Ok(profile) => WriteJSON(w, 200, profile)
      end
      return true
    end
    let loaded = storage.LoadProfileByHandle(
      request.Context(),
      db,
      site.ID,
      viewer.Unwrap().AccountID,
      raw
    )
    switch loaded
      case Err(reason) => FailFailure(w, reason)
      case Ok(profile) => WriteJSON(w, 200, profile)
    end
    return true
  end
  if request.Method != "GET" && request.Method != "PATCH" then
    MethodNotAllowed(w, "GET, PATCH")
    return true
  end
  # WithSession handles authentication and authorization, so we can assume the user is authenticated here.
  WithSession(
    db,
    site,
    w,
    request,
    func(session: storage.AuthenticatedSession) -> Result[(), failure.Failure]
      let identity = session.Identity
      if request.Method == "GET" then
        switch storage.PublicProfile(request.Context(), db, site.ID, identity.Username)
          case Err(err) => FailFailure(w, err)
          case Ok(profile) => WriteJSON(w, 200, profile)
        end
        return Ok(())
      end
      if !AuthorizeMutation(settings, session, request) then
        WriteErrorJSON(w, 403, "CSRF denied")
        return Ok(())
      end
      let patch: ProfilePatch = Zero[ProfilePatch]()
      if DecodeJSON(w, request, settings.Runtime.MaxBodyBytes, Ref.new(patch)).IsErr() then
        WriteErrorJSON(w, 400, "invalid profile input")
        return Ok(())
      end
      var output: storage.ProfileRecord = Zero[storage.ProfileRecord]()
      let result = storage.RunTransaction(
        request.Context(),
        db,
        func(tx: Ref[gorm.DB]) -> Result[(), failure.Failure]
          let locked = storage.LockProfileOwner(request.Context(), tx, site.ID, identity)
          if locked.IsErr() then
            return locked
          end
          let loaded = storage.LoadProfile(request.Context(), tx, identity.ActorURI)
          if loaded.IsErr() then
            return Err(loaded.UnwrapErr())
          end
          var profile = loaded.Unwrap()
          profile.Username = identity.Username
          if (patch.DisplayName as Slice[Byte]).Len() > 0 then
            let name = ""
            if (patch.DisplayName as String) == "null" ||
              json.Unmarshal(patch.DisplayName as Slice[Byte], Ref.new(name)).IsErr() ||
              !utf8.ValidString(name) ||
              utf8.RuneCountInString(name) > settings.Rendering.MaxDisplayNameLength then
              return Err(Of("invalid profile input"))
            end
            profile.DisplayName = content.RenderText(name)
          end
          if (patch.Biography as Slice[Byte]).Len() > 0 then
            let biography = ""
            if (patch.Biography as String) == "null" ||
              json.Unmarshal(patch.Biography as Slice[Byte], Ref.new(biography)).IsErr() ||
              !utf8.ValidString(biography) ||
              utf8.RuneCountInString(biography) > settings.Rendering.MaxBiographyLength then
              return Err(Of("invalid profile input"))
            end
            let rendered = content.RenderRich(settings.Rendering.Sanitizer, biography, "markdown")
            if rendered.IsErr() then
              return Err(Of("invalid profile input"))
            end
            profile.Biography = biography
            profile.BiographyHTML = rendered.Unwrap()
          end
          if (patch.AvatarUploadID as Slice[Byte]).Len() > 0 then
            let upload = ""
            if (patch.AvatarUploadID as String) != "null" &&
              json.Unmarshal(patch.AvatarUploadID as Slice[Byte], Ref.new(upload)).IsErr() then
              return Err(Of("invalid profile input"))
            end
            let binding = BindProfileAvatar(request.Context(), tx, site, settings, identity, upload)
            if binding.IsErr() then
              return Err(binding.UnwrapErr())
            end
            profile.AvatarBindingID = binding.Unwrap().ID
            profile.AvatarURL = binding.Unwrap().URL
          end
          let now = time.Now()
          profile.UpdatedAt = if now.After(profile.UpdatedAt) then
            now
          else
            profile.UpdatedAt.Add(time.Microsecond)
          end
          let saved = storage.SaveProfile(request.Context(), tx, identity, profile)
          if saved.IsErr() then
            return saved
          end
          let queued = federation.QueueProfileUpdate(request.Context(), tx, site, profile)
          if queued.IsErr() then
            return queued
          end
          output = profile
          Ok(())
        end
      )
      if result.IsErr() then
        if result.UnwrapErr().Render() == "invalid profile input" ||
          result.UnwrapErr().Render() == "invalid media binding" then
          WriteErrorJSON(w, 400, result.UnwrapErr().Render())
        else
          if result.UnwrapErr().Render() == "media binding conflict" then
            WriteErrorJSON(w, 409, result.UnwrapErr().Render())
          else
            FailFailure(w, result.UnwrapErr())
          end
        end
        return Ok(())
      end
      WriteJSON(w, 200, output)
      Ok(())
    end
  )
  true
end

func ResolveRemoteProfile(
  ctx: context.Context,
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  viewer: auth.Identity,
  raw: String
) -> Result[storage.ProfileRecord, failure.Failure]
  ResolveRemoteProfileWith(ctx, settings, db, site, viewer, raw, FetchMentionDocument)
end

func ResolveRemoteProfileWith(
  ctx: context.Context,
  settings: config.Config,
  db: Ref[gorm.DB],
  site: config.Site,
  viewer: auth.Identity,
  raw: String,
  fetcher: func(context.Context, config.Config, Ref[gorm.DB], config.Site, String) -> Result[federation.FetchResult, failure.Failure]
) -> Result[storage.ProfileRecord, failure.Failure]
  if viewer.AccountID <= 0i64 then
    return Err(Of("unauthenticated"))
  end
  let trimmed = strings.TrimSpace(raw)
  let parts = trimmed.Split("@")
  if parts.Len() != 2 then
    return storage.LoadProfileByHandle(ctx, db, site.ID, viewer.AccountID, trimmed)
  end
  let local = parts.Get(0).UnwrapOr("")
  let domain = strings.ToLower(parts.Get(1).UnwrapOr(""))
  if local == "" || domain == "" then
    return Err(Of("not found"))
  end
  let configured = storage.ConfiguredAuthority(ctx, db, domain)
  if configured.IsErr() then
    return Err(Of("profile unavailable"))
  end
  if configured.Unwrap() then
    return storage.LoadProfileByHandle(ctx, db, site.ID, viewer.AccountID, trimmed)
  end
  let allowed = storage.ConsumeProfileResolveAttempt(
    ctx,
    db,
    site.ID,
    viewer.AccountID,
    settings.Federation.ProfileResolveLimit,
    settings.Federation.ProfileResolveWindowSeconds,
    time.Now()
  )
  if allowed.IsErr() then
    return Err(Of("profile unavailable"))
  end
  if !allowed.Unwrap() then
    return Err(Of("profile resolve rate limited"))
  end
  let discovered = DiscoverVerifiedHandleWith(ctx, settings, db, site, local, domain, fetcher)
  if discovered.IsErr() then
    let reason = discovered.UnwrapErr().Render()
    if reason == "peer unavailable" then
      return Err(Of("resource unavailable"))
    end
    return Err(Of("not found"))
  end
  let saved = storage.BootstrapVerifiedProfile(
    ctx,
    db,
    discovered.Unwrap(),
    settings.Rendering.Sanitizer
  )
  if saved.IsErr() then
    return Err(saved.UnwrapErr())
  end
  storage.LoadProfileByHandle(ctx, db, site.ID, viewer.AccountID, discovered.Unwrap().Acct)
end
