package server

import testing "go:testing"
import context "go:context"
import time "go:time"
import io "go:io"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

func TestPostgresFederationMediaActorAuthorization(t: Ref[testing.T]) -> ()
  let ctx = context.Background()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  var settings = config.Load("../../config/example.json").Unwrap()
  settings.Media.Enabled = true
  settings.Media.Root = t.TempDir()
  let site = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let alice = storage.AccountRepository{DB: db}.Create(ctx, site, "alice", "", "alice-password").Unwrap()
  let group = storage.CommunityRepository{DB: db, SiteID: site.ID}.Create(ctx, site, alice, "private", "Private", "federated", "members", "members").Unwrap()
  let mediaFS = storage.OpenMediaFiles(settings.Media).Unwrap()
  t.Cleanup(func() -> () let _ = mediaFS.Root.Close() end)
  let repository = storage.MediaRepository{DB: db, SiteID: site.ID, Files: mediaFS, Settings: settings.Media}
  let uploaded = repository.Upload(ctx, alice, "post", "note.txt", "text/plain", strings.NewReader("private file") as io.Reader).Unwrap()
  let post = PublishForumPost(settings, db, ctx, site, group.ID, alice, false, storage.PublishInput{Title: "Private", Body: "[file](/api/v1/media/" + uploaded.ID + ")", ContentFormat: "markdown", AttachmentIDs: [uploaded.ID]}).Unwrap()
  let binding: String = ""
  let _ = storage.MutationResult(db.Raw("SELECT id FROM media_bindings WHERE post_id=? AND active", post.ID).Scan(Ref.new(binding))).Unwrap()
  let key = storage.GeneratePrivatePEM().Unwrap()
  let publicKey = storage.PublicPEMFromPrivate(key).Unwrap()
  let member = "https://peer.example/users/member"
  let outsider = "https://peer.example/users/outsider"
  let instance = "https://peer.example/instance"
  let _ = storage.MutationResult(db.Exec("INSERT INTO actors(uri,kind,public_key_pem) VALUES (?,'Person',?),(?,'Person',?),(?,'Group',?)", member, publicKey, outsider, publicKey, instance, publicKey)).Unwrap()
  let _ = storage.SetPeerProtectedReads(ctx, db, "peer.example", true).Unwrap()
  let _ = storage.MutationResult(db.Exec("INSERT INTO community_members(community_id,actor_uri,approved_by) VALUES (?,?,?)", group.ID, member, alice.ActorURI)).Unwrap()
  let handler = Handler(settings, db)
  let path = "/federation-media/" + binding
  let date = time.Now().UTC().Format("Mon, 02 Jan 2006 15:04:05 GMT")
  if doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: path}).Code != 404 then t.Fatal("unsigned request read private attachment") end
  let allowed = signedGet(handler, site.Origin, path, member, key, date)
  if allowed.Code != 200 || allowed.Body.String() != "private file" then t.Fatalf("authorized Actor denied attachment: %d %s", allowed.Code, allowed.Body.String()) end
  if signedGet(handler, site.Origin, path, outsider, key, date).Code != 404 || signedGet(handler, site.Origin, path, instance, key, date).Code != 404 then t.Fatal("non-member or server-only signature read private media") end
  let activityID: String = ""
  let _ = storage.MutationResult(db.Raw("SELECT uri FROM activities WHERE actor_uri=? AND kind='Create'", alice.ActorURI).Scan(Ref.new(activityID))).Unwrap()
  let activityPath = strings.TrimPrefix(activityID, site.Origin)
  if doForum(handler, forumCall{Method: "GET", Origin: site.Origin, Path: activityPath}).Code != 404 || signedGet(handler, site.Origin, activityPath, member, key, date).Code != 200 then t.Fatal("private canonical activity lacks Actor authorization") end
  let _ = storage.MutationResult(db.Exec("UPDATE community_members SET revoked_at=now() WHERE actor_uri=?", member)).Unwrap()
  if signedGet(handler, site.Origin, path, member, key, date).Code != 404 then t.Fatal("revoked member retained origin media access") end
end
