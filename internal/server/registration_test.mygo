package server

import testing "go:testing"
import context "go:context"
import http "go:net/http"
import httptest "go:net/http/httptest"
import io "go:io"
import strings "go:strings"
import strconv "go:strconv"
import base64 "go:encoding/base64"
import netip "go:net/netip"
import gorm "go:gorm.io/gorm"
import config "github.com/commune-project/commune-backend/internal/config"
import auth "github.com/commune-project/commune-backend/internal/auth"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"

struct RegistrationIPCase
  Peer: String
  Forwarded: String
  Want: String
end

func TestRegistrationClientIP(t: Ref[testing.T]) -> ()
  let settings = config.Config{TrustedProxies: [netip.ParsePrefix("192.0.2.0/24").Unwrap(), netip.ParsePrefix("2001:db8::/32").Unwrap()]}
  let cases: Slice[RegistrationIPCase] = [
    RegistrationIPCase{Peer: "198.51.100.10:1234", Forwarded: "203.0.113.9", Want: "198.51.100.10"},
    RegistrationIPCase{Peer: "198.51.100.10:1234", Forwarded: "malformed", Want: "198.51.100.10"},
    RegistrationIPCase{Peer: "[::ffff:198.51.100.10]:1234", Want: "198.51.100.10"},
    RegistrationIPCase{Peer: "192.0.2.10:1234", Forwarded: "203.0.113.9", Want: "203.0.113.9"},
    RegistrationIPCase{Peer: "[::ffff:192.0.2.10]:1234", Forwarded: "203.0.113.9", Want: "203.0.113.9"},
    RegistrationIPCase{Peer: "192.0.2.10:1234", Forwarded: "spoofed, 203.0.113.9, 192.0.2.11", Want: "203.0.113.9"},
    RegistrationIPCase{Peer: "[2001:db8::1]:1234", Forwarded: "2001:4860:4860::8888", Want: "2001:4860:4860::8888"},
    RegistrationIPCase{Peer: "192.0.2.10:1234", Forwarded: "", Want: "192.0.2.10"},
    RegistrationIPCase{Peer: "192.0.2.10:1234", Forwarded: "malformed"},
    RegistrationIPCase{Peer: "192.0.2.10:1234", Forwarded: "203.0.113.9,"},
    RegistrationIPCase{Peer: "hostname:1234", Forwarded: "203.0.113.9"},
    RegistrationIPCase{Peer: "192.0.2.10", Forwarded: "203.0.113.9"},
    RegistrationIPCase{Peer: "198.51.100.10:bad", Forwarded: "203.0.113.9"},
    RegistrationIPCase{Peer: "198.51.100.10:70000", Forwarded: "203.0.113.9"}
  ]
  cases.Each(func(test: RegistrationIPCase) -> ()
    let request = httptest.NewRequest("POST", "https://a.example/api/v1/auth/register", strings.NewReader("") as io.Reader)
    request.RemoteAddr = test.Peer
    request.Header.Set("X-Forwarded-For", test.Forwarded)
    let actual = RegistrationClientIP(settings, request)
    if test.Want == "" then
      if actual.IsOk() then
        t.Errorf("invalid client accepted: %s / %s", test.Peer, test.Forwarded)
      end
    else
      if actual.IsErr() || actual.Unwrap() != test.Want then
        t.Errorf("wrong trusted-proxy client: %s / %s", test.Peer, test.Forwarded)
      end
    end
  end)
end

func registrationSettings() -> config.Config
  var settings = config.Load("../../config/example.json").Unwrap()
  settings.Sites = settings.Sites.Map(func(site: config.Site) -> config.Site
    var enabled = site
    enabled.RegistrationEnabled = true
    enabled
  end)
  settings.Registration.OutboxSecret = base64.StdEncoding.EncodeToString(strings.Repeat("k", 32) as Slice[Byte])
  settings.Registration.IPLimit = 100
  settings.Registration.EmailLimit = 100
  settings.TrustedProxies = [netip.ParsePrefix("192.0.2.0/24").Unwrap()]
  settings
end

func registrationRequest(handler: http.HandlerFunc, origin: String, path: String, payload: String, peer: String, forwarded: String) -> Ref[httptest.ResponseRecorder]
  let request = httptest.NewRequest("POST", origin + path, strings.NewReader(payload) as io.Reader)
  request.Header.Set("Origin", origin)
  request.Header.Set("Content-Type", "application/json")
  request.Header.Set("X-Forwarded-For", forwarded)
  request.RemoteAddr = peer
  let response = httptest.NewRecorder()
  handler.ServeHTTP(response as http.ResponseWriter, request)
  response
end

func assertRegistrationResponse(t: Ref[testing.T], response: Ref[httptest.ResponseRecorder], status: Int) -> ()
  t.Helper()
  if response.Code != status || response.Header().Get("Cache-Control") != "no-store" || response.Header().Get("Set-Cookie") != "" then
    t.Fatalf("registration expected %d/no-store/no-session, got %d: %s", status, response.Code, response.Body.String())
  end
end

func registrationHTTPToken(db: Ref[gorm.DB], siteID: String, origin: String) -> String
  let payload: Slice[Byte] = []
  let _ = db.Raw("SELECT j.encrypted_payload FROM verification_mail_jobs j JOIN pending_registrations p ON p.id=j.registration_id WHERE p.site_id=? ORDER BY j.generation DESC LIMIT 1", siteID).Row().Scan(Ref.new(payload)).Unwrap()
  strings.TrimPrefix(auth.OpenVerification(strings.Repeat("k", 32) as Slice[Byte], payload).Unwrap(), origin + "/verify-email#token=")
end

func TestPostgresRegistrationHTTPContract(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = registrationSettings()
  let site = settings.Sites.Get(0).Unwrap()
  let other = settings.Sites.Get(1).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, other).Unwrap()
  let handler = Handler(settings, db)
  let register: String = "/api/v1/auth/register"
  let confirm: String = "/api/v1/auth/verification/confirm"
  let resend: String = "/api/v1/auth/verification/resend"
  let initial: String = `{"username":"alice","email":"alice@example.com"}`
  let invalid: Slice[String] = [
    `{"username":"alice","email":"alice@example.com","password":"initial-password"}`,
    `{"username":"alice","email":"alice@example.com","unknown":1}`,
    initial + " {}", "null", "[]", `{"username":1,"email":"alice@example.com"}`,
    `{"username":"alice","email":"invalid"}`, `{"username":"Alice","email":"alice@example.com"}`
  ]
  invalid.Each(func(payload: String) -> ()
    assertRegistrationResponse(t, registrationRequest(handler, site.Origin, register, payload, "198.51.100.10:1234", ""), 400)
  end)
  let first = registrationRequest(handler, site.Origin, register, initial, "198.51.100.10:1234", "")
  assertRegistrationResponse(t, first, 202)
  var token = registrationHTTPToken(db, site.ID, site.Origin)
  if storage.AccountRepository{DB: db}.Authenticate(ctx, site.ID, "alice", "final-password-choice").IsOk() then
    t.Fatal("HTTP pending registration could log in")
  end
  let duplicate = registrationRequest(handler, site.Origin, register, `{"username":"other","email":"ALICE@example.com"}`, "198.51.100.10:1234", "")
  assertRegistrationResponse(t, duplicate, 202)
  if duplicate.Body.String() != first.Body.String() || registrationHTTPToken(db, site.ID, site.Origin) != token then
    t.Fatal("duplicate HTTP registration disclosed or replaced pending data")
  end
  let unknown = registrationRequest(handler, site.Origin, resend, `{"email":"unknown@example.com"}`, "198.51.100.10:1234", "")
  assertRegistrationResponse(t, unknown, 202)
  if unknown.Body.String() != first.Body.String() then
    t.Fatal("unknown-email resend was not generic")
  end
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `"}`, "198.51.100.10:1234", ""), 400)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `","password":"short"}`, "198.51.100.10:1234", ""), 400)
  assertRegistrationResponse(t, registrationRequest(handler, other.Origin, confirm, `{"token":"` + token + `","password":"final-password-choice"}`, "198.51.100.10:1234", ""), 400)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `","password":"final-password-choice","extra":true}`, "198.51.100.10:1234", ""), 400)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, resend, `{"email":"alice@example.com","password":"unwanted-password"}`, "198.51.100.10:1234", ""), 400)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, resend, `{"email":"alice@example.com"}`, "198.51.100.10:1234", ""), 202)
  let replacement = registrationHTTPToken(db, site.ID, site.Origin)
  if replacement == token then
    t.Fatal("HTTP resend did not rotate verification token")
  end
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `","password":"final-password-choice"}`, "198.51.100.10:1234", ""), 400)
  token = replacement
  let accepted = registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `","password":"final-password-choice"}`, "198.51.100.10:1234", "")
  assertRegistrationResponse(t, accepted, 204)
  if accepted.Body.String() != "" then
    t.Fatal("confirmation returned a response body")
  end
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, confirm, `{"token":"` + token + `","password":"replacement-password"}`, "198.51.100.10:1234", ""), 400)
  let existing = registrationRequest(handler, site.Origin, register, initial, "198.51.100.10:1234", "")
  assertRegistrationResponse(t, existing, 202)
  if existing.Body.String() != first.Body.String() then
    t.Fatal("existing account response disclosed ownership")
  end
  let loggedIn = doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Source: site.Origin, Path: "/api/v1/auth/login", Payload: `{"login":"alice","password":"final-password-choice"}`})
  if loggedIn.Code != 200 || loggedIn.Result().Cookies().Len() != 2 then
    t.Fatalf("confirmed account failed normal login: %d", loggedIn.Code)
  end
end

func TestPostgresRegistrationHTTPGuardsAndRate(t: Ref[testing.T]) -> ()
  let db = transport.ORM(testsupport.Postgres(t)).Unwrap()
  let ctx = context.Background()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  var settings = registrationSettings()
  let site = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  settings.Registration.IPLimit = 1
  settings.Registration.RateWindowSeconds = 90
  let handler = Handler(settings, db)
  let path: String = "/api/v1/auth/register"
  let payload: String = `{"username":"alice","email":"alice@example.com"}`
  let first = registrationRequest(handler, site.Origin, path, payload, "198.51.100.20:1234", "203.0.113.1")
  assertRegistrationResponse(t, first, 202)
  let limited = registrationRequest(handler, site.Origin, path, payload, "198.51.100.20:1234", "203.0.113.2")
  assertRegistrationResponse(t, limited, 429)
  let retry = strconv.Atoi(limited.Header().Get("Retry-After")).UnwrapOr(0)
  if retry < 1 || retry > 90 then
    t.Fatal("Retry-After ignored configured rate window")
  end
  let trustedFirst = registrationRequest(handler, site.Origin, path, payload, "192.0.2.10:1234", "spoof, 203.0.113.10, 192.0.2.11")
  assertRegistrationResponse(t, trustedFirst, 202)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, path, payload, "192.0.2.10:1234", "different-spoof, 203.0.113.10, 192.0.2.11"), 429)
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, path, payload, "192.0.2.10:1234", "203.0.113.11"), 202)
  let malformed = registrationRequest(handler, site.Origin, path, payload, "192.0.2.10:1234", "broken")
  assertRegistrationResponse(t, malformed, 400)
  let routes: Slice[String] = [path, "/api/v1/auth/verification/resend", "/api/v1/auth/verification/confirm"]
  routes.Each(func(route: String) -> ()
    let method = httptest.NewRequest("GET", site.Origin + route, strings.NewReader("") as io.Reader)
    let methodResponse = httptest.NewRecorder()
    handler.ServeHTTP(methodResponse as http.ResponseWriter, method)
    assertRegistrationResponse(t, methodResponse, 405)
    if methodResponse.Header().Get("Allow") != "POST" then
      t.Fatal("registration method omitted Allow")
    end
    let origins: Slice[String] = ["", "https://evil.example"]
    origins.Each(func(origin: String) -> ()
      let response = doForum(handler, forumCall{Method: "POST", Origin: site.Origin, Source: origin, Path: route, Payload: payload})
      assertRegistrationResponse(t, response, 403)
    end)
    var disabled = settings
    disabled.Sites = [config.Site{ID: site.ID, Origin: site.Origin, RegistrationEnabled: false}]
    assertRegistrationResponse(t, registrationRequest(Handler(disabled, db), site.Origin, route, payload, "198.51.100.30:1234", ""), 403)
  end)
  let contentType = httptest.NewRequest("POST", site.Origin + path, strings.NewReader(payload) as io.Reader)
  contentType.Header.Set("Origin", site.Origin)
  contentType.Header.Set("Content-Type", "text/plain")
  let response = httptest.NewRecorder()
  handler.ServeHTTP(response as http.ResponseWriter, contentType)
  assertRegistrationResponse(t, response, 400)
  var small = settings
  small.Runtime.MaxBodyBytes = 32
  assertRegistrationResponse(t, registrationRequest(Handler(small, db), site.Origin, path, payload, "198.51.100.30:1234", ""), 400)
  let _ = storage.MutationResult(db.Exec("DROP TABLE registration_rate_limits")).Unwrap()
  assertRegistrationResponse(t, registrationRequest(handler, site.Origin, path, payload, "198.51.100.40:1234", ""), 503)
end
