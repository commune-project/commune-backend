package server

import testing "go:testing"
import context "go:context"
import json "go:encoding/json"
import httptest "go:net/http/httptest"
import strings "go:strings"
import config "github.com/commune-project/commune-backend/internal/config"
import storage "github.com/commune-project/commune-backend/internal/storage"
import testsupport "github.com/commune-project/commune-backend/internal/testsupport"
import transport "go:github.com/commune-project/commune-backend/internal/testtransport"
import concurrency "github.com/mygo-lang/mygo/lib/concurrency"

func TestPostgresConditionalAuthorEdits(t: Ref[testing.T]) -> ()
  let ctx = context.Background()
  let pool = testsupport.Postgres(t)
  pool.SetMaxOpenConns(8)
  let db = transport.ORM(pool).Unwrap()
  let _ = storage.MigrateGORM(ctx, db).Unwrap()
  let settings = config.Load("../../config/example.json").Unwrap()
  let site = settings.Sites.Get(0).Unwrap()
  let _ = storage.ProvisionSite(ctx, db, site).Unwrap()
  let alice = storage.AccountRepository { DB: db }.Create(ctx, site, "alice", "", "alice-password").Unwrap()
  let group = storage.CommunityRepository { DB: db, SiteID: site.ID }.Create(
    ctx,
    site,
    alice,
    "versions",
    "Versions",
    "local_only",
    "members",
    "members"
  ).Unwrap()
  let post = storage.PostRepository { DB: db, SiteID: site.ID }.Publish(
    ctx,
    site,
    group.ID,
    alice,
    false,
    storage.PublishInput {
      Title: "Topic",
      Body: "original",
      ContentFormat: "markdown",
    }
  ).Unwrap()
  if post.Version != 1i64 then
    t.Fatal("new post revision is not 1")
  end
  let handler = Handler(settings, db)
  let cookies = login(handler, site.Origin, "alice", "alice-password")
  let call = forumCall {
    Method: "PATCH",
    Origin: site.Origin,
    Path: "/api/v1/posts/" + post.ID,
    Source: site.Origin,
    Cookies: cookies,
    CSRF: csrfOf(cookies),
  }
  let source = doForum(
    handler,
    forumCall {
      Method: "GET",
      Origin: site.Origin,
      Path: call.Path + "/source",
      Cookies: cookies,
    }
  )
  let editing = PostSource {}
  if source.Code != 200 ||
    json.Unmarshal(source.Body.Bytes(), Ref.new(editing)).IsErr() ||
    editing.Version != post.Version ||
    editing.Body != post.Body then
    t.Fatal("source revision snapshot missing")
  end
  [
    "",
    `,"expected_version":null`,
    `,"expected_version":0`,
    `,"expected_version":-1`,
    `,"expected_version":1.5`,
    `,"expected_version":"1"`,
    `,"expected_version":9223372036854775808`,
  ].Each(func(field: String) -> ()
    var invalid = call
    invalid.Payload = `{"title":"Topic","body":"invalid"` + field + `}`
    if doForum(handler, invalid).Code != 400 then
      t.Fatalf("accepted invalid precondition: %s", field)
    end
  end)
  var first = call
  first.Payload = `{"title":"Topic","body":"winner","expected_version":1}`
  let saved = doForum(handler, first)
  if saved.Code != 200 || browserPost(t, saved).Version != 2i64 then
    t.Fatalf("first edit failed: %s", saved.Body.String())
  end
  var stale = first
  stale.Payload = `{"title":"Topic","body":"stale @alice","attachment_ids":["missing"],"expected_version":1}`
  let conflict = doForum(handler, stale)
  let conflictError = ErrorOutput {}
  if conflict.Code != 409 ||
    json.Unmarshal(conflict.Body.Bytes(), Ref.new(conflictError)).IsErr() ||
    conflictError.Error != "edit_conflict" ||
    conflict.Header().Get("Cache-Control") != "no-store" then
    t.Fatalf("wrong conflict response: %s", conflict.Body.String())
  end
  let current = storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap()
  if current.Body != "winner" || current.Version != 2i64 then
    t.Fatal("stale save changed content or revision")
  end
  # Both workers start together; transactions obtain separate pool connections.
  let ready = concurrency.MakeChan[()](2)
  let start = concurrency.MakeChan[()](2)
  let results = concurrency.MakeChan[Ref[httptest.ResponseRecorder]](2)
  ["A", "B"].Each(func(body: String) -> ()
    concurrency.Spawn(func() -> ()
      var attempt = call
      attempt.Payload = `{"title":"Topic","body":"` + body + `","expected_version":2}`
      ready.Send(())
      let _ = start.Receive()
      results.Send(doForum(handler, attempt))
    end)
  end)
  let _ = ready.Receive()
  let _ = ready.Receive()
  start.Send(())
  start.Send(())
  let a = results.Receive().Unwrap()
  let b = results.Receive().Unwrap()
  if !((a.Code == 200 && b.Code == 409) || (a.Code == 409 && b.Code == 200)) then
    t.Fatalf("concurrent edits: %d %d", a.Code, b.Code)
  end
  let winning = browserPost(t, (if a.Code == 200 => a else b))
  let after = storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap()
  if after.Version != 3i64 || after.Body != winning.Body then
    t.Fatal("concurrent save revision/content mismatch")
  end
  let unchanged = storage.PostRepository { DB: db, SiteID: site.ID }.Edit(
    ctx,
    post.ID,
    alice,
    false,
    "Topic",
    after.Body,
    after.Version
  ).Unwrap()
  if unchanged.Version != 4i64 then
    t.Fatal("accepted unchanged edit did not advance revision")
  end
  # Interactions and site-local visibility do not consume content revisions.
  let _ = storage.ReactionRepository { DB: db, SiteID: site.ID }.Like(
    ctx,
    post.ID,
    alice,
    false,
    ""
  ).Unwrap()
  let _ = storage.PostRepository { DB: db, SiteID: site.ID }.Publish(
    ctx,
    site,
    group.ID,
    alice,
    false,
    storage.PublishInput{
      Body: "Reply",
      ParentID: post.ID,
    }
  ).Unwrap()
  if storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap().Version != 4i64 then
    t.Fatal("interaction advanced content revision")
  end
  var noCSRF = first
  noCSRF.CSRF = ""
  if doForum(handler, noCSRF).Code != 403 then
    t.Fatal("stale save bypassed CSRF")
  end
  let _ = storage.MutationResult(db.Exec(
    "UPDATE site_posts SET hidden_at=now() WHERE site_id=? AND post_id=?",
    site.ID,
    post.ID
  )).Unwrap()
  if doForum(handler, first).Code != 404 then
    t.Fatal("hidden stale save exposed conflict")
  end
  let _ = storage.MutationResult(db.Exec(
    "UPDATE site_posts SET hidden_at=NULL WHERE site_id=? AND post_id=?",
    site.ID,
    post.ID
  )).Unwrap()
  let _ = storage.MutationResult(db.Exec(
    "UPDATE community_members SET revoked_at=now() WHERE community_id=? AND actor_uri=?",
    group.ID,
    alice.ActorURI
  )).Unwrap()
  if doForum(handler, first).Code != 403 then
    t.Fatal("revoked creator stale save did not retain read-only management access")
  end
  let _ = storage.MutationResult(db.Exec(
    "UPDATE community_members SET revoked_at=NULL WHERE community_id=? AND actor_uri=?",
    group.ID,
    alice.ActorURI
  )).Unwrap()
  # An ordinary author's revoked membership also removes read access.
  let bob = storage.AccountRepository{DB: db}.Create(ctx, site, "bob", "", "bob-password").Unwrap()
  let communities = storage.CommunityRepository{DB: db, SiteID: site.ID}
  let _ = communities.SetMember(ctx, group.ID, alice, false, bob.ActorURI, true).Unwrap()
  let bobCookies = login(handler, site.Origin, "bob", "bob-password")
  var foreign = first
  foreign.Cookies = bobCookies
  foreign.CSRF = csrfOf(bobCookies)
  if doForum(handler, foreign).Code != 403 then
    t.Fatal("non-author stale save exposed conflict")
  end
  let bobPost = storage.PostRepository{DB: db, SiteID: site.ID}.Publish(
    ctx,
    site,
    group.ID,
    bob,
    false,
    storage.PublishInput{
      Title: "Bob",
      Body: "draft",
    }
  ).Unwrap()
  var bobEdit = foreign
  bobEdit.Path = "/api/v1/posts/" + bobPost.ID
  bobEdit.Payload = `{"title":"Bob","body":"saved","expected_version":1}`
  if doForum(handler, bobEdit).Code != 200 then
    t.Fatal("ordinary author could not save")
  end
  let _ = communities.SetMember(ctx, group.ID, alice, false, bob.ActorURI, false).Unwrap()
  if doForum(handler, bobEdit).Code != 404 then
    t.Fatal("revoked ordinary author stale save exposed conflict")
  end
  # A matching revision with invalid rich content rolls back text and revision.
  var invalidRich = call
  invalidRich.Payload = `{"title":"Changed","body":"![x](/api/v1/media/missing)","content_format":"markdown","expected_version":4}`
  if doForum(handler, invalidRich).Code != 400 then
    t.Fatal("invalid content accepted")
  end
  if storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap().Version != 4i64 then
    t.Fatal("failed validation consumed revision")
  end
  let _ = storage.MutationResult(db.Exec(
    "UPDATE posts SET version=9223372036854775807 WHERE id=?",
    post.ID
  )).Unwrap()
  var overflow = call
  overflow.Payload = `{"title":"Topic","body":"overflow","expected_version":9223372036854775807}`
  if doForum(handler, overflow).Code != 503 then
    t.Fatal("revision overflow did not fail closed")
  end
  let preserved = storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap()
  if preserved.Version != 9223372036854775807i64 || preserved.Body != after.Body then
    t.Fatal("revision overflow committed changes")
  end
  let _ = storage.MutationResult(db.Exec("UPDATE posts SET version=4 WHERE id=?", post.ID)).Unwrap()
  let repository = storage.PostRepository{DB: db, SiteID: site.ID}
  let _ = repository.Delete(ctx, post.ID, alice, false).Unwrap()
  let _ = repository.Delete(ctx, post.ID, alice, false).Unwrap()
  if storage.LoadObjectByID(ctx, db, post.ID).Unwrap().Unwrap().Version != 5i64 then
    t.Fatal("deletion revision not idempotent")
  end
  let deleted = doForum(handler, first)
  if deleted.Code != 404 || strings.Contains(deleted.Body.String(), "edit_conflict") then
    t.Fatal("deleted stale save exposed conflict")
  end
end
