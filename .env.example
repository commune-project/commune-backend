# Image and build settings.
COMMUNE_IMAGE=commune-backend:local

# Local MyGO checkout used as a BuildKit named context.
# Standard sibling layout:
MYGO_CONTEXT=../../mygo
# This machine's actual checkout:
# MYGO_CONTEXT=../../../go/mygo

# Regenerate checked-in MyGO output during the image build.
# Keep false for a faster build; make verify remains the release gate.
MYGO_GENERATE=false

# The first build may fetch Go modules; later builds reuse the BuildKit cache.
GOPROXY=https://proxy.golang.org,direct

# Local-only HTTP port for the app container.
COMMUNE_HTTP_PORT=8080

# HTTPS port published by the Caddy reverse proxy.
COMMUNE_HTTPS_PORT=443

# Local config file, copied from deploy/commune.json.template.
COMMUNE_CONFIG_TEMPLATE=./deploy/commune.json

# Optional; only needed when a site enables registration.
# COMMUNE_OUTBOX_SECRET=
# COMMUNE_SMTP_PASSWORD=
# COMMUNE_SMTP_PASSWORD_FILE=./secrets/smtp_password
